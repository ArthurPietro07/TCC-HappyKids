<%- include('partials/header') %>

<div class="max-w-6xl mx-auto animate-fade-in px-2 md:px-0">
    <a href="/catalogo" class="inline-flex items-center gap-2 mb-6 text-indigo-600 hover:text-indigo-700 font-medium transition text-sm md:text-base">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg>
        Voltar ao catálogo
    </a>
    
    <div class="bg-white rounded-2xl shadow-lg overflow-hidden">
        <div class="grid md:grid-cols-2 gap-6 md:gap-8 p-4 md:p-8">
            <!-- Carrossel de Imagens -->
            <div class="bg-gray-50 rounded-xl p-3 md:p-4">
                <% if (brinquedo.imagens && brinquedo.imagens.length > 0) { %>
                    <div class="relative">
                        <div class="overflow-hidden rounded-xl">
                            <div id="carrosselContainer" class="flex transition-transform duration-300 ease-in-out">
                                <% brinquedo.imagens.forEach((img, index) => { %>
                                    <div class="w-full flex-shrink-0">
                                        <img src="<%= img.url %>" alt="<%= brinquedo.nome %>" class="w-full h-64 md:h-96 object-contain">
                                    </div>
                                <% }) %>
                            </div>
                        </div>
                        
                        <% if (brinquedo.imagens.length > 1) { %>
                            <button onclick="mudarImagem(-1)" class="absolute left-2 md:left-4 top-1/2 transform -translate-y-1/2 bg-white/90 hover:bg-white text-gray-800 rounded-full p-2 md:p-3 shadow-lg transition">
                                <svg class="w-5 h-5 md:w-6 md:h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path></svg>
                            </button>
                            <button onclick="mudarImagem(1)" class="absolute right-2 md:right-4 top-1/2 transform -translate-y-1/2 bg-white/90 hover:bg-white text-gray-800 rounded-full p-2 md:p-3 shadow-lg transition">
                                <svg class="w-5 h-5 md:w-6 md:h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
                            </button>
                        <% } %>
                    </div>
                    
                    <% if (brinquedo.imagens.length > 1) { %>
                        <div class="flex gap-2 md:gap-3 mt-3 md:mt-4 justify-center overflow-x-auto pb-2">
                            <% brinquedo.imagens.forEach((img, index) => { %>
                                <img src="<%= img.url %>" alt="Miniatura" 
                                     class="w-14 h-14 md:w-20 md:h-20 object-cover rounded-lg cursor-pointer border-2 hover:border-indigo-500 transition miniatura flex-shrink-0 <%= index === 0 ? 'border-indigo-500' : 'border-gray-300' %>"
                                     data-index="<%= index %>"
                                     onclick="irParaImagem(<%= index %>)">
                            <% }) %>
                        </div>
                    <% } %>
                <% } else { %>
                    <img src="/uploads/default.jpg" alt="<%= brinquedo.nome %>" class="w-full h-64 md:h-96 object-contain rounded-xl">
                <% } %>
            </div>
            
            <div>
                <h1 class="text-2xl md:text-4xl font-bold text-gray-900 mb-2 md:mb-3"><%= brinquedo.nome %></h1>
                
                <div class="flex items-center mb-4 md:mb-6">
                    <div class="flex mr-3">
                        <% for(let i = 1; i <= 5; i++) { %>
                            <svg class="w-5 h-5 md:w-6 md:h-6 <%= i <= Math.round(mediaEstrelas) ? 'text-yellow-400' : 'text-gray-300' %>" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"></path></svg>
                        <% } %>
                    </div>
                    <span class="text-gray-600 font-medium text-sm md:text-base">(<%= comentarios.length %> avaliações)</span>
                </div>
                
                <div class="border-t border-b py-4 md:py-6 mb-4 md:mb-6">
                    <div class="flex justify-between items-center">
                        <span class="text-gray-600 font-medium text-sm md:text-base">Preço por dia:</span>
                        <span class="text-2xl md:text-3xl font-bold text-indigo-600">R$ <%= brinquedo.preco_diaria.toFixed(2) %></span>
                    </div>
                </div>
                
                <!-- Descrição com Ver mais/Ver menos -->
                <div class="mb-6 md:mb-8">
                    <div id="descricaoContainer">
                        <div id="descricaoTexto" class="text-gray-600 leading-relaxed text-sm md:text-lg whitespace-pre-wrap break-words"><%= brinquedo.descricao %></div>
                        <button id="btnVerMais" class="text-indigo-600 hover:text-indigo-700 font-semibold text-sm md:text-base mt-3 hidden transition flex items-center gap-1">
                            <span>Ver mais</span>
                            <svg class="w-4 h-4 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
                        </button>
                    </div>
                </div>
                
                <div class="mb-4 md:mb-6">
                    <div class="flex items-center gap-2 md:gap-3 mb-3 md:mb-4 flex-wrap">
                        <span class="font-semibold text-gray-700 text-sm md:text-base">Disponibilidade:</span>
                        <span class="px-3 md:px-4 py-1 md:py-2 rounded-full text-xs md:text-sm font-semibold <%= brinquedo.quantidade_estoque > 0 ? 'bg-green-100 text-green-800' : 'bg-red-100 text-red-800' %>">
                            <%= brinquedo.quantidade_estoque > 0 ? `${brinquedo.quantidade_estoque} disponíveis` : 'Indisponível' %>
                        </span>
                    </div>
                    
                    <% if (user && user.tipo === 'cliente' && brinquedo.quantidade_estoque > 0) { %>
                        <div class="flex gap-2 md:gap-3">
                            <input type="number" id="quantidade" value="1" min="1" max="<%= brinquedo.quantidade_estoque %>" class="w-20 md:w-24 px-3 md:px-4 py-2 md:py-3 border border-gray-300 rounded-lg text-center font-semibold focus:outline-none focus:ring-2 focus:ring-indigo-500">
                            <button onclick="adicionarAoCarrinho()" class="flex-1 bg-indigo-600 text-white px-4 md:px-6 py-2 md:py-3 rounded-lg hover:bg-indigo-700 transition font-semibold shadow-md hover:shadow-lg flex items-center justify-center gap-2 text-sm md:text-base">
                                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z"></path></svg>
                                <span class="hidden sm:inline">Adicionar ao Carrinho</span>
                                <span class="sm:hidden">Adicionar</span>
                            </button>
                        </div>
                    <% } %>
                </div>
            </div>
        </div>
        
        <!-- Calendário de Disponibilidade -->
        <div class="border-t p-4 md:p-8">
            <div class="flex flex-col md:flex-row justify-between items-start md:items-center mb-6 md:mb-8 gap-3">
                <h2 class="text-xl md:text-3xl font-bold text-gray-900">Disponibilidade</h2>
                <div class="flex gap-2 md:gap-3 w-full md:w-auto">
                    <a href="?mes=<%= mesAtual-1 %>&ano=<%= mesAtual === 0 ? anoAtual-1 : anoAtual %>" class="flex-1 md:flex-none bg-gray-100 text-gray-700 px-3 md:px-4 py-2 rounded-lg hover:bg-gray-200 transition font-medium flex items-center justify-center gap-1 text-sm">
                        <svg class="w-4 h-4 md:w-5 md:h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path></svg>
                        <span class="hidden sm:inline">Anterior</span>
                    </a>
                    <span class="flex-1 md:flex-none text-sm md:text-lg font-semibold px-3 md:px-6 py-2 bg-gray-100 rounded-lg text-center">
                        <%= mesesPortugues[mesAtual] %> <%= anoAtual %>
                    </span>
                    <a href="?mes=<%= mesAtual+1 %>&ano=<%= mesAtual === 11 ? anoAtual+1 : anoAtual %>" class="flex-1 md:flex-none bg-gray-100 text-gray-700 px-3 md:px-4 py-2 rounded-lg hover:bg-gray-200 transition font-medium flex items-center justify-center gap-1 text-sm">
                        <span class="hidden sm:inline">Próximo</span>
                        <svg class="w-4 h-4 md:w-5 md:h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
                    </a>
                </div>
            </div>
            
            <div class="bg-white rounded-xl shadow-sm p-2 md:p-4 overflow-x-auto">
                <div class="min-w-[500px]">
                    <div class="grid grid-cols-7 gap-1 md:gap-2 mb-2 md:mb-3">
                        <div class="text-center font-bold p-2 md:p-3 bg-indigo-100 rounded-lg text-indigo-800 text-xs md:text-sm">Dom</div>
                        <div class="text-center font-bold p-2 md:p-3 bg-indigo-100 rounded-lg text-indigo-800 text-xs md:text-sm">Seg</div>
                        <div class="text-center font-bold p-2 md:p-3 bg-indigo-100 rounded-lg text-indigo-800 text-xs md:text-sm">Ter</div>
                        <div class="text-center font-bold p-2 md:p-3 bg-indigo-100 rounded-lg text-indigo-800 text-xs md:text-sm">Qua</div>
                        <div class="text-center font-bold p-2 md:p-3 bg-indigo-100 rounded-lg text-indigo-800 text-xs md:text-sm">Qui</div>
                        <div class="text-center font-bold p-2 md:p-3 bg-indigo-100 rounded-lg text-indigo-800 text-xs md:text-sm">Sex</div>
                        <div class="text-center font-bold p-2 md:p-3 bg-indigo-100 rounded-lg text-indigo-800 text-xs md:text-sm">Sáb</div>
                    </div>
                    
                    <div class="grid grid-cols-7 gap-1 md:gap-2">
                        <% for(let i = 0; i < primeiroDiaSemana; i++) { %>
                            <div class="bg-gray-100 rounded-lg p-2 md:p-3 min-h-[70px] md:min-h-[100px]"></div>
                        <% } %>
                        
                        <% for(let dia = 1; dia <= diasNoMes; dia++) { 
                            const ocup = diasOcupados[dia];
                            const disponivel = ocup ? ocup.disponivel : 0;
                            const isPassado = ocup ? ocup.isPassado : false;
                            const temDisponibilidade = !isPassado && disponivel > 0;
                        %>
                            <div class="rounded-lg p-2 md:p-3 min-h-[70px] md:min-h-[100px] text-center transition-all flex flex-col justify-center items-center <%= temDisponibilidade ? 'bg-green-500 hover:bg-green-600 cursor-pointer text-white shadow-sm hover:shadow-md' : (isPassado ? 'bg-gray-200 text-gray-500' : 'bg-red-500 text-white') %>">
                                <div class="font-bold text-base md:text-lg leading-tight"><%= dia %></div>
                                <div class="text-[10px] md:text-xs mt-1 font-medium leading-tight">
                                    <% if (temDisponibilidade) { %>
                                        <span><%= disponivel %> disp.</span>
                                    <% } else if (isPassado) { %>
                                        <span>Passado</span>
                                    <% } else { %>
                                        <span>Ocupado</span>
                                    <% } %>
                                </div>
                            </div>
                        <% } %>
                    </div>
                </div>
            </div>
            
            <div class="flex justify-center gap-4 md:gap-8 mt-4 md:mt-8 text-xs md:text-sm flex-wrap">
                <div class="flex items-center gap-2"><div class="w-5 h-5 md:w-6 md:h-6 bg-green-500 rounded"></div> <span class="text-gray-700 font-medium">Disponível</span></div>
                <div class="flex items-center gap-2"><div class="w-5 h-5 md:w-6 md:h-6 bg-red-500 rounded"></div> <span class="text-gray-700 font-medium">Ocupado</span></div>
                <div class="flex items-center gap-2"><div class="w-5 h-5 md:w-6 md:h-6 bg-gray-200 rounded"></div> <span class="text-gray-700 font-medium">Passado</span></div>
            </div>
        </div>
        
        <!-- Comentários -->
        <div class="border-t p-4 md:p-8">
            <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center mb-6 md:mb-8 gap-3">
                <h2 class="text-xl md:text-3xl font-bold text-gray-900">Avaliações dos Clientes</h2>
                <% if (user && user.tipo === 'cliente') { %>
                    <button onclick="toggleFormComentario()" class="w-full sm:w-auto bg-green-600 text-white px-4 md:px-6 py-2 md:py-3 rounded-lg hover:bg-green-700 transition font-semibold shadow-md hover:shadow-lg flex items-center justify-center gap-2 text-sm">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path></svg>
                        Escrever Avaliação
                    </button>
                <% } %>
            </div>
            
            <div id="formComentario" class="hidden bg-gray-50 rounded-xl p-4 md:p-6 mb-6 md:mb-8 border border-gray-200">
                <form onsubmit="enviarComentario(event)">
                    <textarea id="comentarioTexto" rows="4" class="w-full px-4 py-3 border border-gray-300 rounded-lg mb-4 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent transition" placeholder="Escreva sua avaliação sobre este brinquedo..."></textarea>
                    <div class="flex items-center gap-4 mb-4 flex-wrap">
                        <span class="font-medium text-gray-700 text-sm">Sua nota:</span>
                        <div class="rating-input flex flex-row-reverse justify-end gap-2">
                            <input type="radio" name="estrelas" value="5" id="star5"><label for="star5" class="text-2xl md:text-3xl cursor-pointer">★</label>
                            <input type="radio" name="estrelas" value="4" id="star4"><label for="star4" class="text-2xl md:text-3xl cursor-pointer">★</label>
                            <input type="radio" name="estrelas" value="3" id="star3"><label for="star3" class="text-2xl md:text-3xl cursor-pointer">★</label>
                            <input type="radio" name="estrelas" value="2" id="star2"><label for="star2" class="text-2xl md:text-3xl cursor-pointer">★</label>
                            <input type="radio" name="estrelas" value="1" id="star1"><label for="star1" class="text-2xl md:text-3xl cursor-pointer">★</label>
                        </div>
                    </div>
                    <div class="flex gap-2 md:gap-3 flex-wrap">
                        <button type="submit" class="flex-1 sm:flex-none bg-indigo-600 text-white px-4 md:px-6 py-2 md:py-3 rounded-lg hover:bg-indigo-700 transition font-semibold text-sm">Enviar Avaliação</button>
                        <button type="button" onclick="toggleFormComentario()" class="flex-1 sm:flex-none bg-gray-200 text-gray-700 px-4 md:px-6 py-2 md:py-3 rounded-lg hover:bg-gray-300 transition font-semibold text-sm">Cancelar</button>
                    </div>
                </form>
            </div>
            
            <div class="space-y-3 md:space-y-4">
                <% if (comentarios.length === 0) { %>
                    <div class="text-center py-8 md:py-12 bg-gray-50 rounded-xl">
                        <svg class="w-12 h-12 md:w-16 md:h-16 text-gray-400 mx-auto mb-3 md:mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"></path></svg>
                        <p class="text-gray-500 text-base md:text-lg">Seja o primeiro a avaliar este brinquedo!</p>
                    </div>
                <% } else { %>
                    <% comentarios.forEach(comentario => { %>
                        <div class="border border-gray-200 rounded-xl p-4 md:p-6 bg-white hover:shadow-md transition">
                            <div class="flex justify-between items-start mb-2 md:mb-3 gap-2">
                                <div class="flex-1 min-w-0">
                                    <div class="flex items-center gap-2 md:gap-3 mb-1 md:mb-2 flex-wrap">
                                        <span class="font-semibold text-gray-900 text-base md:text-lg truncate"><%= comentario.usuario_id.nome %></span>
                                        <div class="flex flex-shrink-0">
                                            <% for(let i = 1; i <= 5; i++) { %>
                                                <svg class="w-4 h-4 md:w-5 md:h-5 <%= i <= comentario.estrelas ? 'text-yellow-400' : 'text-gray-300' %>" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"></path></svg>
                                            <% } %>
                                        </div>
                                    </div>
                                    <span class="text-xs md:text-sm text-gray-500"><%= moment(comentario.data).format('DD/MM/YYYY HH:mm') %></span>
                                </div>
                                <% if (user && (user.id === comentario.usuario_id._id.toString() || user.tipo === 'admin')) { %>
                                    <button onclick="excluirComentario('<%= comentario._id %>')" class="text-red-500 hover:text-red-700 text-xs md:text-sm font-medium flex items-center gap-1 flex-shrink-0">
                                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>
                                        <span class="hidden sm:inline">Excluir</span>
                                    </button>
                                <% } %>
                            </div>
                            <p class="text-gray-700 mt-2 md:mt-3 leading-relaxed text-sm md:text-base"><%= comentario.texto %></p>
                        </div>
                    <% }) %>
                <% } %>
            </div>
        </div>
    </div>
</div>

<script>
let indiceAtual = 0;
const totalImagens = <%= brinquedo.imagens ? brinquedo.imagens.length : 0 %>;

function mudarImagem(direcao) {
    if (totalImagens <= 1) return;
    indiceAtual = (indiceAtual + direcao + totalImagens) % totalImagens;
    atualizarCarrossel();
    atualizarMiniaturas();
}

function irParaImagem(index) {
    indiceAtual = index;
    atualizarCarrossel();
    atualizarMiniaturas();
}

function atualizarCarrossel() {
    const container = document.getElementById('carrosselContainer');
    if (container) {
        container.style.transform = `translateX(-${indiceAtual * 100}%)`;
    }
}

function atualizarMiniaturas() {
    const miniaturas = document.querySelectorAll('.miniatura');
    miniaturas.forEach((thumb, index) => {
        if (index === indiceAtual) {
            thumb.classList.add('border-indigo-500');
            thumb.classList.remove('border-gray-300');
        } else {
            thumb.classList.add('border-gray-300');
            thumb.classList.remove('border-indigo-500');
        }
    });
}

function adicionarAoCarrinho() {
    const quantidade = parseInt(document.getElementById('quantidade').value);
    const id = '<%= brinquedo._id %>';
    const nome = '<%= brinquedo.nome %>';
    const preco = <%= brinquedo.preco_diaria %>;
    const estoque = <%= brinquedo.quantidade_estoque %>;
    
    if (quantidade < 1 || quantidade > estoque) {
        alert('Quantidade inválida');
        return;
    }
    
    let carrinho = JSON.parse(localStorage.getItem('carrinho') || '[]');
    const itemExistente = carrinho.find(item => item.id === id);
    
    if (itemExistente) {
        if (itemExistente.quantidade + quantidade > estoque) {
            alert('Quantidade excede o estoque disponível');
            return;
        }
        itemExistente.quantidade += quantidade;
        itemExistente.subtotal = itemExistente.quantidade * preco;
    } else {
        carrinho.push({ id, nome, preco_diaria: preco, quantidade, subtotal: quantidade * preco });
    }
    
    localStorage.setItem('carrinho', JSON.stringify(carrinho));
    alert(`${quantidade}x ${nome} adicionado ao carrinho!`);
}

function toggleFormComentario() {
    document.getElementById('formComentario').classList.toggle('hidden');
}

async function enviarComentario(event) {
    event.preventDefault();
    const texto = document.getElementById('comentarioTexto').value;
    const estrelasInput = document.querySelector('input[name="estrelas"]:checked');
    
    if (!texto.trim()) return alert('Escreva um comentário');
    if (!estrelasInput) return alert('Selecione uma nota');
    
    showLoading();
    try {
        const response = await fetch('/cliente/avaliar', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
                brinquedo_id: '<%= brinquedo._id %>',
                texto: texto,
                estrelas: estrelasInput.value
            })
        });
        const data = await response.json();
        if (data.success) {
            alert('Avaliação enviada!');
            location.reload();
        } else alert(data.error);
    } catch (error) { alert('Erro ao enviar'); }
    finally { hideLoading(); }
}


async function excluirComentario(id) {
    if (!confirm('Tem certeza que deseja excluir este comentário?')) return;
    
    showLoading();
    try {
        console.log('Tentando excluir comentário ID:', id);
        
        // MUDE AQUI: Use a rota do admin em vez da do cliente
        const url = `/admin/excluir-comentario/${id}`;
        console.log('URL da requisição:', url);
        
        const response = await fetch(url, {
            method: 'DELETE',
            headers: {
                'Content-Type': 'application/json'
            }
        });
        
        console.log('Status da resposta:', response.status);
        
        if (!response.ok) {
            throw new Error(`HTTP ${response.status}`);
        }
        
        const data = await response.json();
        console.log('Resposta:', data);
        
        if (data.success) {
            alert('Comentário excluído com sucesso!');
            location.reload();
        } else {
            alert(data.error || 'Erro ao excluir comentário');
        }
    } catch (error) {
        console.error('Erro detalhado:', error);
        alert('Erro ao excluir comentário: ' + error.message);
    } finally {
        hideLoading();
    }
}
// Sistema de Ver mais/Ver menos para descrição
document.addEventListener('DOMContentLoaded', function() {
    const descricaoDiv = document.getElementById('descricaoTexto');
    const btnVerMais = document.getElementById('btnVerMais');
    
    if (descricaoDiv && btnVerMais) {
        const textoOriginal = descricaoDiv.innerHTML;
        const limiteCaracteres = 300;
        
        if (textoOriginal.length > limiteCaracteres) {
            let textoCortado = textoOriginal.substring(0, limiteCaracteres);
            const ultimoEspaco = textoCortado.lastIndexOf(' ');
            
            if (ultimoEspaco > 0) {
                textoCortado = textoCortado.substring(0, ultimoEspaco);
            }
            
            const textoResumido = textoCortado + '...';
            const textoCompleto = textoOriginal;
            
            descricaoDiv.innerHTML = textoResumido;
            descricaoDiv.setAttribute('data-texto-completo', textoCompleto);
            descricaoDiv.setAttribute('data-texto-resumido', textoResumido);
            
            btnVerMais.classList.remove('hidden');
            
            let expandido = false;
            btnVerMais.addEventListener('click', function() {
                if (!expandido) {
                    descricaoDiv.innerHTML = descricaoDiv.getAttribute('data-texto-completo');
                    btnVerMais.querySelector('span').innerText = 'Ver menos';
                    btnVerMais.querySelector('svg').style.transform = 'rotate(180deg)';
                    expandido = true;
                } else {
                    descricaoDiv.innerHTML = descricaoDiv.getAttribute('data-texto-resumido');
                    btnVerMais.querySelector('span').innerText = 'Ver mais';
                    btnVerMais.querySelector('svg').style.transform = 'rotate(0deg)';
                    expandido = false;
                }
            });
        }
    }
});
</script>

