<!-- views/admin/alugueis.ejs -->
<%- include('../partials/admin-header') %>

<div class="flex justify-between items-center mb-6">
    <h1 class="text-3xl font-bold">Gerenciar Aluguéis</h1>
    <div class="flex gap-2">
        <select id="filtroStatus" onchange="filtrarStatus()" class="px-4 py-2 border rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500">
            <option value="">Todos os Status</option>
            <option value="aguardando_pagamento" <%= status === 'aguardando_pagamento' ? 'selected' : '' %>>Aguardando Pagamento</option>
            <option value="pago" <%= status === 'pago' ? 'selected' : '' %>>Pago</option>
            <option value="ativo" <%= status === 'ativo' ? 'selected' : '' %>>Ativo</option>
            <option value="concluido" <%= status === 'concluido' ? 'selected' : '' %>>Concluído</option>
            <option value="cancelado" <%= status === 'cancelado' ? 'selected' : '' %>>Cancelado</option>
        </select>
    </div>
</div>

<div class="grid gap-4">
    <% alugueis.forEach(aluguel => { 
        const statusColors = {
            'aguardando_pagamento': 'bg-yellow-100 text-yellow-800 border-yellow-300',
            'pago': 'bg-blue-100 text-blue-800 border-blue-300',
            'ativo': 'bg-green-100 text-green-800 border-green-300',
            'concluido': 'bg-purple-100 text-purple-800 border-purple-300',
            'cancelado': 'bg-red-100 text-red-800 border-red-300'
        };
        const statusText = {
            'aguardando_pagamento': 'Aguardando Pagamento',
            'pago': 'Pago',
            'ativo': 'Ativo',
            'concluido': 'Concluído',
            'cancelado': 'Cancelado'
        };
    %>
        <div class="bg-white rounded-lg shadow-md overflow-hidden border-l-4 <%= statusColors[aluguel.status] %>">
            <div class="p-6">
                <!-- Cabeçalho do Aluguel -->
                <div class="flex justify-between items-start mb-4">
                    <div class="flex-1">
                        <div class="flex items-center gap-3 mb-2">
                            <h3 class="font-bold text-lg text-gray-800">
                                Pedido #<%= aluguel._id.toString().slice(-6) %>
                            </h3>
                            <span class="px-3 py-1 text-xs font-semibold rounded-full <%= statusColors[aluguel.status] %>">
                                <%= statusText[aluguel.status] %>
                            </span>
                        </div>
                        <p class="text-gray-600">
                            <span class="font-medium">Cliente:</span> <%= aluguel.usuario_id.nome %>
                        </p>
                        <p class="text-gray-600 text-sm">
                            <span class="font-medium">Email:</span> <%= aluguel.usuario_id.email %> | 
                            <span class="font-medium">Telefone:</span> <%= aluguel.usuario_id.telefone %>
                        </p>
                    </div>
                    <div class="text-right">
                        <p class="text-2xl font-bold text-blue-600">R$ <%= aluguel.valor_total.toFixed(2) %></p>
                        <p class="text-sm text-gray-500">
                            Pagamento: <%= aluguel.forma_pagamento === 'pix' ? 'PIX' : 'Dinheiro' %>
                            <%= aluguel.pagamento_confirmado ? '(Confirmado)' : '(Pendente)' %>
                        </p>
                    </div>
                </div>
                
                <!-- Detalhes do Aluguel -->
                <div class="grid md:grid-cols-2 gap-4 mb-4 p-4 bg-gray-50 rounded-lg">
                    <div>
                        <p class="text-sm text-gray-600">
                            <span class="font-medium">Data do Pedido:</span><br>
                            <%= moment(aluguel.data_pedido).format('DD/MM/YYYY HH:mm') %>
                        </p>
                        <p class="text-sm text-gray-600 mt-2">
                            <span class="font-medium">Período:</span><br>
                            <%= moment(aluguel.data_inicio).format('DD/MM/YYYY') %> até <%= moment(aluguel.data_fim).format('DD/MM/YYYY') %>
                        </p>
                        <p class="text-sm text-gray-600 mt-2">
                            <span class="font-medium">Dias Totais:</span><br>
                            <%= moment(aluguel.data_fim).diff(moment(aluguel.data_inicio), 'days') + 1 %> dias
                        </p>
                    </div>
                    <div>
                        <p class="text-sm text-gray-600">
                            <span class="font-medium">Horário de Entrega:</span><br>
                            <%= aluguel.hora_entrega %>
                        </p>
                        <p class="text-sm text-gray-600 mt-2">
                            <span class="font-medium">Endereço:</span><br>
                            <%= aluguel.endereco_entrega %>
                        </p>
                        <% if (aluguel.data_pagamento) { %>
                            <p class="text-sm text-gray-600 mt-2">
                                <span class="font-medium">Data Pagamento:</span><br>
                                <%= moment(aluguel.data_pagamento).format('DD/MM/YYYY HH:mm') %>
                            </p>
                        <% } %>
                    </div>
                </div>
                
                <!-- Itens Alugados -->
                <div class="mb-4">
                    <h4 class="font-semibold text-gray-700 mb-2">Itens Alugados</h4>
                    <div class="space-y-2">
                        <% aluguel.itens.forEach(item => { %>
                            <div class="flex justify-between items-center p-2 bg-gray-50 rounded">
                                <div>
                                    <span class="font-medium"><%= item.nome_brinquedo %></span>
                                    <span class="text-sm text-gray-600 ml-2">x<%= item.quantidade %></span>
                                </div>
                                <div class="text-right">
                                    <span class="text-sm text-gray-600">R$ <%= item.preco_diaria %>/dia</span>
                                    <span class="font-medium ml-3">R$ <%= (item.subtotal || item.preco_diaria * item.quantidade).toFixed(2) %></span>
                                </div>
                            </div>
                        <% }) %>
                    </div>
                </div>
                
                <!-- Ações -->
                <div class="flex gap-2 pt-4 border-t">
                    <% if (aluguel.status === 'aguardando_pagamento') { %>
                        <button onclick="confirmarPagamento('<%= aluguel._id %>')" class="bg-green-600 text-white px-4 py-2 rounded-lg hover:bg-green-700 transition flex items-center gap-2">
                            <span>✓</span> Confirmar Pagamento
                        </button>
                        <button onclick="cancelarAluguel('<%= aluguel._id %>')" class="bg-red-500 text-white px-4 py-2 rounded-lg hover:bg-red-600 transition flex items-center gap-2">
                            <span>✗</span> Cancelar
                        </button>
                    <% } %>
                    <% if (aluguel.status === 'pago') { %>
                        <button onclick="marcarAtivo('<%= aluguel._id %>')" class="bg-blue-600 text-white px-4 py-2 rounded-lg hover:bg-blue-700 transition">
                            Iniciar Aluguel
                        </button>
                        <button onclick="cancelarAluguel('<%= aluguel._id %>')" class="bg-red-500 text-white px-4 py-2 rounded-lg hover:bg-red-600 transition">
                            Cancelar
                        </button>
                    <% } %>
                    <% if (aluguel.status === 'ativo') { %>
                        <button onclick="marcarConcluido('<%= aluguel._id %>')" class="bg-purple-600 text-white px-4 py-2 rounded-lg hover:bg-purple-700 transition">
                            Concluir Aluguel
                        </button>
                    <% } %>
                    <% if (aluguel.status === 'concluido') { %>
                        <span class="text-green-600 bg-green-50 px-4 py-2 rounded-lg">Aluguel Concluído</span>
                    <% } %>
                    <% if (aluguel.status === 'cancelado') { %>
                        <span class="text-red-600 bg-red-50 px-4 py-2 rounded-lg">Aluguel Cancelado</span>
                    <% } %>
                </div>
            </div>
        </div>
    <% }) %>
</div>

<% if (alugueis.length === 0) { %>
    <div class="bg-white rounded-lg shadow-md p-12 text-center">
        <p class="text-gray-500 text-lg">Nenhum aluguel encontrado</p>
    </div>
<% } %>

<script>
function filtrarStatus() {
    const status = document.getElementById('filtroStatus').value;
    if (status) {
        window.location.href = `/admin/alugueis?status=${status}`;
    } else {
        window.location.href = '/admin/alugueis';
    }
}

async function confirmarPagamento(id) {
    if (confirm('Confirmar pagamento deste aluguel?')) {
        try {
            showLoading();
            const response = await fetch(`/admin/alugueis/${id}/confirmar-pagamento`, { 
                method: 'POST',
                headers: { 'Content-Type': 'application/json' }
            });
            const data = await response.json();
            if (data.success) {
                alert('Pagamento confirmado com sucesso!');
                location.reload();
            } else {
                alert('Erro ao confirmar pagamento');
            }
        } catch (error) {
            alert('Erro ao confirmar pagamento');
        } finally {
            hideLoading();
        }
    }
}

async function cancelarAluguel(id) {
    if (confirm('Cancelar este aluguel? Esta ação não pode ser desfeita.')) {
        try {
            showLoading();
            const response = await fetch(`/admin/alugueis/${id}/cancelar`, { 
                method: 'POST',
                headers: { 'Content-Type': 'application/json' }
            });
            const data = await response.json();
            if (data.success) {
                alert('Aluguel cancelado com sucesso!');
                location.reload();
            } else {
                alert('Erro ao cancelar aluguel');
            }
        } catch (error) {
            alert('Erro ao cancelar aluguel');
        } finally {
            hideLoading();
        }
    }
}

async function marcarAtivo(id) {
    if (confirm('Marcar este aluguel como ativo?')) {
        try {
            const response = await fetch(`/admin/alugueis/${id}/confirmar-pagamento`, { 
                method: 'POST',
                headers: { 'Content-Type': 'application/json' }
            });
            const data = await response.json();
            if (data.success) {
                // Atualizar status para ativo
                const updateResponse = await fetch(`/admin/alugueis/${id}/status`, {
                    method: 'PUT',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ status: 'ativo' })
                });
                if (updateResponse.ok) {
                    alert('Aluguel iniciado com sucesso!');
                    location.reload();
                }
            }
        } catch (error) {
            alert('Erro ao iniciar aluguel');
        }
    }
}

async function marcarConcluido(id) {
    if (confirm('Marcar este aluguel como concluído?')) {
        try {
            const response = await fetch(`/admin/alugueis/${id}/status`, {
                method: 'PUT',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ status: 'concluido' })
            });
            if (response.ok) {
                alert('Aluguel concluído com sucesso!');
                location.reload();
            } else {
                alert('Erro ao concluir aluguel');
            }
        } catch (error) {
            alert('Erro ao concluir aluguel');
        }
    }
}
</script>

<%- include('../partials/admin-footer') %>