<!-- views/admin/alugueis.ejs -->
<%- include('../partials/admin-header') %>

<div class="flex flex-col md:flex-row justify-between items-start md:items-center mb-8 gap-4 animate-fade-in">
    <div>
        <h1 class="text-4xl font-bold text-gray-900 mb-2">Gerenciar Aluguéis</h1>
        <p class="text-gray-600">Acompanhe e gerencie todos os aluguéis</p>
    </div>
    <div class="flex gap-3">
        <select id="filtroStatus" onchange="filtrarStatus()" class="px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent transition font-medium">
            <option value="">Todos os Status</option>
            <option value="aguardando_pagamento" <%= status === 'aguardando_pagamento' ? 'selected' : '' %>>Aguardando Pagamento</option>
            <option value="pago" <%= status === 'pago' ? 'selected' : '' %>>Pago</option>
            <option value="ativo" <%= status === 'ativo' ? 'selected' : '' %>>Ativo</option>
            <option value="concluido" <%= status === 'concluido' ? 'selected' : '' %>>Concluído</option>
            <option value="cancelado" <%= status === 'cancelado' ? 'selected' : '' %>>Cancelado</option>
        </select>
    </div>
</div>

<div class="grid gap-6">
    <% alugueis.forEach(aluguel => { 
        const statusColors = {
            'aguardando_pagamento': 'border-l-yellow-500 bg-yellow-50',
            'pago': 'border-l-blue-500 bg-blue-50',
            'ativo': 'border-l-green-500 bg-green-50',
            'concluido': 'border-l-purple-500 bg-purple-50',
            'cancelado': 'border-l-red-500 bg-red-50'
        };
        const statusBadge = {
            'aguardando_pagamento': 'bg-yellow-100 text-yellow-800',
            'pago': 'bg-blue-100 text-blue-800',
            'ativo': 'bg-green-100 text-green-800',
            'concluido': 'bg-purple-100 text-purple-800',
            'cancelado': 'bg-red-100 text-red-800'
        };
        const statusText = {
            'aguardando_pagamento': 'Aguardando Pagamento',
            'pago': 'Pago',
            'ativo': 'Ativo',
            'concluido': 'Concluído',
            'cancelado': 'Cancelado'
        };
    %>
        <div class="bg-white rounded-2xl shadow-md overflow-hidden border-l-4 <%= statusColors[aluguel.status] %> card-hover">
            <div class="p-8">
                <!-- Cabeçalho do Aluguel -->
                <div class="flex flex-col md:flex-row justify-between items-start mb-6 gap-4">
                    <div class="flex-1">
                        <div class="flex items-center gap-3 mb-3">
                            <h3 class="font-bold text-xl text-gray-900">
                                Pedido #<%= aluguel._id.toString().slice(-6) %>
                            </h3>
                            <span class="px-4 py-1 text-xs font-semibold rounded-full <%= statusBadge[aluguel.status] %>">
                                <%= statusText[aluguel.status] %>
                            </span>
                        </div>
                        <div class="space-y-1">
                            <p class="text-gray-700">
                                <span class="font-semibold">Cliente:</span> <%= aluguel.usuario_id.nome %>
                            </p>
                            <p class="text-gray-600 text-sm">
                                <span class="font-medium">Email:</span> <%= aluguel.usuario_id.email %> | 
                                <span class="font-medium">Telefone:</span> <%= aluguel.usuario_id.telefone %>
                            </p>
                        </div>
                    </div>
                    <div class="text-right">
                        <p class="text-3xl font-bold text-indigo-600">R$ <%= aluguel.valor_total.toFixed(2) %></p>
                        <p class="text-sm text-gray-600 mt-1">
                            <span class="font-medium">Pagamento:</span> <%= aluguel.forma_pagamento === 'pix' ? 'PIX' : 'Dinheiro' %>
                            <% if (aluguel.pagamento_confirmado) { %>
                                <span class="text-green-600 font-semibold">(Confirmado)</span>
                            <% } else { %>
                                <span class="text-yellow-600 font-semibold">(Pendente)</span>
                            <% } %>
                        </p>
                    </div>
                </div>
                
                <!-- Detalhes do Aluguel -->
                <div class="grid md:grid-cols-2 gap-6 mb-6 p-6 bg-gray-50 rounded-xl">
                    <div class="space-y-3">
                        <div>
                            <p class="text-sm text-gray-600 font-medium mb-1">Data do Pedido</p>
                            <p class="text-gray-900 font-semibold"><%= moment(aluguel.data_pedido).format('DD/MM/YYYY HH:mm') %></p>
                        </div>
                        <div>
                            <p class="text-sm text-gray-600 font-medium mb-1">Período</p>
                            <p class="text-gray-900 font-semibold"><%= moment(aluguel.data_inicio).format('DD/MM/YYYY') %> até <%= moment(aluguel.data_fim).format('DD/MM/YYYY') %></p>
                        </div>
                        <div>
                            <p class="text-sm text-gray-600 font-medium mb-1">Dias Totais</p>
                            <p class="text-gray-900 font-semibold"><%= moment(aluguel.data_fim).diff(moment(aluguel.data_inicio), 'days') + 1 %> dias</p>
                        </div>
                    </div>
                    <div class="space-y-3">
                        <div>
                            <p class="text-sm text-gray-600 font-medium mb-1">Horário de Entrega</p>
                            <p class="text-gray-900 font-semibold"><%= aluguel.hora_entrega %></p>
                        </div>
                        <div>
                            <p class="text-sm text-gray-600 font-medium mb-1">Endereço</p>
                            <p class="text-gray-900 font-semibold"><%= aluguel.endereco_entrega %></p>
                        </div>
                        <% if (aluguel.data_pagamento) { %>
                            <div>
                                <p class="text-sm text-gray-600 font-medium mb-1">Data Pagamento</p>
                                <p class="text-gray-900 font-semibold"><%= moment(aluguel.data_pagamento).format('DD/MM/YYYY HH:mm') %></p>
                            </div>
                        <% } %>
                    </div>
                </div>
                
                <!-- Itens Alugados -->
                <div class="mb-6">
                    <h4 class="font-semibold text-gray-900 mb-3 text-lg">Itens Alugados</h4>
                    <div class="space-y-2">
                        <% aluguel.itens.forEach(item => { %>
                            <div class="flex justify-between items-center p-4 bg-white rounded-lg border border-gray-200">
                                <div>
                                    <span class="font-semibold text-gray-900"><%= item.nome_brinquedo %></span>
                                    <span class="text-gray-600 ml-2">x<%= item.quantidade %></span>
                                </div>
                                <div class="text-right">
                                    <span class="text-sm text-gray-600">R$ <%= item.preco_diaria %>/dia</span>
                                    <span class="font-bold text-gray-900 ml-3">R$ <%= (item.subtotal || item.preco_diaria * item.quantidade).toFixed(2) %></span>
                                </div>
                            </div>
                        <% }) %>
                    </div>
                </div>
                
                <!-- Ações -->
                <div class="flex flex-wrap gap-3 pt-6 border-t border-gray-200">
                    <% if (aluguel.status === 'aguardando_pagamento') { %>
                        <button onclick="confirmarPagamento('<%= aluguel._id %>')" class="bg-green-600 text-white px-6 py-3 rounded-lg hover:bg-green-700 transition font-semibold shadow-md hover:shadow-lg flex items-center gap-2">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
                            Confirmar Pagamento
                        </button>
                        <button onclick="cancelarAluguel('<%= aluguel._id %>')" class="bg-red-500 text-white px-6 py-3 rounded-lg hover:bg-red-600 transition font-semibold shadow-md hover:shadow-lg flex items-center gap-2">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
                            Cancelar
                        </button>
                    <% } %>
                    <% if (aluguel.status === 'pago') { %>
                        <button onclick="marcarAtivo('<%= aluguel._id %>')" class="bg-blue-600 text-white px-6 py-3 rounded-lg hover:bg-blue-700 transition font-semibold shadow-md hover:shadow-lg">
                            Iniciar Aluguel
                        </button>
                        <button onclick="cancelarAluguel('<%= aluguel._id %>')" class="bg-red-500 text-white px-6 py-3 rounded-lg hover:bg-red-600 transition font-semibold shadow-md hover:shadow-lg">
                            Cancelar
                        </button>
                    <% } %>
                    <% if (aluguel.status === 'ativo') { %>
                        <button onclick="marcarConcluido('<%= aluguel._id %>')" class="bg-purple-600 text-white px-6 py-3 rounded-lg hover:bg-purple-700 transition font-semibold shadow-md hover:shadow-lg">
                            Concluir Aluguel
                        </button>
                    <% } %>
                    <% if (aluguel.status === 'concluido') { %>
                        <span class="text-green-700 bg-green-100 px-6 py-3 rounded-lg font-semibold">Aluguel Concluído</span>
                    <% } %>
                    <% if (aluguel.status === 'cancelado') { %>
                        <span class="text-red-700 bg-red-100 px-6 py-3 rounded-lg font-semibold">Aluguel Cancelado</span>
                    <% } %>
                </div>
            </div>
        </div>
    <% }) %>
</div>

<% if (alugueis.length === 0) { %>
    <div class="bg-white rounded-2xl shadow-md p-16 text-center">
        <svg class="w-20 h-20 text-gray-400 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"></path></svg>
        <p class="text-gray-500 text-xl font-medium">Nenhum aluguel encontrado</p>
    </div>
<% } %>

<script>
function filtrarStatus() {
    const status = document.getElementById('filtroStatus').value;
    if (status) {
        window.location.href = `/admin/alugueis?status=${status}`;
    } else {
        window.location.href = '/admin/alugueis';
    }
}

async function confirmarPagamento(id) {
    if (confirm('Confirmar pagamento deste aluguel?')) {
        try {
            showLoading();
            const response = await fetch(`/admin/alugueis/${id}/confirmar-pagamento`, { 
                method: 'POST',
                headers: { 'Content-Type': 'application/json' }
            });
            const data = await response.json();
            if (data.success) {
                alert('Pagamento confirmado com sucesso!');
                location.reload();
            } else {
                alert('Erro ao confirmar pagamento');
            }
        } catch (error) {
            alert('Erro ao confirmar pagamento');
        } finally {
            hideLoading();
        }
    }
}

async function cancelarAluguel(id) {
    if (confirm('Cancelar este aluguel? Esta ação não pode ser desfeita.')) {
        try {
            showLoading();
            const response = await fetch(`/admin/alugueis/${id}/cancelar`, { 
                method: 'POST',
                headers: { 'Content-Type': 'application/json' }
            });
            const data = await response.json();
            if (data.success) {
                alert('Aluguel cancelado com sucesso!');
                location.reload();
            } else {
                alert('Erro ao cancelar aluguel');
            }
        } catch (error) {
            alert('Erro ao cancelar aluguel');
        } finally {
            hideLoading();
        }
    }
}

async function marcarAtivo(id) {
    if (confirm('Marcar este aluguel como ativo?')) {
        try {
            const response = await fetch(`/admin/alugueis/${id}/confirmar-pagamento`, { 
                method: 'POST',
                headers: { 'Content-Type': 'application/json' }
            });
            const data = await response.json();
            if (data.success) {
                const updateResponse = await fetch(`/admin/alugueis/${id}/status`, {
                    method: 'PUT',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ status: 'ativo' })
                });
                if (updateResponse.ok) {
                    alert('Aluguel iniciado com sucesso!');
                    location.reload();
                }
            }
        } catch (error) {
            alert('Erro ao iniciar aluguel');
        }
    }
}

async function marcarConcluido(id) {
    if (confirm('Marcar este aluguel como concluído?')) {
        try {
            const response = await fetch(`/admin/alugueis/${id}/status`, {
                method: 'PUT',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ status: 'concluido' })
            });
            if (response.ok) {
                alert('Aluguel concluído com sucesso!');
                location.reload();
            } else {
                alert('Erro ao concluir aluguel');
            }
        } catch (error) {
            alert('Erro ao concluir aluguel');
        }
    }
}
</script>

<%- include('../partials/admin-footer') %>