<%- include('../partials/admin-header.ejs') %>

<div class="mb-8 flex justify-between items-center">
    <h1 class="text-3xl font-bold">Gerenciar Brinquedos</h1>
    <button onclick="abrirModal()" class="bg-blue-600 text-white px-4 py-2 rounded-lg hover:bg-blue-700">
        <i class="ri-add-line"></i> Novo Brinquedo
    </button>
</div>

<!-- Lista de Brinquedos -->
<div class="bg-white rounded-lg shadow-lg overflow-hidden">
    <table class="w-full">
        <thead class="bg-gray-800 text-white">
            <tr>
                <th class="p-3">ID</th>
                <th class="p-3">Imagem</th>
                <th class="p-3">Nome</th>
                <th class="p-3">Preço Diária</th>
                <th class="p-3">Preço Semanal</th>
                <th class="p-3">Estoque</th>
                <th class="p-3">Ações</th>
            </tr>
        </thead>
        <tbody>
            <% if (brinquedos && brinquedos.length > 0) { %>
                <% brinquedos.forEach(brinquedo => { %>
                    <tr class="border-b hover:bg-gray-50">
                        <td class="p-3"><%= brinquedo.id %></td>
                        <td class="p-3">
                            <img src="<%= brinquedo.imagem_url || '/uploads/placeholder.jpg' %>" class="w-12 h-12 object-cover rounded">
                        </td>
                        <td class="p-3"><%= brinquedo.nome %></td>
                        <td class="p-3">R$ <%= brinquedo.preco_diaria %></td>
                        <td class="p-3">R$ <%= brinquedo.preco_semanal %></td>
                        <td class="p-3"><%= brinquedo.quantidade_estoque %></td>
                        <td class="p-3">
                            <button onclick="editarBrinquedo(<%= brinquedo.id %>)" class="text-blue-600 mr-2">Editar</button>
                            <button onclick="excluirBrinquedo(<%= brinquedo.id %>)" class="text-red-600">Excluir</button>
                        </td>
                    </tr>
                <% }) %>
            <% } else { %>
                <tr><td colspan="7" class="text-center p-8">Nenhum brinquedo cadastrado</td></tr>
            <% } %>
        </tbody>
    </table>
</div>

<!-- Modal para Adicionar/Editar Brinquedo -->
<div id="modal" class="fixed inset-0 bg-black bg-opacity-50 hidden items-center justify-center z-50">
    <div class="bg-white rounded-lg p-8 max-w-md w-full">
        <h2 id="modalTitle" class="text-2xl font-bold mb-4">Novo Brinquedo</h2>
        <form id="formBrinquedo">
            <input type="hidden" id="brinquedoId">
            <div class="mb-4">
                <label class="block mb-2">Nome</label>
                <input type="text" id="nome" required class="w-full p-2 border rounded">
            </div>
            <div class="mb-4">
                <label class="block mb-2">Descrição</label>
                <textarea id="descricao" rows="3" class="w-full p-2 border rounded"></textarea>
            </div>
            <div class="mb-4">
                <label class="block mb-2">Preço Diária (R$)</label>
                <input type="number" id="precoDiaria" step="0.01" required class="w-full p-2 border rounded">
            </div>
            <div class="mb-4">
                <label class="block mb-2">Preço Semanal (R$)</label>
                <input type="number" id="precoSemanal" step="0.01" required class="w-full p-2 border rounded">
            </div>
            <div class="mb-4">
                <label class="block mb-2">Quantidade em Estoque</label>
                <input type="number" id="estoque" required class="w-full p-2 border rounded">
            </div>
            <div class="mb-4">
                <label class="block mb-2">URL da Imagem</label>
                <input type="text" id="imagem" class="w-full p-2 border rounded" placeholder="https://exemplo.com/imagem.jpg">
            </div>
            <div class="flex justify-end space-x-2">
                <button type="button" onclick="fecharModal()" class="px-4 py-2 bg-gray-300 rounded">Cancelar</button>
                <button type="submit" class="px-4 py-2 bg-blue-600 text-white rounded">Salvar</button>
            </div>
        </form>
    </div>
</div>

<script>
    function abrirModal() {
        document.getElementById('modalTitle').innerText = 'Novo Brinquedo';
        document.getElementById('formBrinquedo').reset();
        document.getElementById('brinquedoId').value = '';
        document.getElementById('modal').classList.remove('hidden');
        document.getElementById('modal').classList.add('flex');
    }
    
    function fecharModal() {
        document.getElementById('modal').classList.add('hidden');
        document.getElementById('modal').classList.remove('flex');
    }
    
    document.getElementById('formBrinquedo').addEventListener('submit', async (e) => {
        e.preventDefault();
        const id = document.getElementById('brinquedoId').value;
        const dados = {
            nome: document.getElementById('nome').value,
            descricao: document.getElementById('descricao').value,
            preco_diaria: parseFloat(document.getElementById('precoDiaria').value),
            preco_semanal: parseFloat(document.getElementById('precoSemanal').value),
            quantidade_estoque: parseInt(document.getElementById('estoque').value),
            imagem_url: document.getElementById('imagem').value
        };
        
        const url = id ? `/admin/brinquedos/${id}` : '/admin/brinquedos';
        const method = id ? 'PUT' : 'POST';
        
        const response = await fetch(url, {
            method: method,
            headers: {'Content-Type': 'application/json'},
            body: JSON.stringify(dados)
        });
        
        if (response.ok) {
            alert('Brinquedo salvo com sucesso!');
            location.reload();
        } else {
            alert('Erro ao salvar brinquedo');
        }
    });
    
    function editarBrinquedo(id) {
        fetch(`/admin/brinquedos/${id}`)
            .then(res => res.json())
            .then(data => {
                document.getElementById('brinquedoId').value = data.id;
                document.getElementById('nome').value = data.nome;
                document.getElementById('descricao').value = data.descricao;
                document.getElementById('precoDiaria').value = data.preco_diaria;
                document.getElementById('precoSemanal').value = data.preco_semanal;
                document.getElementById('estoque').value = data.quantidade_estoque;
                document.getElementById('imagem').value = data.imagem_url || '';
                document.getElementById('modalTitle').innerText = 'Editar Brinquedo';
                document.getElementById('modal').classList.remove('hidden');
                document.getElementById('modal').classList.add('flex');
            });
    }
    
    function excluirBrinquedo(id) {
        if (confirm('Tem certeza que deseja excluir este brinquedo?')) {
            fetch(`/admin/brinquedos/${id}`, {method: 'DELETE'})
                .then(res => {
                    if (res.ok) {
                        alert('Brinquedo excluído!');
                        location.reload();
                    } else {
                        alert('Erro ao excluir');
                    }
                });
        }
    }
</script>

<%- include('../partials/footer.ejs') %>