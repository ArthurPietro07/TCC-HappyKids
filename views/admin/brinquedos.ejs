<%- include('../partials/admin-header') %>

<div class="flex flex-col md:flex-row justify-between items-start md:items-center mb-8 gap-4 animate-fade-in">
    <div>
        <h1 class="text-4xl font-bold text-gray-900 mb-2">Gerenciar Brinquedos</h1>
        <p class="text-gray-600">Adicione, edite ou remova brinquedos do catálogo</p>
    </div>
    <button onclick="abrirModalNovo()" class="bg-green-600 text-white px-6 py-3 rounded-xl hover:bg-green-700 transition font-semibold shadow-md hover:shadow-lg flex items-center gap-2">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path></svg>
        Novo Brinquedo
    </button>
</div>

<div class="bg-white rounded-2xl shadow-md overflow-hidden">
    <div class="overflow-x-auto">
        <table class="w-full">
            <thead class="bg-gray-50 border-b-2 border-gray-200">
                <tr>
                    <th class="px-6 py-4 text-left text-sm font-semibold text-gray-700 uppercase tracking-wider">Imagem</th>
                    <th class="px-6 py-4 text-left text-sm font-semibold text-gray-700 uppercase tracking-wider">Nome</th>
                    <th class="px-6 py-4 text-left text-sm font-semibold text-gray-700 uppercase tracking-wider">Estoque</th>
                    <th class="px-6 py-4 text-left text-sm font-semibold text-gray-700 uppercase tracking-wider">Preço</th>
                    <th class="px-6 py-4 text-left text-sm font-semibold text-gray-700 uppercase tracking-wider">Destaque</th>
                    <th class="px-6 py-4 text-left text-sm font-semibold text-gray-700 uppercase tracking-wider">Status</th>
                    <th class="px-6 py-4 text-left text-sm font-semibold text-gray-700 uppercase tracking-wider">Ações</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-gray-200">
                <% brinquedos.forEach(brinquedo => { 
                    const imagemPrincipal = brinquedo.imagens.find(img => img.principal) || brinquedo.imagens[0];
                %>
                    <tr class="hover:bg-gray-50 transition">
                        <td class="px-6 py-4">
                            <img src="<%= imagemPrincipal ? imagemPrincipal.url : '/uploads/default.jpg' %>" alt="<%= brinquedo.nome %>" class="w-16 h-16 object-cover rounded-lg shadow-sm">
                        </td>
                        <td class="px-6 py-4 font-semibold text-gray-900"><%= brinquedo.nome %></td>
                        <td class="px-6 py-4">
                            <span class="px-3 py-1 rounded-full text-sm font-semibold <%= brinquedo.quantidade_estoque > 0 ? 'bg-green-100 text-green-800' : 'bg-red-100 text-red-800' %>">
                                <%= brinquedo.quantidade_estoque %>
                            </span>
                        </td>
                        <td class="px-6 py-4 font-semibold text-gray-900">R$ <%= brinquedo.preco_diaria.toFixed(2) %>/dia</td>
                        <td class="px-6 py-4">
                            <% if (brinquedo.destaque) { %>
                                <span class="px-3 py-1 rounded-full text-xs font-semibold bg-yellow-100 text-yellow-800">
                                    ⭐ Destaque
                                </span>
                            <% } else { %>
                                <span class="px-3 py-1 rounded-full text-xs font-semibold bg-gray-100 text-gray-500">
                                    Normal
                                </span>
                            <% } %>
                        </td>
                        <td class="px-6 py-4">
                            <span class="px-3 py-1 rounded-full text-xs font-semibold <%= brinquedo.disponivel ? 'bg-green-100 text-green-800' : 'bg-red-100 text-red-800' %>">
                                <%= brinquedo.disponivel ? 'Disponível' : 'Indisponível' %>
                            </span>
                        </td>
                        <td class="px-6 py-4">
                            <div class="flex gap-3">
                                <button onclick="editarBrinquedo('<%= brinquedo._id %>')" class="text-indigo-600 hover:text-indigo-700 font-medium flex items-center gap-1">
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path></svg>
                                    Editar
                                </button>
                                <button onclick="excluirBrinquedo('<%= brinquedo._id %>')" class="text-red-600 hover:text-red-700 font-medium flex items-center gap-1">
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>
                                    Excluir
                                </button>
                            </div>
                        </td>
                    </tr>
                <% }) %>
            </tbody>
        </table>
    </div>
</div>

<!-- Modal Novo/Editar -->
<div id="modalBrinquedo" class="modal" style="display: none;">
    <div class="modal-content" style="max-width: 700px; max-height: 85vh; overflow-y: auto;">
        <div class="p-6 border-b border-gray-200 bg-gray-50">
            <div class="flex justify-between items-center">
                <h2 id="modalTitulo" class="text-2xl font-bold text-gray-900">Novo Brinquedo</h2>
                <button onclick="fecharModal()" class="text-gray-400 hover:text-gray-600 transition">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
                </button>
            </div>
        </div>
        
        <form id="formBrinquedo" enctype="multipart/form-data" class="p-6">
            <input type="hidden" id="brinquedoId">
            <input type="hidden" id="imagensExistentes" value="">
            <input type="hidden" id="imagensParaRemover" value="">
            
            <div class="mb-5">
                <label class="block text-gray-700 mb-2 text-sm font-semibold">Nome</label>
                <input type="text" id="nome" required class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent transition">
            </div>
            
            <div class="mb-5">
                <label class="block text-gray-700 mb-2 text-sm font-semibold">Descrição</label>
                <textarea id="descricao" required rows="3" class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent transition" placeholder="Escreva a descrição do brinquedo..."></textarea>
                <p class="text-xs text-gray-500 mt-1">Use Enter para quebrar linha - a formatação será preservada</p>
            </div>
            
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-5">
                <div>
                    <label class="block text-gray-700 mb-2 text-sm font-semibold">Estoque</label>
                    <input type="number" id="quantidade_estoque" required min="0" class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent transition">
                </div>
                <div>
                    <label class="block text-gray-700 mb-2 text-sm font-semibold">Preço Diária (R$)</label>
                    <input type="number" id="preco_diaria" required step="0.01" class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent transition">
                </div>
            </div>
            
            <!-- Galeria de Imagens Existentes -->
            <div id="galeriaImagens" class="mb-5" style="display: none;">
                <label class="block text-gray-700 mb-3 text-sm font-semibold">Imagens do Brinquedo</label>
                <div id="listaImagens" class="grid grid-cols-4 gap-3 mb-3"></div>
            </div>
            
            <div class="mb-5">
                <label class="block text-gray-700 mb-2 text-sm font-semibold">Adicionar Novas Imagens</label>
                <input type="file" id="imagens" name="imagens" accept="image/jpeg,image/png,image/gif,image/webp" multiple class="w-full text-sm file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:text-sm file:font-semibold file:bg-indigo-50 file:text-indigo-700 hover:file:bg-indigo-100">
                <p class="text-xs text-gray-500 mt-2">Você pode selecionar até 10 imagens (JPG, PNG, GIF, WEBP até 5MB cada)</p>
            </div>
            
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-6">
                <label class="flex items-center cursor-pointer p-3 bg-gray-50 rounded-lg hover:bg-gray-100 transition">
                    <input type="checkbox" id="disponivel" class="mr-3 w-5 h-5 rounded border-gray-300 text-indigo-600 focus:ring-indigo-500">
                    <div>
                        <span class="text-sm font-medium text-gray-700">Disponível para aluguel</span>
                        <p class="text-xs text-gray-500">Clientes podem ver e alugar</p>
                    </div>
                </label>
                
                <label class="flex items-center cursor-pointer p-3 bg-yellow-50 rounded-lg hover:bg-yellow-100 transition">
                    <input type="checkbox" id="destaque" class="mr-3 w-5 h-5 rounded border-gray-300 text-yellow-500 focus:ring-yellow-500">
                    <div>
                        <span class="text-sm font-medium text-gray-700">⭐ Destaque na página inicial</span>
                        <p class="text-xs text-gray-500">Aparece nos 3 destaques da home</p>
                    </div>
                </label>
            </div>
            
            <div class="flex justify-end gap-3 pt-4 border-t border-gray-200">
                <button type="button" onclick="fecharModal()" class="px-6 py-3 bg-gray-200 text-gray-700 rounded-lg hover:bg-gray-300 transition font-semibold">Cancelar</button>
                <button type="submit" class="px-6 py-3 bg-indigo-600 text-white rounded-lg hover:bg-indigo-700 transition font-semibold shadow-md">Salvar</button>
            </div>
        </form>
    </div>
</div>

<style>
.modal {
    display: none;
    position: fixed;
    z-index: 1000;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0,0,0,0.5);
    backdrop-filter: blur(4px);
}
.modal-content {
    background-color: white;
    margin: 2% auto;
    padding: 0;
    border-radius: 16px;
    width: 90%;
    max-width: 700px;
    max-height: 90vh;
    overflow-y: auto;
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25);
}
.imagem-item {
    position: relative;
    border: 2px solid #e5e7eb;
    border-radius: 12px;
    overflow: hidden;
    cursor: pointer;
    transition: all 0.2s ease;
}
.imagem-item:hover {
    border-color: #d1d5db;
    transform: scale(1.02);
}
.imagem-item.principal {
    border-color: #6366f1;
    box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.2);
}
.imagem-item img {
    width: 100%;
    height: 100px;
    object-fit: cover;
}
.imagem-item .badge {
    position: absolute;
    top: 6px;
    right: 6px;
    background: rgba(0,0,0,0.8);
    color: white;
    font-size: 10px;
    padding: 3px 8px;
    border-radius: 6px;
    font-weight: 600;
}
.imagem-item .btn-remover {
    position: absolute;
    bottom: 6px;
    left: 6px;
    background: rgba(239,68,68,0.95);
    color: white;
    border: none;
    border-radius: 6px;
    padding: 4px 8px;
    font-size: 10px;
    cursor: pointer;
    font-weight: 600;
    transition: background 0.2s;
}
.imagem-item .btn-remover:hover {
    background: rgba(220,38,38,1);
}
.imagem-item .btn-principal {
    position: absolute;
    bottom: 6px;
    right: 6px;
    background: rgba(99,102,241,0.95);
    color: white;
    border: none;
    border-radius: 6px;
    padding: 4px 8px;
    font-size: 10px;
    cursor: pointer;
    font-weight: 600;
    transition: background 0.2s;
}
.imagem-item .btn-principal:hover {
    background: rgba(79,70,229,1);
}
</style>

<script>
let imagensAtuais = [];
let imagensRemover = [];

const modal = document.getElementById('modalBrinquedo');

function abrirModalNovo() {
    document.getElementById('modalTitulo').innerText = 'Novo Brinquedo';
    document.getElementById('formBrinquedo').reset();
    document.getElementById('brinquedoId').value = '';
    document.getElementById('disponivel').checked = true;
    document.getElementById('destaque').checked = false;
    document.getElementById('galeriaImagens').style.display = 'none';
    document.getElementById('imagens').value = '';
    imagensAtuais = [];
    imagensRemover = [];
    modal.style.display = 'block';
}

function fecharModal() {
    modal.style.display = 'none';
}

async function editarBrinquedo(id) {
    try {
        showLoading();
        const response = await fetch(`/admin/brinquedos/${id}`);
        const brinquedo = await response.json();
        
        document.getElementById('modalTitulo').innerText = 'Editar Brinquedo';
        document.getElementById('brinquedoId').value = brinquedo._id;
        document.getElementById('nome').value = brinquedo.nome;
        document.getElementById('descricao').value = brinquedo.descricao;
        document.getElementById('quantidade_estoque').value = brinquedo.quantidade_estoque;
        document.getElementById('preco_diaria').value = brinquedo.preco_diaria;
        document.getElementById('disponivel').checked = brinquedo.disponivel;
        document.getElementById('destaque').checked = brinquedo.destaque || false;
        
        imagensAtuais = brinquedo.imagens || [];
        imagensRemover = [];
        renderizarGaleria();
        
        document.getElementById('galeriaImagens').style.display = 'block';
        modal.style.display = 'block';
        hideLoading();
    } catch (error) {
        hideLoading();
        alert('Erro ao carregar dados do brinquedo');
    }
}

function renderizarGaleria() {
    const container = document.getElementById('listaImagens');
    
    if (imagensAtuais.length === 0) {
        container.innerHTML = '<div class="col-span-4 text-center text-gray-500 py-8">Nenhuma imagem cadastrada</div>';
        return;
    }
    
    container.innerHTML = imagensAtuais.map(img => `
        <div class="imagem-item ${img.principal ? 'principal' : ''}" data-filename="${img.filename}">
            <img src="${img.url}" alt="Imagem">
            <div class="badge">${img.principal ? 'Principal' : ''}</div>
            <button type="button" class="btn-remover" onclick="removerImagem('${img.filename}')">Remover</button>
            ${!img.principal ? `<button type="button" class="btn-principal" onclick="definirPrincipal('${img.filename}')">Principal</button>` : ''}
        </div>
    `).join('');
    
    document.getElementById('imagensExistentes').value = JSON.stringify(imagensAtuais.map(img => img.filename));
}

function removerImagem(filename) {
    if (confirm('Remover esta imagem?')) {
        imagensRemover.push(filename);
        imagensAtuais = imagensAtuais.filter(img => img.filename !== filename);
        
        if (imagensAtuais.length > 0 && !imagensAtuais.some(img => img.principal)) {
            imagensAtuais[0].principal = true;
        }
        
        renderizarGaleria();
        document.getElementById('imagensParaRemover').value = JSON.stringify(imagensRemover);
    }
}

async function definirPrincipal(filename) {
    const id = document.getElementById('brinquedoId').value;
    if (!id) return;
    
    try {
        showLoading();
        await fetch(`/admin/brinquedos/${id}/principal`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ filename })
        });
        
        imagensAtuais.forEach(img => {
            img.principal = img.filename === filename;
        });
        renderizarGaleria();
        hideLoading();
    } catch (error) {
        hideLoading();
        alert('Erro ao definir imagem principal');
    }
}

document.getElementById('formBrinquedo').addEventListener('submit', async (e) => {
    e.preventDefault();
    
    const id = document.getElementById('brinquedoId').value;
    const formData = new FormData();
    formData.append('nome', document.getElementById('nome').value);
    formData.append('descricao', document.getElementById('descricao').value);
    formData.append('quantidade_estoque', document.getElementById('quantidade_estoque').value);
    formData.append('preco_diaria', document.getElementById('preco_diaria').value);
    formData.append('disponivel', document.getElementById('disponivel').checked);
    formData.append('destaque', document.getElementById('destaque').checked);
    
    if (id) {
        formData.append('imagensExistentes', document.getElementById('imagensExistentes').value);
        formData.append('imagensParaRemover', document.getElementById('imagensParaRemover').value);
    }
    
    const imagensInput = document.getElementById('imagens');
    for (let i = 0; i < imagensInput.files.length; i++) {
        formData.append('imagens', imagensInput.files[i]);
    }
    
    const url = id ? `/admin/brinquedos/${id}` : '/admin/brinquedos';
    const method = id ? 'PUT' : 'POST';
    
    try {
        showLoading();
        const response = await fetch(url, { method, body: formData });
        
        if (response.ok) {
            alert(id ? 'Brinquedo atualizado com sucesso!' : 'Brinquedo criado com sucesso!');
            location.reload();
        } else {
            const error = await response.json();
            alert(error.error || 'Erro ao salvar');
        }
        hideLoading();
    } catch (error) {
        hideLoading();
        alert('Erro ao salvar');
    }
});

async function excluirBrinquedo(id) {
    if (confirm('Tem certeza que deseja excluir este brinquedo? Todas as imagens serão removidas.')) {
        try {
            showLoading();
            const response = await fetch(`/admin/brinquedos/${id}`, { method: 'DELETE' });
            if (response.ok) {
                alert('Brinquedo excluído!');
                location.reload();
            } else {
                alert('Erro ao excluir');
            }
            hideLoading();
        } catch (error) {
            hideLoading();
            alert('Erro ao excluir');
        }
    }
}

window.onclick = function(event) {
    if (event.target === modal) {
        modal.style.display = 'none';
    }
}
</script>

<%- include('../partials/admin-footer') %>