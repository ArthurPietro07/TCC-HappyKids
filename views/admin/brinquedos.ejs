<%- include('../partials/admin-header') %>

<div class="flex justify-between items-center mb-6">
    <h1 class="text-3xl font-bold">Gerenciar Brinquedos</h1>
    <button onclick="abrirModalNovo()" class="bg-green-600 text-white px-4 py-2 rounded-lg hover:bg-green-700 transition">
        + Novo Brinquedo
    </button>
</div>

<div class="bg-white rounded-lg shadow-md overflow-hidden">
    <div class="overflow-x-auto">
        <table class="w-full">
            <thead class="bg-gray-100">
                <tr>
                    <th class="px-4 py-3 text-left">Imagem Principal</th>
                    <th class="px-4 py-3 text-left">Nome</th>
                    <th class="px-4 py-3 text-left">Estoque</th>
                    <th class="px-4 py-3 text-left">Preço Diária</th>
                    <th class="px-4 py-3 text-left">Status</th>
                    <th class="px-4 py-3 text-left">Ações</th>
                </tr>
            </thead>
            <tbody>
                <% brinquedos.forEach(brinquedo => { 
                    const imagemPrincipal = brinquedo.imagens.find(img => img.principal) || brinquedo.imagens[0];
                %>
                    <tr class="border-t hover:bg-gray-50">
                        <td class="px-4 py-3">
                            <img src="<%= imagemPrincipal ? imagemPrincipal.url : '/uploads/default.jpg' %>" alt="<%= brinquedo.nome %>" class="w-12 h-12 object-cover rounded">
                        </td>
                        <td class="px-4 py-3"><%= brinquedo.nome %></td>
                        <td class="px-4 py-3"><%= brinquedo.quantidade_estoque %></td>
                        <td class="px-4 py-3">R$ <%= brinquedo.preco_diaria.toFixed(2) %></td>
                        <td class="px-4 py-3">
                            <span class="px-2 py-1 rounded text-xs <%= brinquedo.disponivel ? 'bg-green-100 text-green-800' : 'bg-red-100 text-red-800' %>">
                                <%= brinquedo.disponivel ? 'Disponível' : 'Indisponível' %>
                            </span>
                        </td>
                        <td class="px-4 py-3">
                            <button onclick="editarBrinquedo('<%= brinquedo._id %>')" class="text-blue-600 hover:underline mr-2">Editar</button>
                            <button onclick="excluirBrinquedo('<%= brinquedo._id %>')" class="text-red-600 hover:underline">Excluir</button>
                        </td>
                    </tr>
                <% }) %>
            </tbody>
        </table>
    </div>
</div>

<!-- Modal Novo/Editar -->
<div id="modalBrinquedo" class="modal" style="display: none;">
    <div class="modal-content" style="max-width: 700px; max-height: 85vh; overflow-y: auto;">
        <div class="flex justify-between items-center mb-4 pb-3 border-b">
            <h2 id="modalTitulo" class="text-xl font-bold text-gray-800">Novo Brinquedo</h2>
            <button onclick="fecharModal()" class="text-gray-500 hover:text-gray-700 text-2xl">&times;</button>
        </div>
        
        <form id="formBrinquedo" enctype="multipart/form-data">
            <input type="hidden" id="brinquedoId">
            <input type="hidden" id="imagensExistentes" value="">
            <input type="hidden" id="imagensParaRemover" value="">
            
            <div class="mb-3">
                <label class="block text-gray-700 mb-1 text-sm font-medium">Nome</label>
                <input type="text" id="nome" required class="w-full px-3 py-2 border rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500">
            </div>
            
            <div class="mb-3">
                <label class="block text-gray-700 mb-1 text-sm font-medium">Descrição</label>
                <textarea id="descricao" required rows="3" class="w-full px-3 py-2 border rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500"></textarea>
            </div>
            
            <div class="mb-3">
                <label class="block text-gray-700 mb-1 text-sm font-medium">Quantidade em Estoque</label>
                <input type="number" id="quantidade_estoque" required min="0" class="w-full px-3 py-2 border rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500">
            </div>
            
            <div class="mb-3">
                <label class="block text-gray-700 mb-1 text-sm font-medium">Preço Diária (R$)</label>
                <input type="number" id="preco_diaria" required step="0.01" class="w-full px-3 py-2 border rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500">
            </div>
            
            <div class="mb-3">
                <label class="block text-gray-700 mb-1 text-sm font-medium">Preço Semanal (R$)</label>
                <input type="number" id="preco_semanal" required step="0.01" class="w-full px-3 py-2 border rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500">
            </div>
            
            <!-- Galeria de Imagens Existentes -->
            <div id="galeriaImagens" class="mb-3" style="display: none;">
                <label class="block text-gray-700 mb-2 text-sm font-medium">Imagens do Brinquedo</label>
                <div id="listaImagens" class="grid grid-cols-4 gap-3 mb-3"></div>
            </div>
            
            <div class="mb-3">
                <label class="block text-gray-700 mb-1 text-sm font-medium">Adicionar Novas Imagens</label>
                <input type="file" id="novasImagens" accept="image/jpeg,image/png,image/gif,image/webp" multiple class="w-full text-sm">
                <p class="text-xs text-gray-500 mt-1">Você pode selecionar até 10 imagens (JPG, PNG, GIF, WEBP até 5MB cada)</p>
            </div>
            
            <div class="mb-4">
                <label class="flex items-center cursor-pointer">
                    <input type="checkbox" id="disponivel" class="mr-2 w-4 h-4">
                    <span class="text-sm">Disponível para aluguel</span>
                </label>
            </div>
            
            <div class="flex justify-end gap-2 pt-3 border-t">
                <button type="button" onclick="fecharModal()" class="px-4 py-2 bg-gray-300 rounded-lg hover:bg-gray-400 transition">Cancelar</button>
                <button type="submit" class="px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition">Salvar</button>
            </div>
        </form>
    </div>
</div>

<style>
.modal {
    display: none;
    position: fixed;
    z-index: 1000;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0,0,0,0.5);
}
.modal-content {
    background-color: white;
    margin: 2% auto;
    padding: 20px;
    border-radius: 12px;
    width: 90%;
    max-width: 700px;
    max-height: 90vh;
    overflow-y: auto;
    box-shadow: 0 4px 20px rgba(0,0,0,0.15);
}
.imagem-item {
    position: relative;
    border: 2px solid #e5e7eb;
    border-radius: 8px;
    overflow: hidden;
    cursor: pointer;
}
.imagem-item.principal {
    border-color: #3b82f6;
    box-shadow: 0 0 0 2px rgba(59,130,246,0.3);
}
.imagem-item img {
    width: 100%;
    height: 80px;
    object-fit: cover;
}
.imagem-item .badge {
    position: absolute;
    top: 4px;
    right: 4px;
    background: rgba(0,0,0,0.7);
    color: white;
    font-size: 10px;
    padding: 2px 6px;
    border-radius: 4px;
}
.imagem-item .btn-remover {
    position: absolute;
    bottom: 4px;
    left: 4px;
    background: rgba(239,68,68,0.9);
    color: white;
    border: none;
    border-radius: 4px;
    padding: 2px 6px;
    font-size: 10px;
    cursor: pointer;
}
.imagem-item .btn-principal {
    position: absolute;
    bottom: 4px;
    right: 4px;
    background: rgba(59,130,246,0.9);
    color: white;
    border: none;
    border-radius: 4px;
    padding: 2px 6px;
    font-size: 10px;
    cursor: pointer;
}
</style>

<script>
let imagensAtuais = [];
let imagensRemover = [];

const modal = document.getElementById('modalBrinquedo');

function abrirModalNovo() {
    document.getElementById('modalTitulo').innerText = 'Novo Brinquedo';
    document.getElementById('formBrinquedo').reset();
    document.getElementById('brinquedoId').value = '';
    document.getElementById('disponivel').checked = true;
    document.getElementById('galeriaImagens').style.display = 'none';
    imagensAtuais = [];
    imagensRemover = [];
    modal.style.display = 'block';
}

function fecharModal() {
    modal.style.display = 'none';
}

async function editarBrinquedo(id) {
    try {
        showLoading();
        const response = await fetch(`/admin/brinquedos/${id}`);
        const brinquedo = await response.json();
        
        document.getElementById('modalTitulo').innerText = 'Editar Brinquedo';
        document.getElementById('brinquedoId').value = brinquedo._id;
        document.getElementById('nome').value = brinquedo.nome;
        document.getElementById('descricao').value = brinquedo.descricao;
        document.getElementById('quantidade_estoque').value = brinquedo.quantidade_estoque;
        document.getElementById('preco_diaria').value = brinquedo.preco_diaria;
        document.getElementById('preco_semanal').value = brinquedo.preco_semanal;
        document.getElementById('disponivel').checked = brinquedo.disponivel;
        
        imagensAtuais = brinquedo.imagens || [];
        imagensRemover = [];
        renderizarGaleria();
        
        document.getElementById('galeriaImagens').style.display = 'block';
        modal.style.display = 'block';
        hideLoading();
    } catch (error) {
        hideLoading();
        alert('Erro ao carregar dados do brinquedo');
    }
}

function renderizarGaleria() {
    const container = document.getElementById('listaImagens');
    
    if (imagensAtuais.length === 0) {
        container.innerHTML = '<div class="col-span-4 text-center text-gray-500 py-4">Nenhuma imagem cadastrada</div>';
        return;
    }
    
    container.innerHTML = imagensAtuais.map(img => `
        <div class="imagem-item ${img.principal ? 'principal' : ''}" data-filename="${img.filename}">
            <img src="${img.url}" alt="Imagem">
            <div class="badge">${img.principal ? 'Principal' : ''}</div>
            <button type="button" class="btn-remover" onclick="removerImagem('${img.filename}')">Remover</button>
            ${!img.principal ? `<button type="button" class="btn-principal" onclick="definirPrincipal('${img.filename}')">Principal</button>` : ''}
        </div>
    `).join('');
    
    document.getElementById('imagensExistentes').value = JSON.stringify(imagensAtuais.map(img => img.filename));
}

function removerImagem(filename) {
    if (confirm('Remover esta imagem?')) {
        imagensRemover.push(filename);
        imagensAtuais = imagensAtuais.filter(img => img.filename !== filename);
        
        // Se removeu a imagem principal, definir a primeira como principal
        if (imagensAtuais.length > 0 && !imagensAtuais.some(img => img.principal)) {
            imagensAtuais[0].principal = true;
        }
        
        renderizarGaleria();
        document.getElementById('imagensParaRemover').value = JSON.stringify(imagensRemover);
    }
}

async function definirPrincipal(filename) {
    const id = document.getElementById('brinquedoId').value;
    if (!id) return;
    
    try {
        showLoading();
        await fetch(`/admin/brinquedos/${id}/principal`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ filename })
        });
        
        imagensAtuais.forEach(img => {
            img.principal = img.filename === filename;
        });
        renderizarGaleria();
        hideLoading();
    } catch (error) {
        hideLoading();
        alert('Erro ao definir imagem principal');
    }
}

document.getElementById('formBrinquedo').addEventListener('submit', async (e) => {
    e.preventDefault();
    
    const id = document.getElementById('brinquedoId').value;
    const formData = new FormData();
    formData.append('nome', document.getElementById('nome').value);
    formData.append('descricao', document.getElementById('descricao').value);
    formData.append('quantidade_estoque', document.getElementById('quantidade_estoque').value);
    formData.append('preco_diaria', document.getElementById('preco_diaria').value);
    formData.append('preco_semanal', document.getElementById('preco_semanal').value);
    formData.append('disponivel', document.getElementById('disponivel').checked);
    
    if (id) {
        formData.append('imagensExistentes', document.getElementById('imagensExistentes').value);
        formData.append('imagensParaRemover', document.getElementById('imagensParaRemover').value);
    }
    
    const novasImagens = document.getElementById('novasImagens').files;
    for (let i = 0; i < novasImagens.length; i++) {
        formData.append('novasImagens', novasImagens[i]);
    }
    
    const url = id ? `/admin/brinquedos/${id}` : '/admin/brinquedos';
    const method = id ? 'PUT' : 'POST';
    
    try {
        showLoading();
        const response = await fetch(url, { method, body: formData });
        
        if (response.ok) {
            alert(id ? 'Brinquedo atualizado com sucesso!' : 'Brinquedo criado com sucesso!');
            location.reload();
        } else {
            const error = await response.json();
            alert(error.error || 'Erro ao salvar');
        }
        hideLoading();
    } catch (error) {
        hideLoading();
        alert('Erro ao salvar');
    }
});

async function excluirBrinquedo(id) {
    if (confirm('Tem certeza que deseja excluir este brinquedo? Todas as imagens serão removidas.')) {
        try {
            showLoading();
            const response = await fetch(`/admin/brinquedos/${id}`, { method: 'DELETE' });
            if (response.ok) {
                alert('Brinquedo excluído!');
                location.reload();
            } else {
                alert('Erro ao excluir');
            }
            hideLoading();
        } catch (error) {
            hideLoading();
            alert('Erro ao excluir');
        }
    }
}

window.onclick = function(event) {
    if (event.target === modal) {
        modal.style.display = 'none';
    }
}
</script>

<%- include('../partials/admin-footer') %>