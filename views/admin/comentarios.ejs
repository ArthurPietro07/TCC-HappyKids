<%- include('../partials/admin-header') %>

<h1 class="text-3xl font-bold mb-6">Gerenciar Comentários</h1>

<div class="space-y-4">
    <% comentarios.forEach(comentario => { %>
        <div class="bg-white rounded-lg shadow-md p-6">
            <div class="flex justify-between items-start mb-4">
                <div>
                    <div class="flex items-center gap-2 mb-2">
                        <h3 class="font-bold text-lg"><%= comentario.usuario_id.nome %></h3>
                        <div class="flex">
                            <% for(let i = 1; i <= 5; i++) { %>
                                <span class="text-<%= i <= comentario.estrelas ? 'yellow-400' : 'gray-300' %>">★</span>
                            <% } %>
                        </div>
                    </div>
                    <p class="text-sm text-gray-500"><%= moment(comentario.data).format('DD/MM/YYYY HH:mm') %></p>
                </div>
                <button onclick="excluirComentario('<%= comentario._id %>')" class="bg-red-500 text-white px-3 py-1 rounded hover:bg-red-600">
                    Excluir
                </button>
            </div>
            <div class="border-t pt-4">
                <p class="text-gray-700 mb-2"><%= comentario.texto %></p>
                <p class="text-sm text-blue-600">Brinquedo: <%= comentario.brinquedo_id.nome %></p>
            </div>
        </div>
    <% }) %>
    
    <% if (comentarios.length === 0) { %>
        <div class="bg-white rounded-lg shadow-md p-8 text-center">
            <p class="text-gray-600">Nenhum comentário encontrado</p>
        </div>
    <% } %>
</div>

<script>
async function excluirComentario(id) {
    if (confirm('Excluir este comentário permanentemente?')) {
        showLoading();
        try {
            const response = await fetch(`/admin/comentarios/${id}`, { method: 'DELETE' });
            const data = await response.json();
            if (data.success) {
                alert('Comentário excluído!');
                location.reload();
            } else { alert('Erro ao excluir comentário'); }
        } catch (error) { alert('Erro ao excluir comentário'); }
        finally { hideLoading(); }
    }
}
</script>

<%- include('../partials/admin-footer') %>