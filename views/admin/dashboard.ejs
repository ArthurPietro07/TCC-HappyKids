<%- include('../partials/admin-header.ejs') %>

    <div class="mb-8">
        <h1 class="text-3xl font-bold">Dashboard</h1>
        <p class="text-gray-600">Bem-vindo, <%= usuario.nome %>!</p>
    </div>

    <!-- Cards -->
    <div class="grid md:grid-cols-4 gap-6 mb-8">
        <div class="bg-white rounded-lg shadow-lg p-6">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-gray-500">Total de Aluguéis</p>
                    <p class="text-3xl font-bold">
                        <%= totalAlugueis || 0 %>
                    </p>
                </div>
                <i class="ri-shopping-cart-line text-4xl text-blue-500"></i>
            </div>
        </div>

        <div class="bg-white rounded-lg shadow-lg p-6">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-gray-500">Aluguéis Ativos</p>
                    <p class="text-3xl font-bold">
                        <%= alugueisAtivos || 0 %>
                    </p>
                </div>
                <i class="ri-checkbox-circle-line text-4xl text-green-500"></i>
            </div>
        </div>

        <div class="bg-white rounded-lg shadow-lg p-6">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-gray-500">Total de Brinquedos</p>
                    <p class="text-3xl font-bold">
                        <%= totalBrinquedos || 0 %>
                    </p>
                </div>
                <i class="ri-toy-line text-4xl text-yellow-500"></i>
            </div>
        </div>

        <div class="bg-white rounded-lg shadow-lg p-6">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-gray-500">Faturamento Mês</p>
                    <p class="text-3xl font-bold">R$ <%= faturamentoMes || 0 %>
                    </p>
                </div>
                <i class="ri-money-dollar-circle-line text-4xl text-purple-500"></i>
            </div>
        </div>
    </div>

    <!-- Últimos Aluguéis -->
    <div class="bg-white rounded-lg shadow-lg p-6">
        <h2 class="text-xl font-bold mb-4">Últimos Aluguéis</h2>
        <div class="overflow-x-auto">
            <table class="w-full">
                <thead class="bg-gray-50">
                    <tr>
                        <th class="p-3 text-left">ID</th>
                        <th class="p-3 text-left">Cliente</th>
                        <th class="p-3 text-left">Data</th>
                        <th class="p-3 text-left">Valor</th>
                        <th class="p-3 text-left">Status</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (ultimosAlugueis && ultimosAlugueis.length> 0) { %>
                        <% ultimosAlugueis.forEach(aluguel=> { %>
                            <tr class="border-b">
                                <td class="p-3">#<%= aluguel.id %>
                                </td>
                                <td class="p-3">
                                    <%= aluguel.usuario_nome %>
                                </td>
                                <td class="p-3">
                                    <%= new Date(aluguel.data_pedido).toLocaleDateString() %>
                                </td>
                                <td class="p-3">R$ <%= aluguel.valor_total %>
                                </td>
                                <td class="p-3">
                                    <span
                                        class="px-2 py-1 rounded text-sm 
                                    <%= aluguel.status === 'ativo' ? 'bg-green-100 text-green-800' : 'bg-yellow-100 text-yellow-800' %>">
                                        <%= aluguel.status %>
                                    </span>
                                </td>
                            </tr>
                            <% }) %>
                                <% } else { %>
                                    <tr>
                                        <td colspan="5" class="text-center p-4">Nenhum aluguel encontrado</td>
                                    </tr>
                                    <% } %>
                </tbody>
            </table>
        </div>
    </div>

