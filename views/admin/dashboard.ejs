<%- include('../partials/admin-header') %>

<h1 class="text-3xl font-bold mb-6">Dashboard</h1>

<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
    <div class="bg-white rounded-lg shadow-md p-6">
        <div class="text-3xl mb-2">📊</div>
        <div class="text-2xl font-bold"><%= totalAlugueis %></div>
        <div class="text-gray-600">Total de Aluguéis</div>
    </div>
    
    <div class="bg-white rounded-lg shadow-md p-6">
        <div class="text-3xl mb-2">✅</div>
        <div class="text-2xl font-bold"><%= alugueisAtivos %></div>
        <div class="text-gray-600">Aluguéis Ativos</div>
    </div>
    
    <div class="bg-white rounded-lg shadow-md p-6">
        <div class="text-3xl mb-2">🎈</div>
        <div class="text-2xl font-bold"><%= totalBrinquedos %></div>
        <div class="text-gray-600">Brinquedos</div>
    </div>
    
    <div class="bg-white rounded-lg shadow-md p-6">
        <div class="text-3xl mb-2">💰</div>
        <div class="text-2xl font-bold text-green-600">R$ <%= faturamentoMes.toFixed(2) %></div>
        <div class="text-gray-600">Faturamento do Mês</div>
    </div>
</div>

<div class="bg-white rounded-lg shadow-md p-6">
    <h2 class="text-xl font-bold mb-4">Ações Rápidas</h2>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        <a href="/admin/brinquedos" class="bg-blue-600 text-white text-center py-3 rounded hover:bg-blue-700 transition">
            Gerenciar Brinquedos
        </a>
        <a href="/admin/alugueis" class="bg-green-600 text-white text-center py-3 rounded hover:bg-green-700 transition">
            Gerenciar Aluguéis
        </a>
        <a href="/admin/calendario?mes=<%= moment().format('MM') %>&ano=<%= moment().format('YYYY') %>" class="bg-purple-600 text-white text-center py-3 rounded hover:bg-purple-700 transition">
            Ver Calendário
        </a>
    </div>
</div>

<%- include('../partials/admin-footer') %>