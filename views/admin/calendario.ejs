<%- include('../partials/admin-header') %>

<div class="mb-8 animate-fade-in">
    <h1 class="text-3xl md:text-4xl font-bold text-gray-900 mb-2">Calendário de Ocupação</h1>
    <p class="text-gray-600">Visualize a ocupação dos brinquedos por dia</p>
</div>

<div class="flex flex-col md:flex-row justify-between items-center mb-6 gap-3">
    <a href="?mes=<%= mes-1 %>&ano=<%= mes === 1 ? ano-1 : ano %>" class="w-full md:w-auto bg-white text-gray-700 px-4 py-2 rounded-lg hover:bg-gray-50 transition font-medium flex items-center justify-center gap-2 border border-gray-200 text-sm">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path></svg>
        Anterior
    </a>
    <h2 class="text-xl md:text-2xl font-bold text-gray-900 bg-white px-4 md:px-6 py-2 rounded-lg shadow-sm text-center">
        <% 
        const mesesPortugues = ['Janeiro', 'Fevereiro', 'Março', 'Abril', 'Maio', 'Junho', 'Julho', 'Agosto', 'Setembro', 'Outubro', 'Novembro', 'Dezembro'];
        const nomeMes = mesesPortugues[mes-1];
        %>
        <%= nomeMes %> <%= ano %>
    </h2>
    <a href="?mes=<%= mes+1 %>&ano=<%= mes === 12 ? ano+1 : ano %>" class="w-full md:w-auto bg-white text-gray-700 px-4 py-2 rounded-lg hover:bg-gray-50 transition font-medium flex items-center justify-center gap-2 border border-gray-200 text-sm">
        Próximo
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
    </a>
</div>

<div class="bg-white rounded-xl shadow-md p-3 md:p-6 overflow-x-auto">
    <div class="min-w-[600px]">
        <div class="grid grid-cols-7 gap-1 md:gap-3 mb-2 md:mb-3">
            <div class="text-center font-bold p-2 md:p-3 bg-indigo-100 rounded-lg text-indigo-800 text-xs md:text-sm">Dom</div>
            <div class="text-center font-bold p-2 md:p-3 bg-indigo-100 rounded-lg text-indigo-800 text-xs md:text-sm">Seg</div>
            <div class="text-center font-bold p-2 md:p-3 bg-indigo-100 rounded-lg text-indigo-800 text-xs md:text-sm">Ter</div>
            <div class="text-center font-bold p-2 md:p-3 bg-indigo-100 rounded-lg text-indigo-800 text-xs md:text-sm">Qua</div>
            <div class="text-center font-bold p-2 md:p-3 bg-indigo-100 rounded-lg text-indigo-800 text-xs md:text-sm">Qui</div>
            <div class="text-center font-bold p-2 md:p-3 bg-indigo-100 rounded-lg text-indigo-800 text-xs md:text-sm">Sex</div>
            <div class="text-center font-bold p-2 md:p-3 bg-indigo-100 rounded-lg text-indigo-800 text-xs md:text-sm">Sáb</div>
        </div>

        <div class="grid grid-cols-7 gap-1 md:gap-3">
            <% 
            const primeiroDia = new Date(ano, mes-1, 1);
            const ultimoDia = new Date(ano, mes, 0);
            const diasNoMes = ultimoDia.getDate();
            const primeiroDiaSemana = primeiroDia.getDay();
            
            for(let i = 0; i < primeiroDiaSemana; i++) { %>
                <div class="bg-gray-50 rounded-lg p-2 md:p-3 min-h-[70px] md:min-h-[120px]"></div>
            <% } %>
            
            <% for(let dia = 1; dia <= diasNoMes; dia++) { 
                const ocupacoes = ocupacao[dia] || [];
                const hasOcupacao = ocupacoes.length > 0;
            %>
                <div class="bg-white border-2 rounded-lg p-2 md:p-3 min-h-[70px] md:min-h-[120px] hover:shadow-lg transition cursor-pointer <%= hasOcupacao ? 'hover:border-indigo-400 border-indigo-200' : 'border-gray-200' %>" 
                     onclick="mostrarDetalhes(<%= dia %>, <%= JSON.stringify(ocupacoes).replace(/</g, '\\u003c').replace(/>/g, '\\u003e') %>)">
                    <div class="font-bold text-base md:text-xl mb-1 md:mb-3 <%= hasOcupacao ? 'text-indigo-600' : 'text-gray-600' %>">
                        <%= dia %>
                    </div>
                    <% if (hasOcupacao) { %>
                        <div class="text-xs space-y-1">
                            <div class="bg-green-100 text-green-800 rounded px-2 py-1 font-semibold text-center text-xs">
                                <%= ocupacoes.length %> alug.
                            </div>
                            <div class="hidden md:block text-gray-500 text-center text-xs mt-2">
                                Clique para detalhes
                            </div>
                        </div>
                    <% } else { %>
                        <div class="hidden md:block text-gray-400 text-center mt-8 text-sm font-medium">
                            Disponível
                        </div>
                        <div class="md:hidden flex justify-center mt-1">
                            <div class="w-2 h-2 bg-green-400 rounded-full"></div>
                        </div>
                    <% } %>
                </div>
            <% } %>
        </div>
    </div>
</div>

<!-- Modal Detalhes -->
<div id="modalDetalhes" style="display: none; position: fixed; z-index: 1000; left: 0; top: 0; width: 100%; height: 100%; background-color: rgba(0,0,0,0.5); backdrop-filter: blur(4px); overflow-y: auto;">
    <div style="background-color: white; margin: 5% auto; padding: 0; border-radius: 16px; width: 95%; max-width: 800px; max-height: 90vh; overflow-y: auto; box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25);">
        <div style="display: flex; justify-content: space-between; align-items: center; padding: 16px 20px; border-bottom: 2px solid #e5e7eb; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white; border-radius: 16px 16px 0 0;">
            <h2 style="font-size: 18px; font-weight: bold; margin: 0;">
                Dia <span id="diaSelecionado" style="font-size: 22px;"></span>
            </h2>
            <button onclick="fecharModalDetalhes()" style="background: rgba(255,255,255,0.2); border: none; font-size: 20px; cursor: pointer; color: white; width: 36px; height: 36px; border-radius: 50%; display: flex; align-items: center; justify-content: center;">&times;</button>
        </div>
        <div id="detalhesConteudo" style="padding: 16px 20px; display: flex; flex-direction: column; gap: 16px;"></div>
    </div>
</div>

<script>
function mostrarDetalhes(dia, ocupacoes) {
    const modal = document.getElementById('modalDetalhes');
    const diaSelecionado = document.getElementById('diaSelecionado');
    const container = document.getElementById('detalhesConteudo');
    
    if (!modal) return;
    
    diaSelecionado.innerHTML = dia;
    
    if (!ocupacoes || ocupacoes.length === 0) {
        container.innerHTML = '<div style="text-align: center; color: #6b7280; padding: 40px 20px;"><p style="font-size: 16px; font-weight: 500;">Nenhum aluguel neste dia</p></div>';
        modal.style.display = 'block';
        return;
    }
    
    let html = '';
    
    for (let i = 0; i < ocupacoes.length; i++) {
        const ocup = ocupacoes[i];
        
        let itensHtml = '';
        if (ocup.itens && ocup.itens.length > 0) {
            for (let j = 0; j < ocup.itens.length; j++) {
                const item = ocup.itens[j];
                itensHtml += `
                    <div style="display: flex; justify-content: space-between; align-items: center; padding: 10px 0; border-bottom: 1px solid #e5e7eb;">
                        <div style="display: flex; align-items: center; gap: 10px; flex: 1;">
                            <div style="width: 36px; height: 36px; background: #e0e7ff; border-radius: 8px; display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
                                <svg style="width: 18px; height: 18px; color: #6366f1;" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"></path></svg>
                            </div>
                            <div style="font-weight: 600; color: #1f2937; font-size: 14px;">${item.nome || 'Brinquedo não identificado'}</div>
                        </div>
                        <span style="font-weight: bold; background: #dbeafe; padding: 6px 12px; border-radius: 16px; color: #1e40af; font-size: 12px; flex-shrink: 0;">
                            ${item.quantidade || 0} un.
                        </span>
                    </div>
                `;
            }
        } else {
            itensHtml = '<div style="color: #ef4444; padding: 12px; text-align: center; background: #fee2e2; border-radius: 10px; font-size: 14px;">Nenhum brinquedo encontrado</div>';
        }
        
        html += `
            <div style="border: 2px solid #e5e7eb; border-radius: 14px; padding: 16px; background-color: #ffffff;">
                <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 16px; flex-wrap: wrap; gap: 12px;">
                    <div style="flex: 1; min-width: 200px;">
                        <h3 style="font-weight: bold; font-size: 16px; color: #1f2937; margin-bottom: 8px; display: flex; align-items: center; gap: 8px;">
                            <div style="width: 36px; height: 36px; background: #e0e7ff; border-radius: 50%; display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
                                <svg style="width: 18px; height: 18px; color: #6366f1;" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path></svg>
                            </div>
                            ${ocup.cliente || 'Cliente não informado'}
                        </h3>
                        <p style="font-size: 13px; color: #6b7280; display: flex; align-items: center; gap: 6px;">
                            <svg style="width: 14px; height: 14px; flex-shrink: 0;" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path></svg>
                            ${ocup.telefone || 'Telefone não informado'}
                        </p>
                    </div>
                    <div style="text-align: right;">
                        <span style="display: inline-block; padding: 6px 12px; font-size: 11px; font-weight: 600; border-radius: 16px; ${ocup.status === 'pago' ? 'background-color: #d1fae5; color: #065f46;' : 'background-color: #dbeafe; color: #1e40af;'}">
                            ${ocup.status === 'pago' ? 'Pago' : (ocup.status === 'ativo' ? 'Ativo' : ocup.status)}
                        </span>
                        <p style="font-weight: bold; font-size: 20px; color: #059669; margin-top: 8px;">
                            R$ ${typeof ocup.total === 'number' ? ocup.total.toFixed(2) : parseFloat(ocup.total || 0).toFixed(2)}
                        </p>
                    </div>
                </div>
                
                <div style="margin-bottom: 16px; padding: 12px; background-color: #f9fafb; border-radius: 10px;">
                    <div style="display: flex; align-items: center; gap: 10px; margin-bottom: 8px;">
                        <div style="width: 28px; height: 28px; background: #e0e7ff; border-radius: 6px; display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
                            <svg style="width: 14px; height: 14px; color: #6366f1;" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                        </div>
                        <span style="font-weight: 600; color: #374151; font-size: 13px;">Horário:</span>
                        <span style="color: #6b7280; margin-left: auto; font-size: 13px;">${ocup.horario || 'Não informado'}</span>
                    </div>
                    <div style="display: flex; align-items: center; gap: 10px;">
                        <div style="width: 28px; height: 28px; background: #e0e7ff; border-radius: 6px; display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
                            <svg style="width: 14px; height: 14px; color: #6366f1;" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
                        </div>
                        <span style="font-weight: 600; color: #374151; font-size: 13px;">Endereço:</span>
                        <span style="color: #6b7280; margin-left: auto; word-break: break-word; text-align: right; font-size: 13px;">${ocup.endereco || 'Não informado'}</span>
                    </div>
                </div>
                
                <div style="border-top: 2px solid #e5e7eb; padding-top: 14px;">
                    <p style="font-weight: 600; color: #374151; margin-bottom: 12px; font-size: 15px; display: flex; align-items: center; gap: 8px;">
                        <div style="width: 28px; height: 28px; background: #e0e7ff; border-radius: 6px; display: flex; align-items: center; justify-content: center;">
                            <svg style="width: 14px; height: 14px; color: #6366f1;" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"></path></svg>
                        </div>
                        Brinquedos
                        <span style="font-size: 11px; background: #e5e7eb; padding: 3px 10px; border-radius: 16px; margin-left: 8px;">${ocup.itens ? ocup.itens.length : 0}</span>
                    </p>
                    <div>${itensHtml}</div>
                </div>
            </div>
        `;
    }
    
    container.innerHTML = html;
    modal.style.display = 'block';
}

function fecharModalDetalhes() {
    const modal = document.getElementById('modalDetalhes');
    if (modal) modal.style.display = 'none';
}

window.onclick = function(event) {
    const modal = document.getElementById('modalDetalhes');
    if (event.target === modal) modal.style.display = 'none';
}
</script>

<%- include('../partials/admin-footer') %>