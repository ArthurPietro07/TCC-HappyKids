<%- include('../partials/admin-header.ejs') %>
<div class="max-w-7xl mx-auto px-4 py-8 fade-in">
  <h1 class="text-3xl font-bold text-slate-800 mb-2">📅 Calendário de Ocupação</h1>
  <p class="text-slate-500 mb-6">Visualize a disponibilidade dos brinquedos</p>
  <div class="mb-6"><label class="block text-slate-700 mb-2 font-medium">🎮 Selecione o Brinquedo:</label><select id="selectBrinquedo" class="w-full md:w-64 p-3 bg-white border border-slate-200 rounded-xl shadow-sm"><option value="todos">📋 Todos os brinquedos</option><% if (brinquedos && brinquedos.length > 0) { %><% brinquedos.forEach(brinquedo => { %><option value="<%= brinquedo._id %>">🎮 <%= brinquedo.nome %></option><% }) %><% } %></select></div>
  <div class="bg-white rounded-2xl shadow-sm border border-slate-100 p-6 overflow-x-auto">
    <div id="calendarioContainer"><div class="text-center py-8"><div class="inline-block animate-spin rounded-full h-8 w-8 border-2 border-blue-600 border-t-transparent"></div><p class="mt-2 text-slate-500">Carregando calendário...</p></div></div>
  </div>
</div>
<script>
let ocupacoesData = [];
let dataAtual = new Date();
let anoAtual = dataAtual.getFullYear();
let mesAtual = dataAtual.getMonth();
document.getElementById('selectBrinquedo').addEventListener('change', carregarOcupacoes);
async function carregarOcupacoes() {
const brinquedoId = document.getElementById('selectBrinquedo').value;
try {
const response = await fetch(`/admin/calendario/ocupacoes?brinquedo_id=${brinquedoId}`);
ocupacoesData = await response.json();
renderizarCalendario();
} catch (error) {
console.error('Erro ao carregar ocupações:', error);
document.getElementById('calendarioContainer').innerHTML = '<p class="text-red-500 text-center">❌ Erro ao carregar calendário</p>';
}
}
function renderizarCalendario() {
const primeiroDia = new Date(anoAtual, mesAtual, 1);
const ultimoDia = new Date(anoAtual, mesAtual + 1, 0);
const diaInicioSemana = primeiroDia.getDay();
const nomesMeses = ['Janeiro', 'Fevereiro', 'Março', 'Abril', 'Maio', 'Junho', 'Julho', 'Agosto', 'Setembro', 'Outubro', 'Novembro', 'Dezembro'];
let html = `
<div class="flex justify-between items-center mb-6">
<button onclick="mudarMes(-1)" class="bg-slate-100 hover:bg-slate-200 px-4 py-2 rounded-xl transition font-medium">◀ Mês Anterior</button>
<h2 class="text-2xl font-bold text-slate-800">${nomesMeses[mesAtual]} ${anoAtual}</h2>
<button onclick="mudarMes(1)" class="bg-slate-100 hover:bg-slate-200 px-4 py-2 rounded-xl transition font-medium">Próximo Mês ▶</button>
</div>
<div class="grid grid-cols-7 gap-2 mb-2 text-center font-bold text-slate-500"><div>DOM</div><div>SEG</div><div>TER</div><div>QUA</div><div>QUI</div><div>SEX</div><div>SÁB</div></div>
<div class="grid grid-cols-7 gap-2">`;
for (let i = 0; i < diaInicioSemana; i++) { html += `<div class="bg-slate-50 rounded-xl p-2 min-h-[100px]"></div>`; }
const hoje = new Date(); hoje.setHours(0,0,0,0);
for (let d = 1; d <= ultimoDia.getDate(); d++) {
const dataObj = new Date(anoAtual, mesAtual, d);
const dataStr = `${anoAtual}-${String(mesAtual + 1).padStart(2, '0')}-${String(d).padStart(2, '0')}`;
const isHoje = dataObj.toDateString() === hoje.toDateString();
const ocupacao = ocupacoesData.find(o => o.data === dataStr);
const quantidade = ocupacao ? ocupacao.quantidade : 0;
let bgColor = 'bg-white'; let textColor = 'text-slate-800';
if (isHoje) { bgColor = 'bg-blue-100'; textColor = 'text-blue-800'; } else if (quantidade === 0) { bgColor = 'bg-emerald-50'; } else { bgColor = 'bg-amber-50'; }
html += `<div class="${bgColor} rounded-xl p-2 min-h-[100px] border ${isHoje ? 'border-blue-400 border-2' : 'border-slate-100'}"><div class="font-bold ${textColor}">${d}</div>`;
if (quantidade === 0) { html += `<div class="text-emerald-600 text-xs mt-2 text-center font-medium">✅ Disponível</div>`; } else { html += `<div class="text-amber-600 text-xs mt-2 text-center font-medium">📦 ${quantidade} ${quantidade===1?'aluguel':'aluguéis'}</div>`; }
html += `</div>`; }
html += `</div>`;
document.getElementById('calendarioContainer').innerHTML = html;
}
function mudarMes(delta) { const novaData = new Date(anoAtual, mesAtual + delta, 1); anoAtual = novaData.getFullYear(); mesAtual = novaData.getMonth(); carregarOcupacoes(); }
document.addEventListener('DOMContentLoaded', () => { carregarOcupacoes(); });
</script>
<%- include('../partials/admin-footer.ejs') %>