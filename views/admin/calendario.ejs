<%- include('../partials/admin-header') %>

<div class="mb-8 animate-fade-in">
    <h1 class="text-4xl font-bold text-gray-900 mb-2">Calendário de Ocupação</h1>
    <p class="text-gray-600">Visualize a ocupação dos brinquedos por dia</p>
</div>

<div class="flex flex-col md:flex-row justify-between items-center mb-8 gap-4">
    <a href="?mes=<%= mes-1 %>&ano=<%= mes === 1 ? ano-1 : ano %>" class="bg-white text-gray-700 px-6 py-3 rounded-xl hover:bg-gray-50 transition font-semibold shadow-md hover:shadow-lg flex items-center gap-2 border border-gray-200">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path></svg>
        Mês Anterior
    </a>
    <h2 class="text-3xl font-bold text-gray-900 bg-white px-8 py-3 rounded-xl shadow-md">
        <% 
        const mesesPortugues = ['Janeiro', 'Fevereiro', 'Março', 'Abril', 'Maio', 'Junho', 'Julho', 'Agosto', 'Setembro', 'Outubro', 'Novembro', 'Dezembro'];
        const nomeMes = mesesPortugues[mes-1];
        %>
        <%= nomeMes %> <%= ano %>
    </h2>
    <a href="?mes=<%= mes+1 %>&ano=<%= mes === 12 ? ano+1 : ano %>" class="bg-white text-gray-700 px-6 py-3 rounded-xl hover:bg-gray-50 transition font-semibold shadow-md hover:shadow-lg flex items-center gap-2 border border-gray-200">
        Próximo Mês
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
    </a>
</div>

<div class="grid grid-cols-7 gap-3 mb-3">
    <div class="text-center font-bold p-3 bg-indigo-100 rounded-xl text-indigo-800 text-sm">Dom</div>
    <div class="text-center font-bold p-3 bg-indigo-100 rounded-xl text-indigo-800 text-sm">Seg</div>
    <div class="text-center font-bold p-3 bg-indigo-100 rounded-xl text-indigo-800 text-sm">Ter</div>
    <div class="text-center font-bold p-3 bg-indigo-100 rounded-xl text-indigo-800 text-sm">Qua</div>
    <div class="text-center font-bold p-3 bg-indigo-100 rounded-xl text-indigo-800 text-sm">Qui</div>
    <div class="text-center font-bold p-3 bg-indigo-100 rounded-xl text-indigo-800 text-sm">Sex</div>
    <div class="text-center font-bold p-3 bg-indigo-100 rounded-xl text-indigo-800 text-sm">Sáb</div>
</div>

<div class="grid grid-cols-7 gap-3">
    <% 
    const primeiroDia = new Date(ano, mes-1, 1);
    const ultimoDia = new Date(ano, mes, 0);
    const diasNoMes = ultimoDia.getDate();
    const primeiroDiaSemana = primeiroDia.getDay();
    
    for(let i = 0; i < primeiroDiaSemana; i++) { %>
        <div class="bg-gray-100 rounded-xl p-3 min-h-[120px]"></div>
    <% } %>
    
    <% for(let dia = 1; dia <= diasNoMes; dia++) { 
        const ocupacoes = ocupacao[dia] || [];
        const hasOcupacao = ocupacoes.length > 0;
    %>
        <div class="bg-white border-2 rounded-xl p-4 min-h-[120px] hover:shadow-lg transition cursor-pointer <%= hasOcupacao ? 'hover:border-indigo-400 border-indigo-200' : 'border-gray-200' %>" 
             onclick="mostrarDetalhes(<%= dia %>, <%= JSON.stringify(ocupacoes).replace(/</g, '\\u003c').replace(/>/g, '\\u003e') %>)">
            <div class="font-bold text-xl mb-3 <%= hasOcupacao ? 'text-indigo-600' : 'text-gray-600' %>">
                <%= dia %>
            </div>
            <% if (hasOcupacao) { %>
                <div class="text-xs space-y-2">
                    <div class="bg-green-100 text-green-800 rounded-lg px-3 py-2 font-semibold text-center">
                        <%= ocupacoes.length %> aluguel(is)
                    </div>
                    <div class="text-gray-500 text-center text-xs mt-2">
                        Clique para detalhes
                    </div>
                </div>
            <% } else { %>
                <div class="text-gray-400 text-center mt-8 text-sm font-medium">
                    Disponível
                </div>
            <% } %>
        </div>
    <% } %>
</div>

<!-- Modal Detalhes -->
<div id="modalDetalhes" style="display: none; position: fixed; z-index: 1000; left: 0; top: 0; width: 100%; height: 100%; background-color: rgba(0,0,0,0.5); backdrop-filter: blur(4px);">
    <div style="background-color: white; margin: 3% auto; padding: 0; border-radius: 20px; width: 90%; max-width: 800px; max-height: 85vh; overflow-y: auto; box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25);">
        <div style="display: flex; justify-content: space-between; align-items: center; padding: 24px; border-bottom: 2px solid #e5e7eb; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white; border-radius: 20px 20px 0 0;">
            <h2 style="font-size: 28px; font-weight: bold; margin: 0;">
                Detalhes do Dia <span id="diaSelecionado" style="font-size: 32px;"></span>
            </h2>
            <button onclick="fecharModalDetalhes()" style="background: rgba(255,255,255,0.2); border: none; font-size: 24px; cursor: pointer; color: white; width: 40px; height: 40px; border-radius: 50%; display: flex; align-items: center; justify-content: center; transition: background 0.2s;">&times;</button>
        </div>
        <div id="detalhesConteudo" style="padding: 24px; display: flex; flex-direction: column; gap: 20px;"></div>
    </div>
</div>

<script>
console.log('Script do calendário carregado');

function mostrarDetalhes(dia, ocupacoes) {
    console.log('=== CLIQUE NO DIA ===');
    console.log('Dia clicado:', dia);
    console.log('Dados recebidos:', ocupacoes);
    
    const modal = document.getElementById('modalDetalhes');
    const diaSelecionado = document.getElementById('diaSelecionado');
    const container = document.getElementById('detalhesConteudo');
    
    if (!modal) {
        console.error('Modal não encontrado!');
        alert('Erro: Modal não encontrado');
        return;
    }
    
    diaSelecionado.innerHTML = dia;
    
    if (!ocupacoes || ocupacoes.length === 0) {
        container.innerHTML = '<div style="text-align: center; color: #6b7280; padding: 60px 20px;"><svg style="width: 80px; height: 80px; margin: 0 auto 20px; color: #d1d5db;" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg><p style="font-size: 18px; font-weight: 500;">Nenhum aluguel neste dia</p></div>';
        modal.style.display = 'block';
        return;
    }
    
    console.log('Número de aluguéis:', ocupacoes.length);
    
    let html = '';
    
    for (let i = 0; i < ocupacoes.length; i++) {
        const ocup = ocupacoes[i];
        console.log(`Aluguel ${i+1}:`, ocup);
        
        let itensHtml = '';
        if (ocup.itens && ocup.itens.length > 0) {
            for (let j = 0; j < ocup.itens.length; j++) {
                const item = ocup.itens[j];
                console.log(`Item ${j+1}:`, item);
                itensHtml += `
                    <div style="display: flex; justify-content: space-between; align-items: center; padding: 12px 0; border-bottom: 1px solid #e5e7eb;">
                        <div style="display: flex; align-items: center; gap: 12px;">
                            <div style="width: 40px; height: 40px; background: #e0e7ff; border-radius: 10px; display: flex; align-items: center; justify-content: center;">
                                <svg style="width: 20px; height: 20px; color: #6366f1;" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"></path></svg>
                            </div>
                            <div>
                                <div style="font-weight: 600; color: #1f2937;">${item.nome || 'Brinquedo não identificado'}</div>
                            </div>
                        </div>
                        <span style="font-weight: bold; background: #dbeafe; padding: 8px 16px; border-radius: 20px; color: #1e40af; font-size: 14px;">
                            ${item.quantidade || 0} unidade(s)
                        </span>
                    </div>
                `;
            }
        } else {
            itensHtml = '<div style="color: #ef4444; padding: 16px; text-align: center; background: #fee2e2; border-radius: 12px; font-weight: 500;">Nenhum brinquedo encontrado neste aluguel</div>';
        }
        
        html += `
            <div style="border: 2px solid #e5e7eb; border-radius: 16px; padding: 24px; background-color: #ffffff; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05);">
                <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 24px; flex-wrap: wrap; gap: 16px;">
                    <div style="flex: 1;">
                        <h3 style="font-weight: bold; font-size: 20px; color: #1f2937; margin-bottom: 12px; display: flex; align-items: center; gap: 10px;">
                            <div style="width: 40px; height: 40px; background: #e0e7ff; border-radius: 50%; display: flex; align-items: center; justify-content: center;">
                                <svg style="width: 20px; height: 20px; color: #6366f1;" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path></svg>
                            </div>
                            ${ocup.cliente || 'Cliente não informado'}
                        </h3>
                        <p style="font-size: 14px; color: #6b7280; display: flex; align-items: center; gap: 8px; margin-bottom: 6px;">
                            <svg style="width: 16px; height: 16px;" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path></svg>
                            ${ocup.telefone || 'Telefone não informado'}
                        </p>
                    </div>
                    <div style="text-align: right;">
                        <span style="display: inline-block; padding: 8px 16px; font-size: 12px; font-weight: 600; border-radius: 20px; ${ocup.status === 'pago' ? 'background-color: #d1fae5; color: #065f46;' : 'background-color: #dbeafe; color: #1e40af;'}">
                            ${ocup.status === 'pago' ? 'Pagamento Confirmado' : (ocup.status === 'ativo' ? 'Aluguel Ativo' : ocup.status)}
                        </span>
                        <p style="font-weight: bold; font-size: 24px; color: #059669; margin-top: 12px;">
                            R$ ${typeof ocup.total === 'number' ? ocup.total.toFixed(2) : parseFloat(ocup.total || 0).toFixed(2)}
                        </p>
                    </div>
                </div>
                
                <div style="margin-bottom: 24px; padding: 16px; background-color: #f9fafb; border-radius: 12px;">
                    <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 12px;">
                        <div style="width: 32px; height: 32px; background: #e0e7ff; border-radius: 8px; display: flex; align-items: center; justify-content: center;">
                            <svg style="width: 16px; height: 16px; color: #6366f1;" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                        </div>
                        <span style="font-weight: 600; color: #374151;">Horário de entrega:</span>
                        <span style="color: #6b7280; margin-left: auto;">${ocup.horario || 'Não informado'}</span>
                    </div>
                    <div style="display: flex; align-items: center; gap: 12px;">
                        <div style="width: 32px; height: 32px; background: #e0e7ff; border-radius: 8px; display: flex; align-items: center; justify-content: center;">
                            <svg style="width: 16px; height: 16px; color: #6366f1;" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
                        </div>
                        <span style="font-weight: 600; color: #374151;">Endereço:</span>
                        <span style="color: #6b7280; margin-left: auto; word-break: break-word; text-align: right; max-width: 60%;">${ocup.endereco || 'Endereço não informado'}</span>
                    </div>
                </div>
                
                <div style="border-top: 2px solid #e5e7eb; padding-top: 20px; margin-top: 8px;">
                    <p style="font-weight: 600; color: #374151; margin-bottom: 20px; font-size: 18px; display: flex; align-items: center; gap: 10px;">
                        <div style="width: 32px; height: 32px; background: #e0e7ff; border-radius: 8px; display: flex; align-items: center; justify-content: center;">
                            <svg style="width: 16px; height: 16px; color: #6366f1;" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"></path></svg>
                        </div>
                        Brinquedos Alugados
                        <span style="font-size: 12px; background: #e5e7eb; padding: 4px 12px; border-radius: 20px; margin-left: 8px;">${ocup.itens ? ocup.itens.length : 0} item(ns)</span>
                    </p>
                    <div style="padding-left: 8px;">
                        ${itensHtml}
                    </div>
                </div>
            </div>
        `;
    }
    
    container.innerHTML = html;
    modal.style.display = 'block';
    console.log('Modal aberto com sucesso');
}

function fecharModalDetalhes() {
    const modal = document.getElementById('modalDetalhes');
    if (modal) {
        modal.style.display = 'none';
        console.log('Modal fechado');
    }
}

window.onclick = function(event) {
    const modal = document.getElementById('modalDetalhes');
    if (event.target === modal) {
        modal.style.display = 'none';
    }
}

document.addEventListener('DOMContentLoaded', function() {
    console.log('DOM carregado, verificando elementos do calendário...');
    const dias = document.querySelectorAll('[onclick^="mostrarDetalhes"]');
    console.log('Dias com evento de clique:', dias.length);
});
</script>

<style>
#modalDetalhes > div::-webkit-scrollbar {
    width: 8px;
}
#modalDetalhes > div::-webkit-scrollbar-track {
    background: #f1f1f1;
    border-radius: 4px;
}
#modalDetalhes > div::-webkit-scrollbar-thumb {
    background: #888;
    border-radius: 4px;
}
#modalDetalhes > div::-webkit-scrollbar-thumb:hover {
    background: #555;
}
</style>

<%- include('../partials/admin-footer') %>