<%- include('partials/header') %>

<div class="text-center mb-12">
    <h1 class="text-4xl font-bold text-blue-600 mb-4">Bem-vindo ao HappyKids</h1>
    <p class="text-xl text-gray-600">Sua melhor opção para locação de brinquedos</p>
</div>

<div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-12">
    <div class="bg-white rounded-lg shadow-md p-6 text-center">
        <div class="text-4xl mb-4">🎈</div>
        <h3 class="text-xl font-bold mb-2">Variedade</h3>
        <p class="text-gray-600">Mais de 50 tipos de brinquedos para todas as idades</p>
    </div>
    <div class="bg-white rounded-lg shadow-md p-6 text-center">
        <div class="text-4xl mb-4">💰</div>
        <h3 class="text-xl font-bold mb-2">Preços Justos</h3>
        <p class="text-gray-600">Preços competitivos com desconto semanal</p>
    </div>
    <div class="bg-white rounded-lg shadow-md p-6 text-center">
        <div class="text-4xl mb-4">🚚</div>
        <h3 class="text-xl font-bold mb-2">Entrega Rápida</h3>
        <p class="text-gray-600">Entregamos no horário que você escolher</p>
    </div>
</div>

<h2 class="text-2xl font-bold mb-6">Brinquedos em Destaque</h2>
<div class="grid grid-cols-1 md:grid-cols-3 lg:grid-cols-4 gap-6">
    <% brinquedos.forEach(brinquedo => { %>
        <div class="bg-white rounded-lg shadow-md overflow-hidden hover:shadow-lg transition">
            <img src="<%= brinquedo.imagem_principal %>" alt="<%= brinquedo.nome %>" class="w-full h-48 object-cover">
            <div class="p-4">
                <h3 class="font-bold text-lg mb-2"><%= brinquedo.nome %></h3>
                <p class="text-gray-600 text-sm mb-2"><%= brinquedo.descricao.substring(0, 80) %>...</p>
                <p class="text-blue-600 font-bold">R$ <%= brinquedo.preco_diaria %>/dia</p>
                <a href="/brinquedo/<%= brinquedo._id %>" class="mt-3 inline-block bg-blue-600 text-white px-4 py-2 rounded hover:bg-blue-700 transition">
                    Ver Detalhes
                </a>
            </div>
        </div>
    <% }) %>
</div>

<%- include('partials/footer') %>