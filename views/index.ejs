<%- include('partials/header') %>

<div class="container mx-auto px-4 sm:px-6 py-6 sm:py-8">
    <!-- Hero Section -->
    <div class="text-center mb-8 sm:mb-12">
        <h1 class="text-3xl sm:text-4xl md:text-5xl font-bold text-indigo-600 mb-3 sm:mb-4">Bem-vindo ao HappyKids</h1>
        <p class="text-base sm:text-lg md:text-xl text-gray-600 max-w-2xl mx-auto px-4">Sua melhor opção para locação de brinquedos</p>
    </div>

    <!-- Cards de Vantagens com SVGs -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 md:gap-6 mb-10 sm:mb-12">
        <div class="bg-white rounded-xl shadow-md p-4 sm:p-6 text-center hover:shadow-lg transition group">
            <div class="flex justify-center mb-3">
                <svg class="w-12 h-12 sm:w-14 sm:h-14 text-indigo-500 group-hover:scale-110 transition duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path>
                </svg>
            </div>
            <h3 class="text-lg sm:text-xl font-bold text-gray-800 mb-2">Variedade</h3>
            <p class="text-sm sm:text-base text-gray-600">Mais de 50 tipos de brinquedos para todas as idades</p>
        </div>
        
        <div class="bg-white rounded-xl shadow-md p-4 sm:p-6 text-center hover:shadow-lg transition group">
            <div class="flex justify-center mb-3">
                <svg class="w-12 h-12 sm:w-14 sm:h-14 text-green-500 group-hover:scale-110 transition duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
            </div>
            <h3 class="text-lg sm:text-xl font-bold text-gray-800 mb-2">Preços Justos</h3>
            <p class="text-sm sm:text-base text-gray-600">Preços competitivos com desconto especial</p>
        </div>
        
        <div class="bg-white rounded-xl shadow-md p-4 sm:p-6 text-center hover:shadow-lg transition group">
            <div class="flex justify-center mb-3">
                <svg class="w-12 h-12 sm:w-14 sm:h-14 text-blue-500 group-hover:scale-110 transition duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"></path>
                </svg>
            </div>
            <h3 class="text-lg sm:text-xl font-bold text-gray-800 mb-2">Entrega Rápida</h3>
            <p class="text-sm sm:text-base text-gray-600">Entregamos no horário que você escolher</p>
        </div>
    </div>

    <!-- Brinquedos em Destaque -->
    <div class="flex justify-between items-center mb-6">
        <h2 class="text-xl sm:text-2xl font-bold text-gray-900">Brinquedos em Destaque</h2>
        <a href="/catalogo" class="text-indigo-600 hover:text-indigo-700 font-medium text-sm sm:text-base flex items-center gap-1">
            Ver todos
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
        </a>
    </div>
    
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4 md:gap-6">
        <% brinquedos.forEach(brinquedo => { %>
            <div class="bg-white rounded-xl shadow-md overflow-hidden hover:shadow-lg transition group">
                <a href="/brinquedo/<%= brinquedo._id %>" class="block overflow-hidden bg-gray-100">
                    <img src="<%= brinquedo.imagem_principal || brinquedo.imagem_url || '/uploads/default.jpg' %>" alt="<%= brinquedo.nome %>" 
                         class="w-full h-40 sm:h-48 object-cover group-hover:scale-105 transition duration-300">
                </a>
                <div class="p-4">
                    <h3 class="font-bold text-base sm:text-lg text-gray-900 line-clamp-1"><%= brinquedo.nome %></h3>
                    <p class="text-gray-600 text-xs sm:text-sm mt-1 line-clamp-2"><%= brinquedo.descricao.substring(0, 70) %>...</p>
                    <div class="flex justify-between items-center mt-3 pt-2 border-t border-gray-100">
                        <div>
                            <span class="text-indigo-600 font-bold text-base sm:text-lg">R$ <%= brinquedo.preco_diaria %></span>
                            <span class="text-gray-500 text-xs">/dia</span>
                        </div>
                        <span class="text-xs font-semibold px-2 py-1 rounded-full <%= brinquedo.quantidade_estoque > 0 ? 'bg-green-100 text-green-700' : 'bg-red-100 text-red-700' %>">
                            <%= brinquedo.quantidade_estoque > 0 ? `${brinquedo.quantidade_estoque} unid.` : 'Indisponível' %>
                        </span>
                    </div>
                    <a href="/brinquedo/<%= brinquedo._id %>" class="block w-full mt-3 bg-indigo-600 text-white text-center px-3 py-2 rounded-lg hover:bg-indigo-700 transition font-medium text-sm">
                        Ver Detalhes
                    </a>
                </div>
            </div>
        <% }) %>
    </div>
    
    <!-- Caso não tenha brinquedos -->
    <% if (brinquedos.length === 0) { %>
        <div class="text-center py-12 bg-gray-50 rounded-2xl">
            <svg class="w-16 h-16 text-gray-400 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
            <p class="text-gray-500 text-lg">Nenhum brinquedo em destaque no momento</p>
            <a href="/catalogo" class="inline-block mt-4 text-indigo-600 hover:text-indigo-700 font-medium">Ver catálogo completo</a>
        </div>
    <% } %>
</div>

<style>
.line-clamp-1 {
    display: -webkit-box;
    -webkit-line-clamp: 1;
    -webkit-box-orient: vertical;
    overflow: hidden;
}
.line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
}
</style>

<%- include('partials/footer') %>