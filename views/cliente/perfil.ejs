<%- include('../partials/header') %>

<div class="max-w-2xl mx-auto">
    <div class="bg-white rounded-2xl shadow-lg overflow-hidden">
        <div class="bg-indigo-600 px-6 py-8 text-white">
            <div class="flex items-center gap-6">
                <div class="relative group">
                    <div class="w-24 h-24 bg-white rounded-full flex items-center justify-center shadow-lg overflow-hidden">
                        <% if (usuario.avatar && usuario.avatar !== '') { %>
                            <img src="<%= usuario.avatar %>" alt="<%= usuario.nome %>" class="w-full h-full object-cover">
                        <% } else { %>
                            <span class="text-4xl font-bold text-indigo-600"><%= usuario.nome ? usuario.nome.charAt(0).toUpperCase() : 'U' %></span>
                        <% } %>
                    </div>
                </div>
                <div>
                    <h1 class="text-2xl font-bold"><%= usuario.nome || 'Usuário' %></h1>
                    <p class="text-indigo-100"><%= usuario.email || '' %></p>
                    <p class="text-indigo-200 text-sm mt-1">Membro desde <%= usuario.data_cadastro ? formatarData(usuario.data_cadastro) : '-' %></p>
                </div>
            </div>
        </div>
        
        <div class="p-6">
            <h2 class="text-xl font-bold text-gray-900 mb-6">Meus Dados</h2>
            
            <form action="/cliente/perfil" method="POST" enctype="multipart/form-data">
                <div class="mb-5">
                    <label class="block text-gray-700 mb-2 font-medium">Foto de Perfil</label>
                    <div class="flex items-center gap-4">
                        <div class="w-16 h-16 bg-gray-100 rounded-full flex items-center justify-center overflow-hidden">
                            <% if (usuario.avatar && usuario.avatar !== '') { %>
                                <img src="<%= usuario.avatar %>" alt="<%= usuario.nome %>" class="w-full h-full object-cover">
                            <% } else { %>
                                <span class="text-2xl font-bold text-gray-400"><%= usuario.nome ? usuario.nome.charAt(0).toUpperCase() : 'U' %></span>
                            <% } %>
                        </div>
                        <div class="flex-1">
                            <input type="file" name="avatar" accept="image/jpeg,image/png,image/gif,image/webp" class="w-full text-sm file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:text-sm file:font-semibold file:bg-indigo-50 file:text-indigo-700 hover:file:bg-indigo-100">
                            <p class="text-xs text-gray-500 mt-1">Deixe em branco para manter a foto atual. Formatos: JPG, PNG, GIF, WEBP (max 5MB)</p>
                        </div>
                    </div>
                </div>
                
                <div class="mb-5">
                    <label class="block text-gray-700 mb-2 font-medium">Nome Completo</label>
                    <input type="text" name="nome" value="<%= usuario.nome || '' %>" required 
                           class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500">
                </div>
                
                <div class="mb-5">
                    <label class="block text-gray-700 mb-2 font-medium">Email</label>
                    <input type="email" value="<%= usuario.email || '' %>" disabled 
                           class="w-full px-4 py-3 border border-gray-300 rounded-lg bg-gray-50 text-gray-500">
                    <p class="text-xs text-gray-500 mt-1">O email não pode ser alterado</p>
                </div>
                
                <div class="mb-5">
                    <label class="block text-gray-700 mb-2 font-medium">Telefone</label>
                    <input type="tel" name="telefone" id="telefone" value="<%= usuario.telefone || '' %>" required maxlength="15"
                           class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500">
                    <p class="text-xs text-gray-500 mt-1">Formato: (00) 00000-0000</p>
                </div>
                
                <button type="submit" class="w-full bg-indigo-600 text-white py-3 rounded-lg hover:bg-indigo-700 transition font-semibold">
                    Atualizar Perfil
                </button>
            </form>
        </div>
    </div>
</div>

<script>
document.getElementById('telefone').addEventListener('input', function(e) {
    let value = e.target.value.replace(/\D/g, '');
    if (value.length > 11) value = value.slice(0, 11);
    
    if (value.length > 10) {
        value = value.replace(/^(\d{2})(\d{5})(\d{4})$/, '($1) $2-$3');
    } else if (value.length > 6) {
        value = value.replace(/^(\d{2})(\d{4})(\d{0,4})$/, '($1) $2-$3');
    } else if (value.length > 2) {
        value = value.replace(/^(\d{2})(\d{0,5})/, '($1) $2');
    } else if (value.length > 0) {
        value = value.replace(/^(\d*)/, '($1');
    }
    
    e.target.value = value;
});
</script>

<%- include('../partials/footer') %>