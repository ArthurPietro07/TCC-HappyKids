<%- include('../partials/header.ejs') %>

<section class="max-w-7xl mx-auto px-4 py-8">
    <h1 class="text-3xl font-bold mb-8">Meus Aluguéis</h1>
    
    <div class="bg-white rounded-lg shadow-lg overflow-hidden">
        <table class="w-full">
            <thead class="bg-gray-800 text-white">
                <tr>
                    <th class="p-3 text-left">Pedido #</th>
                    <th class="p-3 text-left">Data</th>
                    <th class="p-3 text-left">Período</th>
                    <th class="p-3 text-left">Valor</th>
                    <th class="p-3 text-left">Status</th>
                    <th class="p-3 text-left">Ações</th>
                </tr>
            </thead>
            <tbody>
                <% if (alugueis && alugueis.length > 0) { %>
                    <% alugueis.forEach(aluguel => { %>
                        <tr class="border-b hover:bg-gray-50">
                            <td class="p-3">#<%= aluguel.id %></td>
                            <td class="p-3"><%= new Date(aluguel.data_pedido).toLocaleDateString() %></td>
                            <td class="p-3"><%= new Date(aluguel.data_inicio).toLocaleDateString() %> até <%= new Date(aluguel.data_fim).toLocaleDateString() %></td>
                            <td class="p-3 font-bold">R$ <%= aluguel.valor_total %></td>
                            <td class="p-3">
                                <% if (aluguel.status === 'reservado') { %>
                                    <span class="bg-yellow-100 text-yellow-800 px-2 py-1 rounded">Reservado</span>
                                <% } else if (aluguel.status === 'ativo') { %>
                                    <span class="bg-green-100 text-green-800 px-2 py-1 rounded">Em Andamento</span>
                                <% } else if (aluguel.status === 'concluido') { %>
                                    <span class="bg-blue-100 text-blue-800 px-2 py-1 rounded">Concluído</span>
                                <% } else { %>
                                    <span class="bg-red-100 text-red-800 px-2 py-1 rounded">Atrasado</span>
                                <% } %>
                            </td>
                            <td class="p-3">
                                <button onclick="verDetalhes(<%= aluguel.id %>)" class="text-blue-600 hover:underline">
                                    Ver Detalhes
                                </button>
                            </td>
                        </tr>
                    <% }) %>
                <% } else { %>
                    <tr>
                        <td colspan="6" class="text-center p-8 text-gray-500">
                            Nenhum aluguel encontrado.
                            <a href="/catalogo" class="text-blue-600 hover:underline block mt-2">Começar a alugar agora</a>
                        </td>
                    </tr>
                <% } %>
            </tbody>
        </table>
    </div>
</section>

<script>
    function verDetalhes(id) {
        alert(`Funcionalidade: Ver detalhes do aluguel #${id}\nImplementar modal ou página específica.`);
    }
</script>

<%- include('../partials/footer.ejs') %>