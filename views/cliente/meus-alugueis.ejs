<%- include('../partials/header') %>

<div class="mb-8 animate-fade-in">
    <h1 class="text-4xl font-bold text-gray-900 mb-2">Meus Aluguéis</h1>
    <p class="text-gray-600">Acompanhe o status dos seus pedidos</p>
</div>

<% if (alugueis.length === 0) { %>
    <div class="bg-white rounded-2xl shadow-md p-16 text-center">
        <svg class="w-24 h-24 text-gray-400 mx-auto mb-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"></path></svg>
        <p class="text-gray-600 text-xl mb-6">Você ainda não realizou nenhum aluguel.</p>
        <a href="/catalogo" class="inline-flex items-center gap-2 bg-indigo-600 text-white px-8 py-3 rounded-xl hover:bg-indigo-700 transition font-semibold shadow-md hover:shadow-lg">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"></path></svg>
            Ver Catálogo
        </a>
    </div>
<% } else { %>
    <div class="space-y-6">
        <% alugueis.forEach(aluguel => { 
            const statusColors = {
                'aguardando_pagamento': 'border-l-yellow-500 bg-yellow-50',
                'pago': 'border-l-blue-500 bg-blue-50',
                'ativo': 'border-l-green-500 bg-green-50',
                'concluido': 'border-l-purple-500 bg-purple-50',
                'cancelado': 'border-l-red-500 bg-red-50'
            };
            const statusBadge = {
                'aguardando_pagamento': 'bg-yellow-100 text-yellow-800',
                'pago': 'bg-blue-100 text-blue-800',
                'ativo': 'bg-green-100 text-green-800',
                'concluido': 'bg-purple-100 text-purple-800',
                'cancelado': 'bg-red-100 text-red-800'
            };
            const statusText = {
                'aguardando_pagamento': 'Aguardando Pagamento',
                'pago': 'Pago',
                'ativo': 'Ativo',
                'concluido': 'Concluído',
                'cancelado': 'Cancelado'
            };
        %>
            <div class="bg-white rounded-2xl shadow-md p-8 border-l-4 <%= statusColors[aluguel.status] %> card-hover">
                <div class="flex flex-col md:flex-row justify-between items-start mb-6 gap-4">
                    <div>
                        <div class="flex items-center gap-3 mb-3">
                            <span class="text-sm text-gray-600 font-medium">Pedido realizado em: <%= moment(aluguel.data_pedido).format('DD/MM/YYYY HH:mm') %></span>
                        </div>
                        <span class="inline-block px-4 py-2 text-sm rounded-full font-semibold <%= statusBadge[aluguel.status] %>">
                            <%= statusText[aluguel.status] %>
                        </span>
                    </div>
                    <div class="text-right">
                        <p class="text-3xl font-bold text-indigo-600">R$ <%= aluguel.valor_total.toFixed(2) %></p>
                        <p class="text-sm text-gray-600 mt-1 font-medium">
                            <%= aluguel.forma_pagamento === 'pix' ? 'PIX' : 'Dinheiro' %>
                        </p>
                    </div>
                </div>
                
                <div class="grid md:grid-cols-2 gap-6 mb-6 p-6 bg-gray-50 rounded-xl">
                    <div class="space-y-3">
                        <div>
                            <p class="text-sm text-gray-600 font-medium mb-1">Período</p>
                            <p class="text-gray-900 font-semibold"><%= moment(aluguel.data_inicio).format('DD/MM/YYYY') %> até <%= moment(aluguel.data_fim).format('DD/MM/YYYY') %></p>
                        </div>
                        <div>
                            <p class="text-sm text-gray-600 font-medium mb-1">Horário de entrega</p>
                            <p class="text-gray-900 font-semibold"><%= aluguel.hora_entrega %></p>
                        </div>
                    </div>
                    <div>
                        <p class="text-sm text-gray-600 font-medium mb-1">Endereço</p>
                        <p class="text-gray-900 font-semibold"><%= aluguel.endereco_entrega %></p>
                    </div>
                </div>
                
                <div class="mb-6">
                    <h4 class="font-semibold text-gray-900 mb-3 text-lg">Itens alugados:</h4>
                    <div class="space-y-2">
                        <% aluguel.itens.forEach(item => { %>
                            <div class="flex justify-between items-center p-4 bg-white rounded-lg border border-gray-200">
                                <div>
                                    <span class="font-semibold text-gray-900"><%= item.nome_brinquedo %></span>
                                    <span class="text-gray-600 ml-2">×<%= item.quantidade %></span>
                                </div>
                                <span class="font-bold text-gray-900">R$ <%= (item.subtotal || item.preco_diaria * item.quantidade).toFixed(2) %></span>
                            </div>
                        <% }) %>
                    </div>
                </div>
                
                <% if (aluguel.status === 'aguardando_pagamento' || aluguel.status === 'pago') { %>
                    <div class="pt-6 border-t border-gray-200">
                        <button onclick="cancelarAluguel('<%= aluguel._id %>')" class="bg-red-500 text-white px-6 py-3 rounded-xl hover:bg-red-600 transition font-semibold shadow-md hover:shadow-lg flex items-center gap-2">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
                            Cancelar Aluguel
                        </button>
                    </div>
                <% } %>
            </div>
        <% }) %>
    </div>
<% } %>

<script>
async function cancelarAluguel(id) {
    if (confirm('Tem certeza que deseja cancelar este aluguel?')) {
        try {
            const data = await fetchAPI(`/cliente/cancelar/${id}`, { method: 'POST' });
            if (data.success) {
                alert('Aluguel cancelado com sucesso!');
                location.reload();
            } else {
                alert('Erro ao cancelar aluguel');
            }
        } catch (error) {
            alert('Erro ao cancelar aluguel');
        }
    }
}
</script>

<%- include('../partials/footer') %>