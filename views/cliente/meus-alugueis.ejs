<%- include('../partials/header') %>

<h1 class="text-3xl font-bold mb-6">Meus Aluguéis</h1>

<% if (alugueis.length === 0) { %>
    <div class="bg-white rounded-lg shadow-md p-8 text-center">
        <p class="text-gray-600">Você ainda não realizou nenhum aluguel.</p>
        <a href="/catalogo" class="mt-4 inline-block bg-blue-600 text-white px-6 py-2 rounded hover:bg-blue-700">Ver Catálogo</a>
    </div>
<% } else { %>
    <div class="space-y-4">
        <% alugueis.forEach(aluguel => { %>
            <div class="bg-white rounded-lg shadow-md p-6">
                <div class="flex justify-between items-start mb-4">
                    <div>
                        <span class="text-sm text-gray-500">Pedido: <%= moment(aluguel.data_pedido).format('DD/MM/YYYY HH:mm') %></span>
                        <div class="mt-1">
                            <span class="inline-block px-2 py-1 text-xs rounded
                                <%= aluguel.status === 'pago' || aluguel.status === 'ativo' ? 'bg-green-100 text-green-800' : '' %>
                                <%= aluguel.status === 'aguardando_pagamento' ? 'bg-yellow-100 text-yellow-800' : '' %>
                                <%= aluguel.status === 'cancelado' ? 'bg-red-100 text-red-800' : '' %>
                                <%= aluguel.status === 'concluido' ? 'bg-blue-100 text-blue-800' : '' %>
                            ">
                                <%= aluguel.status === 'aguardando_pagamento' ? 'Aguardando Pagamento' : 
                                   aluguel.status === 'pago' ? 'Pago' :
                                   aluguel.status === 'ativo' ? 'Ativo' :
                                   aluguel.status === 'concluido' ? 'Concluído' : 'Cancelado' %>
                            </span>
                        </div>
                    </div>
                    <div class="text-right">
                        <p class="text-2xl font-bold text-blue-600">R$ <%= aluguel.valor_total.toFixed(2) %></p>
                        <p class="text-sm text-gray-500"><%= aluguel.forma_pagamento === 'pix' ? 'PIX' : 'Dinheiro' %></p>
                    </div>
                </div>
                
                <div class="border-t pt-4">
                    <p class="text-sm text-gray-600">Período: <%= moment(aluguel.data_inicio).format('DD/MM/YYYY') %> até <%= moment(aluguel.data_fim).format('DD/MM/YYYY') %></p>
                    <p class="text-sm text-gray-600">Horário de entrega: <%= aluguel.hora_entrega %></p>
                    <p class="text-sm text-gray-600">Endereço: <%= aluguel.endereco_entrega %></p>
                </div>
                
                <div class="mt-4">
                    <h4 class="font-semibold mb-2">Itens alugados:</h4>
                    <ul class="space-y-1">
                        <% aluguel.itens.forEach(item => { %>
                            <li class="text-sm text-gray-700">
                                <%= item.quantidade %>x <%= item.nome_brinquedo %> - R$ <%= (item.subtotal || item.preco_diaria * item.quantidade).toFixed(2) %>
                            </li>
                        <% }) %>
                    </ul>
                </div>
                
                <% if (aluguel.status === 'aguardando_pagamento' || aluguel.status === 'pago') { %>
                    <div class="mt-4 pt-4 border-t">
                        <button onclick="cancelarAluguel('<%= aluguel._id %>')" class="bg-red-500 text-white px-4 py-2 rounded hover:bg-red-600 transition">
                            Cancelar Aluguel
                        </button>
                    </div>
                <% } %>
            </div>
        <% }) %>
    </div>
<% } %>

<script>
async function cancelarAluguel(id) {
    if (confirm('Tem certeza que deseja cancelar este aluguel?')) {
        try {
            const data = await fetchAPI(`/cliente/cancelar/${id}`, { method: 'POST' });
            if (data.success) {
                alert('Aluguel cancelado com sucesso!');
                location.reload();
            } else {
                alert('Erro ao cancelar aluguel');
            }
        } catch (error) {
            alert('Erro ao cancelar aluguel');
        }
    }
}
</script>

<%- include('../partials/footer') %>