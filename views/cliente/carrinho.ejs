<%- include('../partials/header') %>

<div class="mb-8 animate-fade-in">
    <h1 class="text-4xl font-bold text-gray-900 mb-2">Meu Carrinho</h1>
    <p class="text-gray-600">Revise seus itens antes de finalizar o pedido</p>
</div>

<div id="carrinhoVazio" class="hidden bg-white rounded-2xl shadow-md p-16 text-center">
    <svg class="w-24 h-24 text-gray-400 mx-auto mb-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z"></path></svg>
    <p class="text-gray-600 text-xl mb-6">Seu carrinho está vazio.</p>
    <a href="/catalogo" class="inline-flex items-center gap-2 bg-indigo-600 text-white px-8 py-3 rounded-xl hover:bg-indigo-700 transition font-semibold shadow-md hover:shadow-lg">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"></path></svg>
        Ver Catálogo
    </a>
</div>

<div id="carrinhoConteudo" class="hidden">
    <div class="grid lg:grid-cols-3 gap-8">
        <!-- Itens do Carrinho -->
        <div class="lg:col-span-2">
            <div class="bg-white rounded-2xl shadow-md p-8 mb-6">
                <h2 class="text-2xl font-bold text-gray-900 mb-6">Itens no Carrinho</h2>
                <div id="itensCarrinho"></div>
            </div>
        </div>
        
        <!-- Resumo e Finalização -->
        <div class="lg:col-span-1">
            <div class="bg-white rounded-2xl shadow-md p-8 sticky top-24">
                <div class="border-b pb-6 mb-6">
                    <div class="flex justify-between items-center mb-2">
                        <span class="text-gray-600 font-medium">Subtotal:</span>
                        <span id="totalCarrinho" class="text-3xl font-bold text-indigo-600">R$ 0,00</span>
                    </div>
                    <p class="text-sm text-gray-500">*O valor final depende do período escolhido</p>
                </div>
                
                <h3 class="text-xl font-bold text-gray-900 mb-6">Finalizar Pedido</h3>
                
                <form id="formFinalizar">
                    <div class="mb-5">
                        <label class="block text-gray-700 mb-2 font-medium">Data de Início</label>
                        <input type="date" id="dataInicio" required class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent transition">
                    </div>
                    
                    <div class="mb-5">
                        <label class="block text-gray-700 mb-2 font-medium">Data de Fim</label>
                        <input type="date" id="dataFim" required class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent transition">
                    </div>
                    
                    <div class="mb-5">
                        <label class="block text-gray-700 mb-2 font-medium">Horário de Entrega</label>
                        <select id="horaEntrega" required class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent transition">
                            <option value="">Selecione</option>
                            <option value="08:00">08:00</option>
                            <option value="09:00">09:00</option>
                            <option value="10:00">10:00</option>
                            <option value="11:00">11:00</option>
                            <option value="12:00">12:00</option>
                            <option value="13:00">13:00</option>
                            <option value="14:00">14:00</option>
                            <option value="15:00">15:00</option>
                            <option value="16:00">16:00</option>
                            <option value="17:00">17:00</option>
                            <option value="18:00">18:00</option>
                            <option value="19:00">19:00</option>
                            <option value="20:00">20:00</option>
                        </select>
                    </div>
                    
                    <div class="mb-5">
                        <label class="block text-gray-700 mb-2 font-medium">Forma de Pagamento</label>
                        <select id="formaPagamento" required class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent transition">
                            <option value="">Selecione</option>
                            <option value="dinheiro">Dinheiro (pago na entrega)</option>
                            <option value="pix">PIX (pago antecipadamente)</option>
                        </select>
                    </div>
                    
                    <div class="mb-6">
                        <label class="block text-gray-700 mb-2 font-medium">Endereço de Entrega</label>
                        <textarea id="endereco" required rows="3" class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent transition" placeholder="Rua, número, bairro, cidade, CEP"></textarea>
                    </div>
                    
                    <button type="submit" class="w-full bg-green-600 text-white py-4 rounded-xl hover:bg-green-700 transition font-semibold shadow-md hover:shadow-lg flex items-center justify-center gap-2">
                        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
                        Confirmar Pedido
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
let carrinhoAtual = [];

function carregarCarrinho() {
    carrinhoAtual = JSON.parse(localStorage.getItem('carrinho') || '[]');
    
    if (carrinhoAtual.length === 0) {
        document.getElementById('carrinhoVazio').classList.remove('hidden');
        document.getElementById('carrinhoConteudo').classList.add('hidden');
    } else {
        document.getElementById('carrinhoVazio').classList.add('hidden');
        document.getElementById('carrinhoConteudo').classList.remove('hidden');
        
        renderizarItens();
    }
}

function renderizarItens() {
    const container = document.getElementById('itensCarrinho');
    let total = 0;
    
    container.innerHTML = carrinhoAtual.map(item => {
        const subtotal = item.quantidade * item.preco_diaria;
        total += subtotal;
        return `
            <div class="flex justify-between items-center py-4 border-b border-gray-200 last:border-b-0">
                <div class="flex-1">
                    <h4 class="font-semibold text-gray-900 text-lg">${item.nome}</h4>
                    <p class="text-sm text-gray-600 mt-1">R$ ${item.preco_diaria.toFixed(2)}/dia × ${item.quantidade}</p>
                </div>
                <div class="text-right">
                    <p class="font-bold text-lg text-gray-900">R$ ${subtotal.toFixed(2)}</p>
                    <button onclick="removerItem('${item.id}')" class="text-red-600 text-sm hover:text-red-700 font-medium mt-2 flex items-center gap-1 ml-auto">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>
                        Remover
                    </button>
                </div>
            </div>
        `;
    }).join('');
    
    document.getElementById('totalCarrinho').innerText = `R$ ${total.toFixed(2)}`;
}

function removerItem(id) {
    carrinhoAtual = carrinhoAtual.filter(item => item.id !== id);
    localStorage.setItem('carrinho', JSON.stringify(carrinhoAtual));
    carregarCarrinho();
}

document.getElementById('formFinalizar').addEventListener('submit', async (e) => {
    e.preventDefault();
    
    const dataInicio = document.getElementById('dataInicio').value;
    const dataFim = document.getElementById('dataFim').value;
    const horaEntrega = document.getElementById('horaEntrega').value;
    const formaPagamento = document.getElementById('formaPagamento').value;
    const endereco = document.getElementById('endereco').value;
    
    if (!dataInicio || !dataFim || !horaEntrega || !formaPagamento || !endereco) {
        alert('Preencha todos os campos');
        return;
    }
    
    const inicio = new Date(dataInicio);
    const fim = new Date(dataFim);
    
    if (inicio > fim) {
        alert('Data de início não pode ser maior que data de fim');
        return;
    }
    
    const dias = Math.ceil((fim - inicio) / (1000 * 60 * 60 * 24)) + 1;
    let total = 0;
    
    carrinhoAtual.forEach(item => {
        total += item.preco_diaria * item.quantidade * dias;
    });
    
    try {
        const data = await fetchAPI('/cliente/finalizar', {
            method: 'POST',
            body: JSON.stringify({
                itens: JSON.stringify(carrinhoAtual),
                data_inicio: dataInicio,
                data_fim: dataFim,
                hora_entrega: horaEntrega,
                forma_pagamento: formaPagamento,
                endereco_entrega: endereco,
                valor_total: total
            })
        });
        
        if (data.success) {
            alert('Pedido realizado com sucesso!');
            localStorage.removeItem('carrinho');
            if (formaPagamento === 'pix') {
                alert('Pagamento via PIX: Chave aleatória gerada. Enviaremos o QR Code por email.');
            }
            window.location.href = '/cliente/meus-alugueis';
        } else {
            alert(data.error || 'Erro ao finalizar pedido');
        }
    } catch (error) {
        alert('Erro ao finalizar pedido');
    }
});

carregarCarrinho();
</script>

<%- include('../partials/footer') %>