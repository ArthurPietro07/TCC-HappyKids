<%- include('../partials/header') %>

<div class="max-w-4xl mx-auto">
    <h1 class="text-3xl font-bold text-gray-900 mb-6">Meu Carrinho</h1>

    <div id="carrinhoVazio" class="hidden bg-white rounded-2xl shadow-md p-12 text-center">
        <svg class="w-20 h-20 text-gray-400 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z"></path>
        </svg>
        <p class="text-gray-500 text-lg">Seu carrinho está vazio.</p>
        <a href="/catalogo" class="mt-4 inline-block bg-indigo-600 text-white px-6 py-3 rounded-lg hover:bg-indigo-700 transition font-semibold">
            Ver Catálogo
        </a>
    </div>

    <div id="carrinhoConteudo" class="hidden">
        <div class="bg-white rounded-2xl shadow-md p-6 mb-6">
            <h2 class="text-xl font-bold text-gray-900 mb-4">Itens do Carrinho</h2>
            <div id="itensCarrinho" class="space-y-3"></div>
            
            <div class="border-t pt-4 mt-4">
                <div class="flex justify-between items-center">
                    <span class="text-lg font-bold text-gray-900">Total:</span>
                    <span id="totalCarrinho" class="text-2xl font-bold text-indigo-600">R$ 0,00</span>
                </div>
            </div>
        </div>
        
        <div class="bg-white rounded-2xl shadow-md p-6">
            <h2 class="text-xl font-bold text-gray-900 mb-4">Finalizar Pedido</h2>
            
            <form id="formFinalizar">
                <div class="mb-5">
                    <label class="block text-gray-700 mb-2 font-medium">Data de Início da Locação</label>
                    <input type="date" id="dataInicio" required 
                           min="<%= new Date().toISOString().split('T')[0] %>"
                           class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500">
                    <p class="text-xs text-gray-500 mt-1">Escolha o dia que deseja receber o brinquedo</p>
                </div>
                
                <div class="mb-5">
                    <label class="block text-gray-700 mb-2 font-medium">Quantidade de Diárias</label>
                    <input type="number" id="quantidadeDias" required min="1" max="30" value="1"
                           class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500">
                    <p class="text-xs text-gray-500 mt-1">Mínimo 1 dia, máximo 30 dias</p>
                </div>
                
                <div class="mb-5 p-4 bg-blue-50 rounded-lg">
                    <div class="flex items-start gap-3">
                        <svg class="w-5 h-5 text-blue-600 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                        </svg>
                        <div class="text-sm">
                            <p class="font-medium text-blue-800">Informações importantes:</p>
                            <p class="text-blue-700">📅 A retirada do brinquedo será feita <strong>1 dia após o término</strong> da sua locação</p>
                            <p class="text-blue-700 mt-1">📦 Exemplo: Se você alugar por 3 dias a partir do dia 10, recolheremos o brinquedo no dia 14</p>
                        </div>
                    </div>
                </div>
                
                <div class="mb-5">
                    <label class="block text-gray-700 mb-2 font-medium">Horário de Entrega</label>
                    <select id="horaEntrega" required class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500">
                        <option value="">Selecione</option>
                        <option value="08:00">08:00</option>
                        <option value="09:00">09:00</option>
                        <option value="10:00">10:00</option>
                        <option value="11:00">11:00</option>
                        <option value="12:00">12:00</option>
                        <option value="13:00">13:00</option>
                        <option value="14:00">14:00</option>
                        <option value="15:00">15:00</option>
                        <option value="16:00">16:00</option>
                        <option value="17:00">17:00</option>
                        <option value="18:00">18:00</option>
                        <option value="19:00">19:00</option>
                        <option value="20:00">20:00</option>
                    </select>
                </div>
                
                <div class="mb-5">
                    <label class="block text-gray-700 mb-2 font-medium">Forma de Pagamento</label>
                    <select id="formaPagamento" required class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500">
                        <option value="">Selecione</option>
                        <option value="dinheiro">Dinheiro (pago na entrega)</option>
                        <option value="pix">PIX (pago antecipadamente)</option>
                    </select>
                </div>
                
                <div class="mb-6">
                    <label class="block text-gray-700 mb-2 font-medium">Endereço de Entrega</label>
                    <textarea id="endereco" required rows="3" class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500" 
                              placeholder="Rua, número, bairro, cidade, CEP"></textarea>
                </div>
                
                <div class="p-4 bg-gray-50 rounded-lg mb-6">
                    <p class="font-semibold text-gray-700">Resumo da Locação:</p>
                    <p class="text-sm text-gray-600 mt-1">📅 Data de início: <span id="resumoDataInicio">-</span></p>
                    <p class="text-sm text-gray-600">⏱️ Duração: <span id="resumoDias">-</span> dia(s)</p>
                    <p class="text-sm text-gray-600">📦 Data de retirada: <span id="resumoDataFim">-</span> (1 dia após o término)</p>
                    <p class="text-sm text-gray-600">💰 Total: R$ <span id="resumoTotal">0,00</span></p>
                </div>
                
                <button type="submit" class="w-full bg-indigo-600 text-white py-3 rounded-lg hover:bg-indigo-700 transition font-semibold shadow-md">
                    Confirmar Pedido
                </button>
            </form>
        </div>
    </div>
</div>

<script>
let carrinhoAtual = [];

function carregarCarrinho() {
    carrinhoAtual = JSON.parse(localStorage.getItem('carrinho') || '[]');
    
    if (carrinhoAtual.length === 0) {
        document.getElementById('carrinhoVazio').classList.remove('hidden');
        document.getElementById('carrinhoConteudo').classList.add('hidden');
    } else {
        document.getElementById('carrinhoVazio').classList.add('hidden');
        document.getElementById('carrinhoConteudo').classList.remove('hidden');
        renderizarItens();
    }
}

function renderizarItens() {
    const container = document.getElementById('itensCarrinho');
    let total = 0;
    
    container.innerHTML = carrinhoAtual.map(item => {
        const subtotal = item.quantidade * item.preco_diaria;
        total += subtotal;
        return `
            <div class="flex justify-between items-center p-4 bg-gray-50 rounded-lg">
                <div class="flex-1">
                    <h4 class="font-semibold text-gray-900">${item.nome}</h4>
                    <p class="text-sm text-gray-600">R$ ${item.preco_diaria.toFixed(2)}/dia x ${item.quantidade} unidade(s)</p>
                </div>
                <div class="text-right">
                    <p class="font-bold text-indigo-600">R$ ${subtotal.toFixed(2)}</p>
                    <button onclick="removerItem('${item.id}')" class="text-red-500 hover:text-red-700 text-sm mt-1">Remover</button>
                </div>
            </div>
        `;
    }).join('');
    
    document.getElementById('totalCarrinho').innerText = `R$ ${total.toFixed(2)}`;
    calcularResumo(total);
}

function removerItem(id) {
    carrinhoAtual = carrinhoAtual.filter(item => item.id !== id);
    localStorage.setItem('carrinho', JSON.stringify(carrinhoAtual));
    carregarCarrinho();
    updateCartCount();
}

function calcularResumo(totalItens) {
    const dataInicio = document.getElementById('dataInicio').value;
    const quantidadeDias = parseInt(document.getElementById('quantidadeDias').value) || 0;
    
    if (dataInicio && quantidadeDias > 0) {
        const inicio = new Date(dataInicio);
        const fim = new Date(inicio);
        fim.setDate(fim.getDate() + quantidadeDias + 1); // +1 dia para retirada
        
        document.getElementById('resumoDataInicio').innerText = inicio.toLocaleDateString('pt-BR');
        document.getElementById('resumoDias').innerText = quantidadeDias;
        document.getElementById('resumoDataFim').innerText = fim.toLocaleDateString('pt-BR');
        
        const totalFinal = totalItens * quantidadeDias;
        document.getElementById('resumoTotal').innerText = totalFinal.toFixed(2);
    }
}

document.getElementById('dataInicio').addEventListener('change', () => calcularResumo(parseFloat(document.getElementById('totalCarrinho').innerText.replace('R$ ', ''))));
document.getElementById('quantidadeDias').addEventListener('input', () => calcularResumo(parseFloat(document.getElementById('totalCarrinho').innerText.replace('R$ ', ''))));

document.getElementById('formFinalizar').addEventListener('submit', async (e) => {
    e.preventDefault();
    
    const dataInicio = document.getElementById('dataInicio').value;
    const quantidadeDias = parseInt(document.getElementById('quantidadeDias').value);
    const horaEntrega = document.getElementById('horaEntrega').value;
    const formaPagamento = document.getElementById('formaPagamento').value;
    const endereco = document.getElementById('endereco').value;
    
    if (!dataInicio || !quantidadeDias || !horaEntrega || !formaPagamento || !endereco) {
        alert('Preencha todos os campos');
        return;
    }
    
    const inicio = new Date(dataInicio);
    const fim = new Date(inicio);
    fim.setDate(fim.getDate() + quantidadeDias); // Término da locação
    
    const total = carrinhoAtual.reduce((sum, item) => sum + (item.preco_diaria * item.quantidade), 0) * quantidadeDias;
    
    try {
        const data = await fetchAPI('/cliente/finalizar', {
            method: 'POST',
            body: JSON.stringify({
                itens: JSON.stringify(carrinhoAtual),
                data_inicio: dataInicio,
                data_fim: fim.toISOString().split('T')[0],
                quantidade_dias: quantidadeDias,
                hora_entrega: horaEntrega,
                forma_pagamento: formaPagamento,
                endereco_entrega: endereco,
                valor_total: total
            })
        });
        
        if (data.success) {
            alert('Pedido realizado com sucesso!');
            localStorage.removeItem('carrinho');
            updateCartCount();
            window.location.href = '/cliente/meus-alugueis';
        } else {
            alert(data.error || 'Erro ao finalizar pedido');
        }
    } catch (error) {
        alert('Erro ao finalizar pedido');
    }
});

carregarCarrinho();
</script>

<%- include('../partials/footer') %>