<%- include('../partials/header') %>

<h1 class="text-3xl font-bold mb-6">Meu Carrinho</h1>

<div id="carrinhoVazio" class="hidden bg-white rounded-lg shadow-md p-8 text-center">
    <p class="text-gray-600">Seu carrinho está vazio.</p>
    <a href="/catalogo" class="mt-4 inline-block bg-blue-600 text-white px-6 py-2 rounded hover:bg-blue-700">Ver Catálogo</a>
</div>

<div id="carrinhoConteudo" class="hidden">
    <div class="bg-white rounded-lg shadow-md p-6 mb-6">
        <div id="itensCarrinho"></div>
        
        <div class="border-t pt-4 mt-4">
            <div class="flex justify-between items-center mb-4">
                <span class="text-xl font-bold">Total:</span>
                <span id="totalCarrinho" class="text-2xl font-bold text-blue-600">R$ 0,00</span>
            </div>
        </div>
    </div>
    
    <div class="bg-white rounded-lg shadow-md p-6">
        <h3 class="text-xl font-bold mb-4">Finalizar Pedido</h3>
        
        <form id="formFinalizar">
            <div class="mb-4">
                <label class="block text-gray-700 mb-2">Data de Início</label>
                <input type="date" id="dataInicio" required class="w-full px-3 py-2 border rounded-lg">
            </div>
            
            <div class="mb-4">
                <label class="block text-gray-700 mb-2">Data de Fim</label>
                <input type="date" id="dataFim" required class="w-full px-3 py-2 border rounded-lg">
            </div>
            
            <div class="mb-4">
                <label class="block text-gray-700 mb-2">Horário de Entrega</label>
                <select id="horaEntrega" required class="w-full px-3 py-2 border rounded-lg">
                    <option value="">Selecione</option>
                    <option value="08:00">08:00</option>
                    <option value="09:00">09:00</option>
                    <option value="10:00">10:00</option>
                    <option value="11:00">11:00</option>
                    <option value="12:00">12:00</option>
                    <option value="13:00">13:00</option>
                    <option value="14:00">14:00</option>
                    <option value="15:00">15:00</option>
                    <option value="16:00">16:00</option>
                    <option value="17:00">17:00</option>
                    <option value="18:00">18:00</option>
                    <option value="19:00">19:00</option>
                    <option value="20:00">20:00</option>
                </select>
            </div>
            
            <div class="mb-4">
                <label class="block text-gray-700 mb-2">Forma de Pagamento</label>
                <select id="formaPagamento" required class="w-full px-3 py-2 border rounded-lg">
                    <option value="">Selecione</option>
                    <option value="dinheiro">Dinheiro (pago na entrega)</option>
                    <option value="pix">PIX (pago antecipadamente)</option>
                </select>
            </div>
            
            <div class="mb-6">
                <label class="block text-gray-700 mb-2">Endereço de Entrega</label>
                <textarea id="endereco" required rows="3" class="w-full px-3 py-2 border rounded-lg" placeholder="Rua, número, bairro, cidade, CEP"></textarea>
            </div>
            
            <button type="submit" class="w-full bg-green-600 text-white py-3 rounded-lg hover:bg-green-700 transition font-semibold">
                Confirmar Pedido
            </button>
        </form>
    </div>
</div>

<script>
let carrinhoAtual = [];

function carregarCarrinho() {
    carrinhoAtual = JSON.parse(localStorage.getItem('carrinho') || '[]');
    
    if (carrinhoAtual.length === 0) {
        document.getElementById('carrinhoVazio').classList.remove('hidden');
        document.getElementById('carrinhoConteudo').classList.add('hidden');
    } else {
        document.getElementById('carrinhoVazio').classList.add('hidden');
        document.getElementById('carrinhoConteudo').classList.remove('hidden');
        
        renderizarItens();
    }
}

function renderizarItens() {
    const container = document.getElementById('itensCarrinho');
    let total = 0;
    
    container.innerHTML = carrinhoAtual.map(item => {
        const subtotal = item.quantidade * item.preco_diaria;
        total += subtotal;
        return `
            <div class="flex justify-between items-center py-3 border-b">
                <div>
                    <h4 class="font-semibold">${item.nome}</h4>
                    <p class="text-sm text-gray-600">R$ ${item.preco_diaria.toFixed(2)}/dia x ${item.quantidade}</p>
                </div>
                <div class="text-right">
                    <p class="font-bold">R$ ${subtotal.toFixed(2)}</p>
                    <button onclick="removerItem('${item.id}')" class="text-red-500 text-sm hover:underline">Remover</button>
                </div>
            </div>
        `;
    }).join('');
    
    document.getElementById('totalCarrinho').innerText = `R$ ${total.toFixed(2)}`;
}

function removerItem(id) {
    carrinhoAtual = carrinhoAtual.filter(item => item.id !== id);
    localStorage.setItem('carrinho', JSON.stringify(carrinhoAtual));
    carregarCarrinho();
}

document.getElementById('formFinalizar').addEventListener('submit', async (e) => {
    e.preventDefault();
    
    const dataInicio = document.getElementById('dataInicio').value;
    const dataFim = document.getElementById('dataFim').value;
    const horaEntrega = document.getElementById('horaEntrega').value;
    const formaPagamento = document.getElementById('formaPagamento').value;
    const endereco = document.getElementById('endereco').value;
    
    if (!dataInicio || !dataFim || !horaEntrega || !formaPagamento || !endereco) {
        alert('Preencha todos os campos');
        return;
    }
    
    const inicio = new Date(dataInicio);
    const fim = new Date(dataFim);
    
    if (inicio > fim) {
        alert('Data de início não pode ser maior que data de fim');
        return;
    }
    
    const dias = Math.ceil((fim - inicio) / (1000 * 60 * 60 * 24)) + 1;
    let total = 0;
    
    carrinhoAtual.forEach(item => {
        total += item.preco_diaria * item.quantidade * dias;
    });
    
    try {
        const data = await fetchAPI('/cliente/finalizar', {
            method: 'POST',
            body: JSON.stringify({
                itens: JSON.stringify(carrinhoAtual),
                data_inicio: dataInicio,
                data_fim: dataFim,
                hora_entrega: horaEntrega,
                forma_pagamento: formaPagamento,
                endereco_entrega: endereco,
                valor_total: total
            })
        });
        
        if (data.success) {
            alert('Pedido realizado com sucesso!');
            localStorage.removeItem('carrinho');
            if (formaPagamento === 'pix') {
                alert('Pagamento via PIX: Chave aleatória gerada. Enviaremos o QR Code por email.');
            }
            window.location.href = '/cliente/meus-alugueis';
        } else {
            alert(data.error || 'Erro ao finalizar pedido');
        }
    } catch (error) {
        alert('Erro ao finalizar pedido');
    }
});

carregarCarrinho();
</script>

<%- include('../partials/footer') %>