<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>HappyKids - Admin</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="/style.css">
    <style>
        .loading { display: none; position: fixed; top: 50%; left: 50%; transform: translate(-50%, -50%); z-index: 1000; }
        .modal { display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.5); z-index: 1001; }
        .modal-content { background: white; margin: 10% auto; padding: 20px; width: 90%; max-width: 500px; border-radius: 8px; }
    </style>
</head>
<body class="bg-gray-100">
    <nav class="bg-gray-900 text-white shadow-lg">
        <div class="container mx-auto px-4">
            <div class="flex justify-between items-center py-4">
                <a href="/admin/dashboard" class="text-2xl font-bold">HappyKids Admin</a>
                <div class="space-x-4">
                    <a href="/admin/dashboard" class="hover:text-gray-300">Dashboard</a>
                    <a href="/admin/brinquedos" class="hover:text-gray-300">Brinquedos</a>
                    <a href="/admin/alugueis" class="hover:text-gray-300">Aluguéis</a>
                    <a href="/admin/calendario?mes=<%= moment().format('MM') %>&ano=<%= moment().format('YYYY') %>" class="hover:text-gray-300">Calendário</a>
                    <a href="/admin/comentarios" class="hover:text-gray-300">Comentários</a>
                    <a href="/" class="hover:text-gray-300">Site</a>
                    <a href="/auth/logout" class="bg-red-500 px-4 py-2 rounded hover:bg-red-600">Sair</a>
                </div>
            </div>
        </div>
    </nav>
    <main class="container mx-auto px-4 py-8">
        <% if (locals.success) { %>
            <div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded mb-4">
                <%= success %>
            </div>
        <% } %>
        <% if (locals.error) { %>
            <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded mb-4">
                <%= error %>
            </div>
        <% } %>