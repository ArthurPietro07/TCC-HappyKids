<!DOCTYPE html>
<html lang="pt-br">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>HappyKids - Admin</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://cdn.jsdelivr.net/npm/remixicon@4.3.0/fonts/remixicon.css" rel="stylesheet">
    <link rel="stylesheet" href="/style.css">
    <style>
        .dropdown-content {
            opacity: 0;
            visibility: hidden;
            transform: translateY(-10px);
            transition: all 0.2s ease;
        }

        .dropdown:hover .dropdown-content {
            opacity: 1;
            visibility: visible;
            transform: translateY(0);
        }
    </style>
</head>

<body class="bg-slate-50 min-h-screen flex flex-col">
    <nav class="bg-slate-900 text-white sticky top-0 z-50 shadow-lg">
        <div class="max-w-7xl mx-auto px-4">
            <div class="flex justify-between items-center py-4">
                <a href="/admin/dashboard" class="text-2xl font-bold text-blue-400 flex items-center gap-2">🎠 HappyKids
                    Admin</a>
                <div class="hidden md:flex items-center space-x-6">
                    <a href="/" class="hover:text-blue-400 transition">🏠 Site</a>
                    <a href="/admin/dashboard" class="hover:text-blue-400 transition">📊 Dashboard</a>
                    <a href="/admin/brinquedos" class="hover:text-blue-400 transition">🎮 Brinquedos</a>
                    <a href="/admin/alugueis" class="hover:text-blue-400 transition">📝 Aluguéis</a>
                    <a href="/admin/calendario" class="hover:text-blue-400 transition">📅 Calendário</a>
                </div>
                <div class="relative dropdown">
                    <button
                        class="flex items-center space-x-2 hover:text-blue-400 transition px-3 py-2 rounded-lg hover:bg-slate-800">
                        <i class="ri-user-line text-xl"></i><span>
                            <%= usuario.nome %>
                        </span><i class="ri-arrow-down-s-line"></i>
                    </button>
                    <div
                        class="dropdown-content absolute right-0 top-full mt-2 w-48 bg-white rounded-xl shadow-lg border border-slate-100 py-2 z-50 text-slate-700">
                        <a href="/" class="block px-4 py-2 hover:bg-slate-50"><i class="ri-store-line mr-2"></i>Ir para
                            o Site</a>
                        <hr class="my-1 border-slate-100">
                        <a href="/logout" class="block px-4 py-2 text-red-600 hover:bg-red-50"><i
                                class="ri-logout-box-line mr-2"></i>Sair</a>
                    </div>
                </div>
            </div>
        </div>
    </nav>
    <main class="flex-grow">