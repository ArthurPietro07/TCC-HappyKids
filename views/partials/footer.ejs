    </main>
    <footer class="bg-gray-800 text-white mt-12 py-8">
        <div class="container mx-auto px-4">
            <div class="flex flex-col md:flex-row justify-between items-center gap-6">
                <div class="flex items-center gap-3">
                    <img src="/uploads/logo-pequena.png" alt="HappyKids" class="w-auto h-10">
                    <div>
                        <p class="text-sm font-semibold">HappyKids</p>
                        <p class="text-xs text-gray-400">Locação de Brinquedos</p>
                    </div>
                </div>
                
                <div class="text-center">
                    <p class="text-sm text-gray-300">© 2024 HappyKids - Locação de Brinquedos</p>
                    <p class="text-xs text-gray-400">Todos os direitos reservados</p>
                </div>
                
                <div class="text-right">
                    <p class="text-sm text-gray-300">contato@happykids.com.br</p>
                    <p class="text-sm text-gray-300">(11) 9999-9999</p>
                </div>
            </div>
        </div>
    </footer>
    <div class="loading">
        <div class="bg-white p-6 rounded-2xl shadow-2xl flex flex-col items-center gap-3">
            <div class="animate-spin rounded-full h-10 w-10 border-4 border-indigo-600 border-t-transparent"></div>
            <p class="text-gray-600 font-medium">Carregando...</p>
        </div>
    </div>
    <script>
        function showLoading() { document.querySelector('.loading').style.display = 'flex'; }
        function hideLoading() { document.querySelector('.loading').style.display = 'none'; }
        
        async function fetchAPI(url, options = {}) {
            showLoading();
            try {
                const response = await fetch(url, { ...options, headers: { 'Content-Type': 'application/json' } });
                const data = await response.json();
                hideLoading();
                return data;
            } catch (error) {
                hideLoading();
                throw error;
            }
        }

        function updateCartCount() {
            const cart = JSON.parse(localStorage.getItem('carrinho') || '[]');
            const count = cart.reduce((sum, item) => sum + item.quantidade, 0);
            const badge = document.getElementById('carrinhoCount');
            if(badge) badge.innerText = count;
        }
        updateCartCount();
        window.addEventListener('storage', updateCartCount);
    </script>
</body>
</html>