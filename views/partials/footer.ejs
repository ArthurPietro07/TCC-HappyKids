    </main>
    <footer class="bg-gray-800 text-white mt-12 py-8">
        <div class="container mx-auto px-4 text-center">
            <p>&copy; 2024 HappyKids - Locação de Brinquedos. Todos os direitos reservados.</p>
        </div>
    </footer>
    <div class="loading">
        <div class="bg-white p-4 rounded shadow-lg">
            <div class="animate-spin rounded-full h-8 w-8 border-b-2 border-blue-600 mx-auto"></div>
        </div>
    </div>
    <script>
        function showLoading() { document.querySelector('.loading').style.display = 'block'; }
        function hideLoading() { document.querySelector('.loading').style.display = 'none'; }
        
        async function fetchAPI(url, options = {}) {
            showLoading();
            try {
                const response = await fetch(url, { ...options, headers: { 'Content-Type': 'application/json' } });
                const data = await response.json();
                hideLoading();
                return data;
            } catch (error) {
                hideLoading();
                throw error;
            }
        }
    </script>
</body>
