<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Happy Kids - Locação de Brinquedos</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://cdn.jsdelivr.net/npm/remixicon@4.3.0/fonts/remixicon.css" rel="stylesheet"/>
    <style>
        .transition-all {
            transition: all 0.3s ease;
        }
        .hover-scale:hover {
            transform: scale(1.02);
        }
    </style>
</head>
<body class="bg-gray-50">
    <!-- Navbar -->
    <nav class="bg-white shadow-lg sticky top-0 z-50">
        <div class="max-w-7xl mx-auto px-4">
            <div class="flex justify-between items-center py-4">
                <!-- Logo -->
                <div class="flex items-center space-x-2">
                    <i class="ri-balloon-fill text-3xl text-yellow-500"></i>
                    <span class="text-2xl font-bold text-blue-600">Happy Kids</span>
                </div>

                <!-- Links Desktop -->
                <div class="hidden md:flex space-x-8">
                    <a href="/" class="text-gray-700 hover:text-blue-600 transition-all">Início</a>
                    <a href="/catalogo" class="text-gray-700 hover:text-blue-600 transition-all">Brinquedos</a>
                    
                    <% if (usuario) { %>
                        <% if (usuario.tipo === 'admin') { %>
                            <a href="/admin/dashboard" class="text-gray-700 hover:text-blue-600 transition-all">Admin</a>
                        <% } else { %>
                            <a href="/cliente/meus-alugueis" class="text-gray-700 hover:text-blue-600 transition-all">Meus Aluguéis</a>
                            <a href="/cliente/carrinho" class="relative">
                                <i class="ri-shopping-cart-line text-2xl text-gray-700 hover:text-blue-600"></i>
                                <span id="carrinhoCount" class="absolute -top-2 -right-3 bg-red-500 text-white text-xs rounded-full w-5 h-5 flex items-center justify-center">0</span>
                            </a>
                        <% } %>
                        <div class="relative group">
                            <button class="flex items-center space-x-2 text-gray-700 hover:text-blue-600">
                                <i class="ri-user-line text-xl"></i>
                                <span><%= usuario.nome %></span>
                            </button>
                            <div class="absolute right-0 mt-2 w-48 bg-white rounded-md shadow-lg hidden group-hover:block">
                                <a href="/perfil" class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100">Perfil</a>
                                <a href="/logout" class="block px-4 py-2 text-sm text-red-600 hover:bg-gray-100">Sair</a>
                            </div>
                        </div>
                    <% } else { %>
                        <a href="/login" class="bg-blue-600 text-white px-4 py-2 rounded-lg hover:bg-blue-700 transition-all">Entrar</a>
                        <a href="/cadastro" class="border-2 border-blue-600 text-blue-600 px-4 py-2 rounded-lg hover:bg-blue-50 transition-all">Cadastrar</a>
                    <% } %>
                </div>

                <!-- Mobile Menu Button -->
                <button id="menuBtn" class="md:hidden text-gray-700">
                    <i class="ri-menu-line text-2xl"></i>
                </button>
            </div>

            <!-- Mobile Menu -->
            <div id="mobileMenu" class="hidden md:hidden pb-4">
                <a href="/" class="block py-2 text-gray-700 hover:text-blue-600">Início</a>
                <a href="/catalogo" class="block py-2 text-gray-700 hover:text-blue-600">Brinquedos</a>
                <% if (usuario) { %>
                    <% if (usuario.tipo === 'admin') { %>
                        <a href="/admin/dashboard" class="block py-2 text-gray-700 hover:text-blue-600">Admin</a>
                    <% } else { %>
                        <a href="/cliente/meus-alugueis" class="block py-2 text-gray-700 hover:text-blue-600">Meus Aluguéis</a>
                    <% } %>
                    <a href="/logout" class="block py-2 text-red-600">Sair</a>
                <% } else { %>
                    <a href="/login" class="block py-2 text-blue-600">Entrar</a>
                    <a href="/cadastro" class="block py-2 text-gray-700">Cadastrar</a>
                <% } %>
            </div>
        </div>
    </nav>

    <main class="min-h-screen"></main>