<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <title>HappyKids - Locação de Brinquedos</title>
    <link rel="icon" type="image/png" href="/uploads/logo-pequena.png">
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/style.css">
    <style>
        * {
            font-family: 'Inter', sans-serif;
        }
        .rating-input { display: inline-flex; flex-direction: row-reverse; gap: 5px; }
        .rating-input input { display: none; }
        .rating-input label { cursor: pointer; font-size: 24px; color: #ddd; transition: color 0.2s; }
        .rating-input input:checked ~ label { color: #ffc107; }
        .rating-input label:hover, .rating-input label:hover ~ label { color: #ffc107; }
        .loading { display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(255,255,255,0.95); backdrop-filter: blur(4px); z-index: 9999; align-items: center; justify-content: center; }
        @keyframes slideDown {
            from { opacity: 0; transform: translateY(-20px); }
            to { opacity: 1; transform: translateY(0); }
        }
        .animate-slide-down { animation: slideDown 0.3s ease-out; }
        .line-clamp-1 {
            display: -webkit-box;
            -webkit-line-clamp: 1;
            -webkit-box-orient: vertical;
            overflow: hidden;
        }
        .line-clamp-2 {
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow: hidden;
        }
        @media (max-width: 640px) {
            .container {
                padding-left: 1rem;
                padding-right: 1rem;
            }
        }
    </style>
</head>
<body class="bg-gray-50">
    <nav class="bg-white border-b border-gray-200 sticky top-0 z-50 shadow-sm">
        <div class="container mx-auto px-4 sm:px-6">
            <div class="flex justify-between items-center py-3 sm:py-4">
                <a href="/" class="flex items-center gap-2 sm:gap-3">
                    <img src="/uploads/logo-grande.png" alt="HappyKids" class="h-12 sm:h-16 md:h-20 w-auto">
                </a>
                
                <!-- Desktop Menu -->
                <div class="hidden md:flex items-center gap-4 lg:gap-6">
                    <a href="/catalogo" class="text-gray-700 hover:text-indigo-600 font-medium transition">Catálogo</a>
                    <% if (user) { %>
                        <% if (user.tipo === 'admin') { %>
                            <a href="/admin/dashboard" class="text-gray-700 hover:text-indigo-600 font-medium transition">Admin</a>
                        <% } else { %>
                            <a href="/cliente/meus-alugueis" class="text-gray-700 hover:text-indigo-600 font-medium transition">Meus Aluguéis</a>
                            <a href="/cliente/carrinho" class="relative text-gray-700 hover:text-indigo-600 font-medium transition flex items-center gap-2">
                                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z"></path></svg>
                                Carrinho
                                <span id="carrinhoCount" class="absolute -top-2 -right-3 bg-indigo-600 text-white text-xs font-bold rounded-full h-5 w-5 flex items-center justify-center">0</span>
                            </a>
                            <a href="/cliente/perfil" class="text-gray-700 hover:text-indigo-600 font-medium transition">Perfil</a>
                        <% } %>
                        <a href="/auth/logout" class="bg-red-50 text-red-600 px-4 py-2 rounded-lg hover:bg-red-100 font-medium transition">Sair</a>
                    <% } else { %>
                        <a href="/auth/login" class="text-gray-700 hover:text-indigo-600 font-medium transition">Entrar</a>
                        <a href="/auth/cadastro" class="bg-indigo-600 text-white px-5 py-2 rounded-lg hover:bg-indigo-700 font-medium transition">Cadastrar</a>
                    <% } %>
                </div>
                
                <!-- Mobile Menu Button -->
                <button class="md:hidden text-gray-700 p-2" onclick="document.getElementById('mobileMenu').classList.toggle('hidden')">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path></svg>
                </button>
            </div>
            
            <!-- Mobile Menu -->
            <div id="mobileMenu" class="hidden md:hidden pb-4 border-t border-gray-100">
                <div class="flex flex-col space-y-3 pt-4">
                    <a href="/catalogo" class="block py-2 text-gray-700 hover:text-indigo-600">Catálogo</a>
                    <% if (user) { %>
                        <% if (user.tipo === 'admin') { %>
                            <a href="/admin/dashboard" class="block py-2 text-gray-700 hover:text-indigo-600">Admin</a>
                        <% } else { %>
                            <a href="/cliente/meus-alugueis" class="block py-2 text-gray-700 hover:text-indigo-600">Meus Aluguéis</a>
                            <a href="/cliente/carrinho" class="block py-2 text-gray-700 hover:text-indigo-600 flex items-center gap-2">
                                Carrinho
                                <span id="carrinhoCountMobile" class="bg-indigo-600 text-white text-xs font-bold rounded-full h-5 w-5 inline-flex items-center justify-center">0</span>
                            </a>
                            <a href="/cliente/perfil" class="block py-2 text-gray-700 hover:text-indigo-600">Perfil</a>
                        <% } %>
                        <a href="/auth/logout" class="block py-2 text-red-600 font-medium">Sair</a>
                    <% } else { %>
                        <a href="/auth/login" class="block py-2 text-gray-700 hover:text-indigo-600">Entrar</a>
                        <a href="/auth/cadastro" class="block py-2 text-indigo-600 font-medium">Cadastrar</a>
                    <% } %>
                </div>
            </div>
        </div>
    </nav>
    <main class="container mx-auto px-4 sm:px-6 py-6 sm:py-8">
        <!-- Mensagens Flash -->
        <% if (locals.success && success && success !== '') { %>
            <div class="bg-green-50 border-l-4 border-green-500 text-green-800 px-4 py-3 rounded-lg mb-4 shadow-sm animate-slide-down">
                <div class="flex items-center gap-3">
                    <svg class="w-5 h-5 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                    <span class="font-medium text-sm"><%= success %></span>
                    <button onclick="this.parentElement.parentElement.style.opacity='0'; setTimeout(() => this.parentElement.parentElement.remove(), 300)" class="ml-auto text-green-800 hover:text-green-900 font-bold">&times;</button>
                </div>
            </div>
        <% } %>
        <% if (locals.error && error && error !== '') { %>
            <div class="bg-red-50 border-l-4 border-red-500 text-red-800 px-4 py-3 rounded-lg mb-4 shadow-sm animate-slide-down">
                <div class="flex items-center gap-3">
                    <svg class="w-5 h-5 text-red-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                    <span class="font-medium text-sm"><%= error %></span>
                    <button onclick="this.parentElement.parentElement.style.opacity='0'; setTimeout(() => this.parentElement.parentElement.remove(), 300)" class="ml-auto text-red-800 hover:text-red-900 font-bold">&times;</button>
                </div>
            </div>
        <% } %>