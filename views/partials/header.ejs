<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>HappyKids - Locação de Brinquedos</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="/style.css">
    <style>
        .rating-input { display: inline-flex; flex-direction: row-reverse; gap: 5px; }
        .rating-input input { display: none; }
        .rating-input label { cursor: pointer; font-size: 24px; color: #ddd; }
        .rating-input input:checked ~ label { color: #ffc107; }
        .rating-input label:hover, .rating-input label:hover ~ label { color: #ffc107; }
        .loading { display: none; position: fixed; top: 50%; left: 50%; transform: translate(-50%, -50%); z-index: 1000; }
    </style>
</head>
<body class="bg-gray-100">
    <nav class="bg-blue-600 text-white shadow-lg">
        <div class="container mx-auto px-4">
            <div class="flex justify-between items-center py-4">
                <a href="/" class="text-2xl font-bold">HappyKids</a>
                <div class="space-x-4">
                    <a href="/catalogo" class="hover:text-blue-200 transition">Catálogo</a>
                    <% if (user) { %>
                        <% if (user.tipo === 'admin') { %>
                            <a href="/admin/dashboard" class="hover:text-blue-200 transition">Admin</a>
                        <% } else { %>
                            <a href="/cliente/meus-alugueis" class="hover:text-blue-200 transition">Meus Aluguéis</a>
                            <a href="/cliente/carrinho" class="hover:text-blue-200 transition">Carrinho</a>
                            <a href="/cliente/perfil" class="hover:text-blue-200 transition">Perfil</a>
                        <% } %>
                        <a href="/auth/logout" class="bg-red-500 px-4 py-2 rounded hover:bg-red-600 transition">Sair</a>
                    <% } else { %>
                        <a href="/auth/login" class="bg-green-500 px-4 py-2 rounded hover:bg-green-600 transition">Entrar</a>
                        <a href="/auth/cadastro" class="bg-blue-500 px-4 py-2 rounded hover:bg-blue-600 transition">Cadastrar</a>
                    <% } %>
                </div>
            </div>
        </div>
    </nav>
    <main class="container mx-auto px-4 py-8">
        <% if (locals.success) { %>
            <div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded mb-4">
                <%= success %>
            </div>
        <% } %>
        <% if (locals.error) { %>
            <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded mb-4">
                <%= error %>
            </div>
        <% } %>