<%- include('partials/header') %>

<div class="max-w-md mx-auto bg-white rounded-lg shadow-md p-8">
    <h2 class="text-2xl font-bold text-center mb-6">Login</h2>
    
    <form action="/auth/login" method="POST">
        <div class="mb-4">
            <label class="block text-gray-700 mb-2">Email</label>
            <input type="email" name="email" required class="w-full px-3 py-2 border rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500">
        </div>
        
        <div class="mb-6">
            <label class="block text-gray-700 mb-2">Senha</label>
            <input type="password" name="senha" required class="w-full px-3 py-2 border rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500">
        </div>
        
        <button type="submit" class="w-full bg-blue-600 text-white py-2 rounded-lg hover:bg-blue-700 transition">Entrar</button>
    </form>
    
    <div class="mt-4 text-center">
        <a href="/auth/esqueceu-senha" class="text-blue-600 hover:underline">Esqueceu a senha?</a>
    </div>
    
    <div class="mt-4 text-center">
        <p class="text-gray-600">Não tem conta? <a href="/auth/cadastro" class="text-blue-600 hover:underline">Cadastre-se</a></p>
    </div>
</div>

<%- include('partials/footer') %>