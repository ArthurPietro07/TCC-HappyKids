<%- include('partials/header.ejs') %>

<section class="max-w-md mx-auto px-4 py-16">
    <div class="bg-white rounded-lg shadow-lg p-8">
        <h1 class="text-2xl font-bold text-center mb-8">Entrar na Happy Kids</h1>
        
        <% if (locals.error) { %>
            <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded mb-4">
                <%= error %>
            </div>
        <% } %>
        
        <% if (locals.success) { %>
            <div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded mb-4">
                <%= success %>
            </div>
        <% } %>
        
        <form action="/login" method="POST">
            <div class="mb-4">
                <label class="block text-gray-700 mb-2">E-mail</label>
                <input type="email" name="email" required class="w-full p-3 border rounded-lg focus:outline-none focus:border-blue-600">
            </div>
            
            <div class="mb-6">
                <label class="block text-gray-700 mb-2">Senha</label>
                <input type="password" name="senha" required class="w-full p-3 border rounded-lg focus:outline-none focus:border-blue-600">
            </div>
            
            <button type="submit" class="w-full bg-blue-600 text-white py-3 rounded-lg hover:bg-blue-700 transition-all">
                Entrar
            </button>
        </form>
        
        <p class="text-center mt-4 text-gray-600">
            Não tem uma conta? <a href="/cadastro" class="text-blue-600 hover:underline">Cadastre-se</a>
        </p>
    </div>
</section>

<%- include('partials/footer.ejs') %>