<%- include('partials/header.ejs') %>
<div class="max-w-2xl mx-auto px-4 py-10 fade-in">
  <div class="bg-white rounded-2xl shadow-sm border border-slate-100 p-8">
    <div class="flex items-center gap-4 mb-8 pb-6 border-b border-slate-100">
      <div class="w-20 h-20 bg-blue-100 text-blue-600 rounded-2xl flex items-center justify-center text-3xl font-bold"><%= usuario.nome.charAt(0).toUpperCase() %></div>
      <div><h1 class="text-2xl font-bold text-slate-800">Meu Perfil</h1><p class="text-slate-500">Gerencie suas informações</p></div>
    </div>
    <div class="grid gap-4 mb-8">
      <div class="p-4 bg-slate-50 rounded-xl"><p class="text-xs text-slate-500 font-medium uppercase">Nome</p><p class="text-slate-800 font-medium mt-1"><%= usuario.nome %></p></div>
      <div class="p-4 bg-slate-50 rounded-xl"><p class="text-xs text-slate-500 font-medium uppercase">E-mail</p><p class="text-slate-800 font-medium mt-1"><%= usuario.email %></p></div>
      <div class="p-4 bg-slate-50 rounded-xl"><p class="text-xs text-slate-500 font-medium uppercase">Telefone</p><p class="text-slate-800 font-medium mt-1"><%= usuario.telefone %></p></div>
      <div class="grid grid-cols-2 gap-4">
        <div class="p-4 bg-slate-50 rounded-xl"><p class="text-xs text-slate-500 font-medium uppercase">Tipo</p><p class="text-slate-800 font-medium mt-1"><%= usuario.tipo === 'admin' ? '👑 Administrador' : '👤 Cliente' %></p></div>
        <div class="p-4 bg-slate-50 rounded-xl"><p class="text-xs text-slate-500 font-medium uppercase">Membro desde</p><p class="text-slate-800 font-medium mt-1"><%= new Date(usuario.data_cadastro).toLocaleDateString() %></p></div>
      </div>
    </div>
    <a href="/logout" class="inline-flex items-center gap-2 bg-red-600 text-white px-6 py-3 rounded-xl hover:bg-red-700 transition font-medium shadow-md">🚪 Sair da Conta</a>
  </div>
</div>
<%- include('partials/footer.ejs') %>