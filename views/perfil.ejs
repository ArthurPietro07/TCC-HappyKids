<%- include('partials/header.ejs') %>

<section class="max-w-2xl mx-auto px-4 py-8">
    <div class="bg-white rounded-lg shadow-lg p-8">
        <h1 class="text-3xl font-bold mb-8">Meu Perfil</h1>
        
        <div class="space-y-4">
            <div>
                <label class="block text-gray-700 font-semibold mb-1">Nome</label>
                <p class="text-gray-900"><%= usuario.nome %></p>
            </div>
            
            <div>
                <label class="block text-gray-700 font-semibold mb-1">E-mail</label>
                <p class="text-gray-900"><%= usuario.email %></p>
            </div>
            
            <div>
                <label class="block text-gray-700 font-semibold mb-1">Telefone</label>
                <p class="text-gray-900"><%= usuario.telefone %></p>
            </div>
            
            <div>
                <label class="block text-gray-700 font-semibold mb-1">Tipo de Conta</label>
                <p class="text-gray-900"><%= usuario.tipo === 'admin' ? 'Administrador' : 'Cliente' %></p>
            </div>
            
            <div>
                <label class="block text-gray-700 font-semibold mb-1">Membro desde</label>
                <p class="text-gray-900"><%= new Date(usuario.data_cadastro).toLocaleDateString() %></p>
            </div>
        </div>
        
        <div class="mt-8 pt-6 border-t">
            <a href="/logout" class="bg-red-600 text-white px-6 py-2 rounded-lg hover:bg-red-700 inline-block">
                Sair da Conta
            </a>
        </div>
    </div>
</section>

<%- include('partials/footer.ejs') %>