<%- include('partials/header') %>

<div class="max-w-md mx-auto bg-white rounded-lg shadow-md p-8">
    <h2 class="text-2xl font-bold text-center mb-6">Meu Perfil</h2>
    
    <form action="/cliente/perfil" method="POST">
        <div class="mb-4">
            <label class="block text-gray-700 mb-2">Nome Completo</label>
            <input type="text" name="nome" value="<%= usuario.nome %>" required class="w-full px-3 py-2 border rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500">
        </div>
        
        <div class="mb-4">
            <label class="block text-gray-700 mb-2">Email</label>
            <input type="email" value="<%= usuario.email %>" disabled class="w-full px-3 py-2 border rounded-lg bg-gray-100">
        </div>
        
        <div class="mb-4">
            <label class="block text-gray-700 mb-2">Telefone</label>
            <input type="tel" name="telefone" value="<%= usuario.telefone %>" required class="w-full px-3 py-2 border rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500">
        </div>
        
        <div class="mb-6">
            <label class="block text-gray-700 mb-2">Data de Cadastro</label>
            <input type="text" value="<%= moment(usuario.data_cadastro).format('DD/MM/YYYY') %>" disabled class="w-full px-3 py-2 border rounded-lg bg-gray-100">
        </div>
        
        <button type="submit" class="w-full bg-blue-600 text-white py-2 rounded-lg hover:bg-blue-700 transition">Atualizar Perfil</button>
    </form>
</div>

<%- include('partials/footer') %>