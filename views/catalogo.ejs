<%- include('partials/header') %>

<h1 class="text-3xl font-bold mb-6">Catálogo de Brinquedos</h1>

<div class="mb-6 flex flex-wrap gap-4 items-end">
    <div class="flex-1">
        <form method="GET" action="/catalogo" class="flex gap-2">
            <input type="text" name="busca" placeholder="Buscar brinquedo..." value="<%= busca %>" class="flex-1 px-3 py-2 border rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500">
            <select name="ordem" class="px-3 py-2 border rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500">
                <option value="">Ordenar por</option>
                <option value="preco_asc" <%= ordem === 'preco_asc' ? 'selected' : '' %>>Menor Preço</option>
                <option value="preco_desc" <%= ordem === 'preco_desc' ? 'selected' : '' %>>Maior Preço</option>
            </select>
            <button type="submit" class="bg-blue-600 text-white px-6 py-2 rounded-lg hover:bg-blue-700 transition">Buscar</button>
        </form>
    </div>
</div>

<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
    <% brinquedos.forEach(brinquedo => { %>
        <div class="bg-white rounded-lg shadow-md overflow-hidden hover:shadow-lg transition">
            <a href="/brinquedo/<%= brinquedo._id %>">
                <img src="<%= brinquedo.imagem_principal %>" alt="<%= brinquedo.nome %>" class="w-full h-56 object-cover hover:opacity-90 transition">
            </a>
            <div class="p-4">
                <a href="/brinquedo/<%= brinquedo._id %>" class="block">
                    <h3 class="font-bold text-xl hover:text-blue-600 transition"><%= brinquedo.nome %></h3>
                </a>
                <div class="flex items-center mt-1 mb-2">
                    <% for(let i = 1; i <= 5; i++) { %>
                        <span class="text-<%= i <= Math.round(brinquedo.media_estrelas) ? 'yellow-400' : 'gray-300' %>">★</span>
                    <% } %>
                    <span class="text-sm text-gray-600 ml-1">(<%= brinquedo.total_comentarios %>)</span>
                </div>
                <p class="text-gray-600 text-sm mb-3"><%= brinquedo.descricao.substring(0, 80) %>...</p>
                <div class="flex justify-between items-center mb-3">
                    <div>
                        <span class="text-blue-600 font-bold text-lg">R$ <%= brinquedo.preco_diaria %></span>
                        <span class="text-gray-500 text-sm">/dia</span>
                    </div>
                    <span class="text-sm <%= brinquedo.quantidade_estoque > 0 ? 'text-green-600' : 'text-red-600' %> font-semibold">
                        <%= brinquedo.quantidade_estoque > 0 ? `${brinquedo.quantidade_estoque} unidades` : 'Indisponível' %>
                    </span>
                </div>
                
                <a href="/brinquedo/<%= brinquedo._id %>" class="block w-full bg-blue-600 text-white text-center px-4 py-2 rounded-lg hover:bg-blue-700 transition">
                    Ver Detalhes
                </a>
            </div>
        </div>
    <% }) %>
</div>

<%- include('partials/footer') %>