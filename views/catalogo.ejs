<%- include('partials/header') %>

<div class="container mx-auto px-4 sm:px-6 py-6 sm:py-8">
    <h1 class="text-2xl sm:text-3xl font-bold text-gray-900 mb-6">Catálogo de Brinquedos</h1>

    <!-- Busca - CORRIGIDA responsividade -->
    <div class="mb-8">
        <form method="GET" action="/catalogo" class="flex flex-col sm:flex-row gap-3">
            <div class="flex-1">
                <input type="text" name="busca" placeholder="Buscar brinquedo..." value="<%= busca %>" 
                       class="w-full px-4 py-3 border border-gray-300 rounded-xl focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent transition">
            </div>
            <div class="flex gap-3">
                <select name="ordem" class="px-4 py-3 border border-gray-300 rounded-xl focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent transition bg-white">
                    <option value="">Ordenar por</option>
                    <option value="preco_asc" <%= ordem === 'preco_asc' ? 'selected' : '' %>>Menor Preço</option>
                    <option value="preco_desc" <%= ordem === 'preco_desc' ? 'selected' : '' %>>Maior Preço</option>
                </select>
                <button type="submit" class="bg-indigo-600 text-white px-6 py-3 rounded-xl hover:bg-indigo-700 transition font-semibold whitespace-nowrap">
                    Buscar
                </button>
            </div>
        </form>
    </div>

    <!-- Grid de Brinquedos -->
    <% if (brinquedos.length === 0) { %>
        <div class="text-center py-12 bg-gray-50 rounded-2xl">
            <svg class="w-16 h-16 text-gray-400 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
            <p class="text-gray-500 text-lg">Nenhum brinquedo encontrado</p>
            <a href="/catalogo" class="inline-block mt-4 text-indigo-600 hover:text-indigo-700 font-medium">Limpar busca</a>
        </div>
    <% } else { %>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4 md:gap-6">
            <% brinquedos.forEach(brinquedo => { %>
                <div class="bg-white rounded-2xl shadow-md overflow-hidden hover:shadow-xl transition group">
                    <a href="/brinquedo/<%= brinquedo._id %>" class="block overflow-hidden bg-gray-100">
                        <img src="<%= brinquedo.imagem_principal %>" alt="<%= brinquedo.nome %>" 
                             class="w-full h-48 sm:h-56 object-cover group-hover:scale-105 transition duration-300">
                    </a>
                    <div class="p-4">
                        <a href="/brinquedo/<%= brinquedo._id %>" class="block">
                            <h3 class="font-bold text-lg sm:text-xl text-gray-900 hover:text-indigo-600 transition line-clamp-1"><%= brinquedo.nome %></h3>
                        </a>
                        
                        <!-- Estrelas -->
                        <div class="flex items-center gap-1 mt-2">
                            <div class="flex">
                                <% for(let i = 1; i <= 5; i++) { %>
                                    <svg class="w-4 h-4 <%= i <= Math.round(brinquedo.media_estrelas) ? 'text-yellow-400' : 'text-gray-300' %>" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"></path></svg>
                                <% } %>
                            </div>
                            <span class="text-xs text-gray-500">(<%= brinquedo.total_comentarios %>)</span>
                        </div>
                        
                        <p class="text-gray-600 text-sm mt-2 line-clamp-2"><%= brinquedo.descricao.substring(0, 80) %>...</p>
                        
                        <div class="flex justify-between items-center mt-3 pt-3 border-t border-gray-100">
                            <div>
                                <span class="text-indigo-600 font-bold text-lg">R$ <%= brinquedo.preco_diaria %></span>
                                <span class="text-gray-500 text-xs">/dia</span>
                            </div>
                            <span class="text-xs font-semibold px-2 py-1 rounded-full <%= brinquedo.quantidade_estoque > 0 ? 'bg-green-100 text-green-700' : 'bg-red-100 text-red-700' %>">
                                <%= brinquedo.quantidade_estoque > 0 ? `${brinquedo.quantidade_estoque} unid.` : 'Indisponível' %>
                            </span>
                        </div>
                        
                        <a href="/brinquedo/<%= brinquedo._id %>" class="block w-full mt-3 bg-indigo-600 text-white text-center px-4 py-2 rounded-xl hover:bg-indigo-700 transition font-medium text-sm">
                            Ver Detalhes
                        </a>
                    </div>
                </div>
            <% }) %>
        </div>
    <% } %>
</div>

<style>
.line-clamp-1 {
    display: -webkit-box;
    -webkit-line-clamp: 1;
    -webkit-box-orient: vertical;
    overflow: hidden;
}
.line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
}
</style>

<%- include('partials/footer') %>