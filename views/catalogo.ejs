<%- include('partials/header.ejs') %>
    <section class="max-w-7xl mx-auto px-4 py-10 fade-in">
        <div class="flex flex-col md:flex-row justify-between items-start md:items-center mb-8 gap-4">
            <h1 class="text-3xl font-bold text-slate-800">📦 Catálogo de Brinquedos</h1>
            <div class="w-full md:w-96 relative">
                <i class="ri-search-line absolute left-3 top-1/2 -translate-y-1/2 text-slate-400"></i>
                <input type="text" id="busca" placeholder="🔍 Buscar brinquedo por nome..."
                    class="w-full pl-10 pr-4 py-3 bg-white border border-slate-200 rounded-xl focus:ring-2 focus:ring-blue-500 focus:border-blue-500 shadow-sm">
            </div>
        </div>

        <div class="grid md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6" id="gridBrinquedos">
            <% if (brinquedos && brinquedos.length> 0) { %>
                <% brinquedos.forEach(brinquedo=> { %>
                    <div class="bg-white rounded-2xl overflow-hidden border border-slate-100 hover-card fade-in brinquedo-item"
                        data-nome="<%= brinquedo.nome.toLowerCase() %>">
                        <div class="relative">
                            <img src="<%= brinquedo.imagem_url || '/uploads/placeholder.jpg' %>"
                                class="w-full h-48 object-cover" onerror="this.src='/uploads/placeholder.jpg'">
                            <span
                                class="absolute top-3 right-3 bg-white/90 backdrop-blur px-2 py-1 rounded-lg text-xs font-medium text-slate-700 shadow">📦
                                <%= brinquedo.quantidade_estoque %> un.</span>
                        </div>
                        <div class="p-5">
                            <h3 class="font-bold text-lg mb-1 text-slate-800">
                                <%= brinquedo.nome %>
                            </h3>
                            <p class="text-slate-500 text-sm mb-4 line-clamp-2">
                                <%= brinquedo.descricao.substring(0, 70) %>...
                            </p>
                            <div class="flex justify-between items-center mb-4">
                                <span class="text-2xl font-bold text-blue-600">R$ <%= brinquedo.preco_diaria %></span>
                                <span class="text-slate-400 text-sm">/dia</span>
                            </div>
                            <% if (usuario) { %>
                                <button
                                    onclick="abrirCalendario('<%= brinquedo._id %>', '<%= brinquedo.nome %>', <%= brinquedo.preco_diaria %>, <%= brinquedo.quantidade_estoque %>)"
                                    class="w-full bg-blue-600 text-white py-3 rounded-xl hover:bg-blue-700 transition font-medium shadow-md hover:shadow-lg">📅
                                    Ver Disponibilidade & Alugar</button>
                                <% } else { %>
                                    <button
                                        onclick="alert('🔒 Faça login para ver a disponibilidade e alugar brinquedos!')"
                                        class="w-full bg-slate-200 text-slate-500 py-3 rounded-xl cursor-not-allowed font-medium">🔒
                                        Faça login para alugar</button>
                                    <% } %>
                        </div>
                    </div>
                    <% }) %>
                        <% } else { %>
                            <div class="col-span-full text-center py-16 bg-white rounded-2xl border border-slate-100">
                                <p class="text-slate-500 text-lg">📭 Nenhum brinquedo disponível no momento.</p>
                            </div>
                            <% } %>
        </div>
    </section>

    <div id="modalCalendario"
        class="fixed inset-0 bg-black/60 backdrop-blur-sm hidden items-center justify-center z-50 p-4">
        <div
            class="bg-white rounded-2xl shadow-2xl max-w-md w-full max-h-[90vh] overflow-y-auto border border-slate-200">
            <div class="p-5 sticky top-0 bg-white z-10 border-b border-slate-100 flex justify-between items-center">
                <h2 class="text-xl font-bold text-slate-800" id="modalTitulo">📅 Disponibilidade</h2>
                <button onclick="fecharCalendario()"
                    class="w-8 h-8 rounded-full bg-slate-100 hover:bg-slate-200 flex items-center justify-center transition text-slate-500">&times;</button>
            </div>
            <div class="p-5 space-y-4">
                <div class="p-4 bg-slate-50 rounded-xl border border-slate-200">
                    <p class="font-medium text-slate-800">🎮 <span id="brinquedoNome"></span></p>
                    <p class="text-sm text-slate-500 mt-1">💰 R$ <span id="brinquedoPreco"></span>/dia | 📦 Estoque:
                        <span id="estoqueMax"></span></p>
                </div>
                <div class="flex items-center justify-between bg-slate-50 p-3 rounded-xl border border-slate-200">
                    <span class="text-sm font-medium text-slate-700">🔢 Quantidade:</span>
                    <div class="flex items-center gap-3">
                        <button onclick="diminuirQuantidade()"
                            class="w-8 h-8 bg-white border border-slate-200 rounded-lg hover:bg-slate-50 transition">-</button>
                        <span id="quantidadeSelecionada"
                            class="text-lg font-bold w-8 text-center text-slate-800">1</span>
                        <button onclick="aumentarQuantidade()"
                            class="w-8 h-8 bg-white border border-slate-200 rounded-lg hover:bg-slate-50 transition">+</button>
                    </div>
                </div>
                <div class="flex justify-between items-center">
                    <button onclick="mudarMes(-1)"
                        class="w-9 h-9 rounded-lg bg-slate-100 hover:bg-slate-200 transition">◀</button>
                    <h3 class="text-lg font-semibold text-slate-800" id="mesAno"></h3>
                    <button onclick="mudarMes(1)"
                        class="w-9 h-9 rounded-lg bg-slate-100 hover:bg-slate-200 transition">▶</button>
                </div>
                <div class="grid grid-cols-7 gap-1 text-center text-xs font-medium text-slate-500 mb-2">
                    <div>DOM</div>
                    <div>SEG</div>
                    <div>TER</div>
                    <div>QUA</div>
                    <div>QUI</div>
                    <div>SEX</div>
                    <div>SÁB</div>
                </div>
                <div id="calendarioGrid" class="grid grid-cols-7 gap-1 mb-4"></div>
                <div id="legenda" class="flex flex-wrap gap-2 text-xs text-slate-600 justify-center">
                    <span class="flex items-center gap-1"><span class="w-3 h-3 bg-emerald-500 rounded"></span>
                        Disp.</span>
                    <span class="flex items-center gap-1"><span class="w-3 h-3 bg-rose-500 rounded"></span>
                        Ocupado</span>
                    <span class="flex items-center gap-1"><span class="w-3 h-3 bg-blue-500 rounded"></span>
                        Selecionado</span>
                    <span class="flex items-center gap-1"><span class="w-3 h-3 bg-slate-200 rounded"></span>
                        Passado</span>
                </div>
                <div class="grid grid-cols-2 gap-3">
                    <div><label class="block text-xs font-medium text-slate-600 mb-1">📅 Início</label><input
                            type="text" id="dataInicioCal" readonly placeholder="Selecione"
                            class="w-full p-2 bg-slate-50 border border-slate-200 rounded-lg text-sm"></div>
                    <div><label class="block text-xs font-medium text-slate-600 mb-1">📅 Fim</label><input type="text"
                            id="dataFimCal" readonly placeholder="Selecione"
                            class="w-full p-2 bg-slate-50 border border-slate-200 rounded-lg text-sm"></div>
                </div>
                <div><label class="block text-xs font-medium text-slate-600 mb-1">⏰ Horário de Entrega</label><select
                        id="horaEntrega"
                        class="w-full p-2 bg-slate-50 border border-slate-200 rounded-lg text-sm"></select></div>
                <div id="mensagemDisponibilidade" class="hidden p-3 rounded-lg text-sm text-center font-medium"></div>
                <div class="flex gap-3">
                    <button onclick="limparSelecao()"
                        class="flex-1 bg-slate-100 text-slate-700 py-3 rounded-xl hover:bg-slate-200 transition font-medium">🗑️
                        Limpar</button>
                    <button onclick="adicionarAoCarrinho()" id="btnAdicionar" disabled
                        class="flex-1 bg-slate-200 text-slate-400 py-3 rounded-xl cursor-not-allowed transition font-medium">🛒
                        Alugar</button>
                </div>
            </div>
        </div>
    </div>
    <%- include('partials/footer.ejs') %>
        <script>
            let brinquedoSelecionado = null;
            let diasOcupados = [];
            let diasOcupadosMap = {}; // Mapa com quantidade ocupada por dia
            let dataInicioSelecionada = null;
            let dataFimSelecionada = null;
            let quantidadeAtual = 1;
            let estoqueMaximo = 0;
            let mesAtual = new Date();
            let anoAtual = mesAtual.getFullYear();
            let mesAtualNum = mesAtual.getMonth();
            
            // Retorna a data atual considerando o fuso horário do Brasil (UTC-3)
            function getDataAtualBrasil() {
                const agora = new Date();
                const offsetBrasil = -3;
                const utc = agora.getTime() + (agora.getTimezoneOffset() * 60000);
                return new Date(utc + (3600000 * offsetBrasil));
            }
            
            function getDataAtual() {
                const dataBrasil = getDataAtualBrasil();
                return new Date(dataBrasil.getFullYear(), dataBrasil.getMonth(), dataBrasil.getDate());
            }
            function abrirCalendario(id, nome, preco, estoque) {
                brinquedoSelecionado = { id, nome, preco };
                estoqueMaximo = estoque;
                quantidadeAtual = 1;
                document.getElementById('brinquedoNome').innerText = nome;
                document.getElementById('brinquedoPreco').innerText = preco;
                document.getElementById('estoqueMax').innerText = estoque;
                document.getElementById('quantidadeSelecionada').innerText = '1';
                document.getElementById('modalTitulo').innerHTML = `📅 ${nome.substring(0, 20)}`;
                const selectHora = document.getElementById('horaEntrega');
                selectHora.innerHTML = '';
                for (let h = 8; h <= 20; h++) {
                    const horaStr = `${h.toString().padStart(2, '0')}:00`;
                    selectHora.innerHTML += `<option value="${horaStr}">${horaStr}</option>`;
                }
                limparSelecao();
                
                // Atualiza mês/ano atual ao abrir calendário
                const hoje = getDataAtual();
                anoAtual = hoje.getFullYear();
                mesAtualNum = hoje.getMonth();
                
                carregarDiasOcupados();
                document.getElementById('modalCalendario').classList.remove('hidden');
                document.getElementById('modalCalendario').classList.add('flex');
            }
            function diminuirQuantidade() {
                if (quantidadeAtual > 1) {
                    quantidadeAtual--;
                    document.getElementById('quantidadeSelecionada').innerText = quantidadeAtual;
                    verificarDisponibilidadeQuantidade();
                }
            }
            function aumentarQuantidade() {
                // Verifica disponibilidade no período selecionado para a nova quantidade
                if (!dataInicioSelecionada || !dataFimSelecionada) {
                    alert('⚠️ Selecione um período primeiro!');
                    return;
                }
                
                const novaQuantidade = quantidadeAtual + 1;
                
                // Verifica se a nova quantidade excede o estoque máximo
                if (novaQuantidade > estoqueMaximo) {
                    alert(`⚠️ Máximo do estoque: ${estoqueMaximo} unidade(s)`);
                    return;
                }
                
                // Verifica disponibilidade real considerando aluguéis existentes
                fetch('/cliente/verificar-disponibilidade', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        brinquedoId: brinquedoSelecionado.id,
                        dataInicio: dataInicioSelecionada,
                        dataFim: dataFimSelecionada,
                        quantidade: novaQuantidade
                    })
                })
                .then(res => res.json())
                .then(result => {
                    if (result.disponivel) {
                        quantidadeAtual = novaQuantidade;
                        document.getElementById('quantidadeSelecionada').innerText = quantidadeAtual;
                        verificarDisponibilidadeQuantidade();
                    } else {
                        alert(`⚠️ Quantidade indisponível para o período selecionado. ${result.message}`);
                    }
                })
                .catch(error => {
                    console.error(error);
                    alert('❌ Erro ao verificar disponibilidade');
                });
            }
            async function verificarDisponibilidadeQuantidade() {
                if (!dataInicioSelecionada || !dataFimSelecionada) return;
                try {
                    const response = await fetch('/cliente/verificar-disponibilidade', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({
                            brinquedoId: brinquedoSelecionado.id,
                            dataInicio: dataInicioSelecionada,
                            dataFim: dataFimSelecionada,
                            quantidade: quantidadeAtual
                        })
                    });
                    const result = await response.json();
                    if (!result.disponivel) {
                        document.getElementById('btnAdicionar').disabled = true;
                        document.getElementById('btnAdicionar').classList.remove('bg-green-600');
                        document.getElementById('btnAdicionar').classList.add('bg-gray-400');
                        mostrarMensagem(`❌ ${result.message}`, 'red');
                    } else {
                        document.getElementById('btnAdicionar').disabled = false;
                        document.getElementById('btnAdicionar').classList.remove('bg-gray-400');
                        document.getElementById('btnAdicionar').classList.add('bg-green-600');
                        mostrarMensagem(`✅ ${result.message || 'Disponível!'}`, 'green');
                    }
                } catch (error) {
                    console.error(error);
                }
            }
            async function carregarDiasOcupados() {
                try {
                    const response = await fetch(`/cliente/dias-indisponiveis/${brinquedoSelecionado.id}`);
                    const data = await response.json();
                    diasOcupados = data.diasIndisponiveis || [];
                    diasOcupadosMap = data.diasOcupadosMap || {};
                    renderizarCalendario();
                } catch (error) {
                    diasOcupados = [];
                    diasOcupadosMap = {};
                    renderizarCalendario();
                }
            }
            function renderizarCalendario() {
                const primeiroDia = new Date(anoAtual, mesAtualNum, 1);
                const ultimoDia = new Date(anoAtual, mesAtualNum + 1, 0);
                const diaInicioSemana = primeiroDia.getDay();
                const hoje = getDataAtual();
                const hojeSemHora = new Date(hoje.getFullYear(), hoje.getMonth(), hoje.getDate());
                const nomesMeses = ['Janeiro', 'Fevereiro', 'Março', 'Abril', 'Maio', 'Junho', 'Julho', 'Agosto', 'Setembro', 'Outubro', 'Novembro', 'Dezembro'];
                document.getElementById('mesAno').innerHTML = `${nomesMeses[mesAtualNum]} ${anoAtual}`;
                let dias = [];
                for (let i = 0; i < diaInicioSemana; i++) {
                    dias.push({ dia: '', vazio: true });
                }
                for (let d = 1; d <= ultimoDia.getDate(); d++) {
                    const dataStr = `${anoAtual}-${String(mesAtualNum + 1).padStart(2, '0')}-${String(d).padStart(2, '0')}`;
                    const dataObj = new Date(anoAtual, mesAtualNum, d);
                    const dataObjSemHora = new Date(dataObj.getFullYear(), dataObj.getMonth(), dataObj.getDate());
                    const isPassado = dataObjSemHora.getTime() < hojeSemHora.getTime();
                    
                    // Verifica se está totalmente ocupado (estoque zerado)
                    const quantidadeOcupada = diasOcupadosMap[dataStr] || 0;
                    const isTotalmenteOcupado = diasOcupados.includes(dataStr);
                    const isSelecionado = isDataSelecionada(dataStr);
                    
                    let status = 'disponivel';
                    if (isPassado) status = 'passado';
                    else if (isTotalmenteOcupado) status = 'ocupado';
                    else if (isSelecionado) status = 'selecionado';
                    
                    dias.push({ 
                        dia: d, 
                        data: dataStr, 
                        status,
                        quantidadeOcupada,
                        disponivel: estoqueMaximo - quantidadeOcupada
                    });
                }
                let grid = '';
                dias.forEach(dia => {
                    if (dia.vazio) {
                        grid += `<div class="h-9"></div>`;
                    } else {
                        let cor = '', cursor = 'cursor-pointer', onClick = `selecionarData('${dia.data}')`;
                        if (dia.status === 'passado') {
                            cor = 'bg-gray-200 text-gray-400';
                            cursor = 'cursor-not-allowed';
                            onClick = '';
                        } else if (dia.status === 'ocupado') {
                            cor = 'bg-red-500 text-white';
                        } else if (dia.status === 'selecionado') {
                            cor = 'bg-blue-500 text-white';
                        } else {
                            cor = 'bg-green-500 text-white hover:bg-green-600';
                        }
                        
                        // Adiciona tooltip com informações de estoque
                        const tooltip = dia.quantidadeOcupada > 0 && dia.status !== 'ocupado' 
                            ? `title="${dia.disponivel}/${estoqueMaximo} disponíveis"` 
                            : '';
                        
                        grid += `
<div class="h-9">
<div class="${cor} rounded-lg flex items-center justify-center h-full text-sm font-medium ${cursor} transition"
onclick="${onClick}" ${tooltip}>
${dia.dia}
</div>
</div>
`;
                    }
                });
                document.getElementById('calendarioGrid').innerHTML = grid;
            }
            function isDataSelecionada(dataStr) {
                if (!dataInicioSelecionada) return false;
                const data = new Date(dataStr);
                const inicio = new Date(dataInicioSelecionada);
                const fim = dataFimSelecionada ? new Date(dataFimSelecionada) : inicio;
                return data >= inicio && data <= fim;
            }
            function formatarDataBR(dataStr) {
                if (!dataStr) return '';
                const [ano, mes, dia] = dataStr.split('-');
                return `${dia}/${mes}`;
            }
            function selecionarData(dataStr) {
                const data = new Date(dataStr);
                const hoje = getDataAtual();
                
                // Verifica se a data é passada (comparando apenas dia, mês e ano)
                const dataSelecionada = new Date(data.getFullYear(), data.getMonth(), data.getDate());
                const hojeSemHora = new Date(hoje.getFullYear(), hoje.getMonth(), hoje.getDate());
                
                if (dataSelecionada.getTime() < hojeSemHora.getTime()) {
                    alert('⚠️ Não é possível selecionar datas passadas!');
                    return;
                }
                
                // Verifica se a data está totalmente ocupada (estoque zerado)
                if (diasOcupados.includes(dataStr)) {
                    alert('❌ Esta data já está totalmente ocupada!');
                    return;
                }
                
                // Se já tem período selecionado e usuário clica em outra data, limpa seleção anterior
                if (!dataInicioSelecionada) {
                    dataInicioSelecionada = dataStr;
                    dataFimSelecionada = null;
                    document.getElementById('dataInicioCal').value = formatarDataBR(dataStr);
                    document.getElementById('dataFimCal').value = '';
                    document.getElementById('btnAdicionar').disabled = true;
                    document.getElementById('btnAdicionar').classList.remove('bg-green-600');
                    document.getElementById('btnAdicionar').classList.add('bg-gray-400');
                    mostrarMensagem(`📅 Início: ${formatarDataBR(dataStr)}. Selecione a data de fim.`, 'blue');
                } else if (!dataFimSelecionada) {
                    const inicio = new Date(dataInicioSelecionada);
                    const fim = new Date(dataStr);
                    if (fim <= inicio) {
                        alert('⚠️ A data de fim deve ser posterior à data de início!');
                        return;
                    }
                    
                    // Verifica disponibilidade DIA A DIA considerando quantidade ocupada
                    let todasDisponiveis = true;
                    let mensagemErro = '';
                    let dataAtual = new Date(inicio);
                    
                    while (dataAtual <= fim) {
                        const dataAtualStr = dataAtual.toISOString().split('T')[0];
                        const quantidadeOcupada = diasOcupadosMap[dataAtualStr] || 0;
                        const disponivelNoDia = estoqueMaximo - quantidadeOcupada;
                        
                        // Verifica se o dia está totalmente ocupado
                        if (disponivelNoDia <= 0) {
                            todasDisponiveis = false;
                            mensagemErro = `❌ Dia ${formatarDataBR(dataAtualStr)} está totalmente ocupado!`;
                            break;
                        }
                        
                        dataAtual.setDate(dataAtual.getDate() + 1);
                    }
                    
                    if (!todasDisponiveis) {
                        alert(mensagemErro);
                        return;
                    }
                    
                    dataFimSelecionada = dataStr;
                    document.getElementById('dataFimCal').value = formatarDataBR(dataStr);
                    mostrarMensagem(`✅ Período selecionado: ${formatarDataBR(dataInicioSelecionada)} até ${formatarDataBR(dataFimSelecionada)}`, 'green');
                    verificarDisponibilidadeQuantidade();
                }
                renderizarCalendario();
            }
            function limparSelecao() {
                dataInicioSelecionada = null;
                dataFimSelecionada = null;
                quantidadeAtual = 1;
                document.getElementById('quantidadeSelecionada').innerText = '1';
                document.getElementById('dataInicioCal').value = '';
                document.getElementById('dataFimCal').value = '';
                document.getElementById('btnAdicionar').disabled = true;
                document.getElementById('btnAdicionar').classList.remove('bg-green-600');
                document.getElementById('btnAdicionar').classList.add('bg-gray-400');
                document.getElementById('mensagemDisponibilidade').classList.add('hidden');
                renderizarCalendario();
            }
            function mostrarMensagem(msg, cor) {
                const div = document.getElementById('mensagemDisponibilidade');
                div.innerHTML = msg;
                div.classList.remove('hidden', 'bg-green-50', 'text-green-800', 'bg-red-50', 'text-red-800', 'bg-yellow-50', 'text-yellow-800', 'bg-blue-50', 'text-blue-800');
                if (cor === 'green') div.classList.add('bg-green-50', 'text-green-800');
                else if (cor === 'red') div.classList.add('bg-red-50', 'text-red-800');
                else if (cor === 'blue') div.classList.add('bg-blue-50', 'text-blue-800');
                else div.classList.add('bg-yellow-50', 'text-yellow-800');
            }
            function mudarMes(delta) {
                const novaData = new Date(anoAtual, mesAtualNum + delta, 1);
                anoAtual = novaData.getFullYear();
                mesAtualNum = novaData.getMonth();
                limparSelecao();
                carregarDiasOcupados();
                
                // Atualiza o título do mês/ano após carregar dados
                setTimeout(() => {
                    const nomesMeses = ['Janeiro', 'Fevereiro', 'Março', 'Abril', 'Maio', 'Junho', 'Julho', 'Agosto', 'Setembro', 'Outubro', 'Novembro', 'Dezembro'];
                    document.getElementById('mesAno').innerHTML = `${nomesMeses[mesAtualNum]} ${anoAtual}`;
                }, 50);
            }
            function adicionarAoCarrinho() {
<% if (!usuario) { %>
if (confirm('Faça login para alugar')) window.location.href = '/login';
                    return;
<% } %>
if (!dataInicioSelecionada || !dataFimSelecionada) {
                    alert('⚠️ Selecione o período!');
                    return;
                }
                const horaEntrega = document.getElementById('horaEntrega').value;
                let carrinho = JSON.parse(localStorage.getItem('carrinho') || '[]');
                carrinho.push({
                    _id: brinquedoSelecionado.id,
                    nome: brinquedoSelecionado.nome,
                    preco_diaria: brinquedoSelecionado.preco,
                    quantidade: quantidadeAtual,
                    dataInicio: dataInicioSelecionada,
                    dataFim: dataFimSelecionada,
                    horaEntrega: horaEntrega
                });
                localStorage.setItem('carrinho', JSON.stringify(carrinho));
                alert(`✅ "${quantidadeAtual}x ${brinquedoSelecionado.nome}" adicionado ao carrinho!
📅 Período: ${formatarDataBR(dataInicioSelecionada)} até ${formatarDataBR(dataFimSelecionada)}
⏰ Entrega: ${horaEntrega}`);
                fecharCalendario();
                atualizarBadgeCarrinho();
                if (confirm('Ir para o carrinho agora?')) {
                    window.location.href = '/cliente/carrinho';
                }
            }
            function fecharCalendario() {
                document.getElementById('modalCalendario').classList.add('hidden');
                document.getElementById('modalCalendario').classList.remove('flex');
                brinquedoSelecionado = null;
                limparSelecao();
            }
            function atualizarBadgeCarrinho() {
                const carrinho = JSON.parse(localStorage.getItem('carrinho') || '[]');
                const total = carrinho.reduce((s, i) => s + i.quantidade, 0);
                const badge = document.getElementById('carrinhoCount');
                if (badge) {
                    badge.innerText = total;
                    badge.style.display = total > 0 ? 'inline-block' : 'none';
                }
            }
            document.getElementById('busca').addEventListener('input', function (e) {
                const termo = e.target.value.toLowerCase();
                document.querySelectorAll('.brinquedo-item').forEach(item => {
                    const nome = item.getAttribute('data-nome');
                    item.style.display = nome.includes(termo) ? 'block' : 'none';
                });
            });
            document.addEventListener('DOMContentLoaded', () => {
                atualizarBadgeCarrinho();
            });
