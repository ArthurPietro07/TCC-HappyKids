<%- include('partials/header.ejs') %>
<div class="min-h-screen flex items-center justify-center bg-slate-50 px-4 fade-in">
  <div class="bg-white rounded-2xl shadow-lg border border-slate-100 p-10 max-w-md w-full text-center">
    <div class="w-20 h-20 bg-red-100 text-red-500 rounded-full flex items-center justify-center text-4xl mx-auto mb-6"><i class="ri-error-warning-fill"></i></div>
    <h1 class="text-3xl font-bold text-slate-800 mb-3">Ops! Algo deu errado</h1>
    <p class="text-slate-500 mb-6"><%= message || 'Erro inesperado' %></p>
    <% if (typeof error !== 'undefined' && error && error.status) { %>
      <p class="text-sm text-slate-400 mb-6 bg-slate-50 px-4 py-2 rounded-lg inline-block">Status: <%= error.status %></p>
    <% } %>
    <a href="/" class="inline-flex items-center gap-2 bg-blue-600 text-white px-6 py-3 rounded-xl hover:bg-blue-700 transition font-bold shadow-md">🏠 Voltar para Home</a>
  </div>
</div>
<%- include('partials/footer.ejs') %>