<%- include('partials/header.ejs') %>
    <div class="min-h-screen flex items-center justify-center bg-slate-50 py-12 px-4 fade-in">
        <div class="bg-white rounded-2xl shadow-lg border border-slate-100 w-full max-w-md p-8">
            <div class="text-center mb-8">
                <div
                    class="w-16 h-16 bg-emerald-100 text-emerald-600 rounded-2xl flex items-center justify-center text-3xl mx-auto mb-4">
                    <i class="ri-user-add-line"></i></div>
                <h1 class="text-2xl font-bold text-slate-800">Criar Conta</h1>
                <p class="text-slate-500 mt-2">Preencha seus dados para começar</p>
            </div>
            <% if (locals.error) { %>
                <div class="bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-xl mb-6 text-sm">
                    <%= error %>
                </div>
                <% } %>
                    <form action="/cadastro" method="POST" class="space-y-4">
                        <div><label class="block text-sm font-medium text-slate-700 mb-1">Nome Completo</label><input
                                type="text" name="nome" required
                                class="w-full p-3 bg-slate-50 border border-slate-200 rounded-xl"></div>
                        <div><label class="block text-sm font-medium text-slate-700 mb-1">E-mail</label><input
                                type="email" name="email" required
                                class="w-full p-3 bg-slate-50 border border-slate-200 rounded-xl"></div>
                        <div><label class="block text-sm font-medium text-slate-700 mb-1">Telefone</label><input
                                type="tel" name="telefone" required placeholder="(11) 99999-9999"
                                class="w-full p-3 bg-slate-50 border border-slate-200 rounded-xl"></div>
                        <div><label class="block text-sm font-medium text-slate-700 mb-1">Senha</label><input
                                type="password" name="senha" required
                                class="w-full p-3 bg-slate-50 border border-slate-200 rounded-xl"></div>
                        <button type="submit"
                            class="w-full bg-blue-600 text-white py-3 rounded-xl hover:bg-blue-700 transition font-bold shadow-md hover:shadow-lg">Cadastrar</button>
                    </form>
                    <p class="text-center text-slate-500 mt-6 text-sm">Já tem uma conta? <a href="/login"
                            class="text-blue-600 font-semibold hover:underline">Faça login</a></p>
        </div>
    </div>
    <%- include('partials/footer.ejs') %>