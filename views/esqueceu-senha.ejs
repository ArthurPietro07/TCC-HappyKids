<%- include('partials/header') %>

<div class="max-w-md mx-auto bg-white rounded-lg shadow-md p-8">
    <h2 class="text-2xl font-bold text-center mb-6">Recuperar Senha</h2>
    
    <form action="/auth/esqueceu-senha" method="POST">
        <div class="mb-6">
            <label class="block text-gray-700 mb-2">Email cadastrado</label>
            <input type="email" name="email" required class="w-full px-3 py-2 border rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500">
            <p class="text-sm text-gray-500 mt-2">Enviaremos um link para redefinir sua senha</p>
        </div>
        
        <button type="submit" class="w-full bg-blue-600 text-white py-2 rounded-lg hover:bg-blue-700 transition">Enviar</button>
    </form>
    
    <div class="mt-4 text-center">
        <a href="/auth/login" class="text-blue-600 hover:underline">Voltar para o login</a>
    </div>
</div>

<%- include('partials/footer') %>